---
import { CLOSURE_PHONE_NOTE, closureShowing, upcomingClosures } from '../data/holiday-closure';

interface Props {
  strip?: boolean;
}
const { strip = false } = Astro.props;
const closures = upcomingClosures();
const forClient = closures.map((c) => ({ ...c, phoneNote: CLOSURE_PHONE_NOTE }));
---
{strip && closures.map((c) => (
  <div class="hr-holiday-strip" data-hr-from={c.showFrom} data-hr-until={c.endsAt} hidden={!closureShowing(c)}>
    {c.greeting} We're closed <strong>{c.datesLong}</strong> and back <span class="hr-nowrap">{c.reopens}</span>. <span class="hr-holiday-strip-phone">{CLOSURE_PHONE_NOTE}</span>
  </div>
))}
{closures.length > 0 && (
  <script is:inline define:vars={{ hrClosures: forClient }}>
    window.HR_CLOSURES = hrClosures;
    (function () {
      function sweep() {
        var now = Date.now();
        var els = document.querySelectorAll('[data-hr-until]');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          if (now >= Date.parse(el.getAttribute('data-hr-until'))) {
            if (el.parentNode) el.parentNode.removeChild(el);
          } else if (now >= Date.parse(el.getAttribute('data-hr-from'))) {
            el.removeAttribute('hidden');
          } else {
            el.setAttribute('hidden', '');
          }
        }
      }
      sweep();
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sweep);
    })();
  </script>
)}

<style is:global>
  [data-hr-until][hidden] { display: none !important; }
  .hr-holiday-strip {
    background: #1A1A1A;
    color: #FFFFFF;
    border-bottom: 2px solid #E6A817;
    padding: .6rem 1rem;
    text-align: center;
    font-family: 'Nunito', sans-serif;
    font-size: .9rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: .01em;
  }
  .hr-holiday-strip strong { color: #E6A817; font-weight: 800; white-space: nowrap; }
  .hr-holiday-strip .hr-nowrap { white-space: nowrap; }
  .hr-holiday-strip-phone { color: rgba(255,255,255,.75); font-weight: 500; }
  @media (max-width: 767px) { .hr-holiday-strip { font-size: .82rem; padding: .5rem .85rem; } }
  @media print { [data-hr-until] { display: none !important; } }
</style>
