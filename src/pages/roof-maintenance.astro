---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "RoofingContractor"],
    "name": "Happy Roof LLC","url": "https://happyroof.com","telephone": "+1-813-595-7663","email": "info@happyroof.com",
    "description": "Professional roof maintenance services in Tampa Bay. Preventive care, seasonal programs, gutter cleaning. FL License #CCC1337380.",
    "image": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg","logo": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "address": {"@type": "PostalAddress","streetAddress": "141 Stevens Ave #12","addressLocality": "Oldsmar","addressRegion": "FL","postalCode": "34677","addressCountry": "US"},
    "hasCredential": "Florida Roofing Contractor License #CCC1337380",
    "dateModified": "2026-04-25"
  },{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type": "Question","name": "How often should I have my roof maintained in Florida?","acceptedAnswer": {"@type": "Answer","text": "Twice a year, once in Spring before hurricane season and once after it ends, is the baseline for Tampa Bay. If your roof is over 15 years old or you have had recurring issues, adding a mid-summer check is usually worth it. Florida's heat and UV exposure wear down roofs faster than most climates, and this two-visit schedule lets us catch problems at the season boundaries when they are most likely to develop."}},
      {"@type": "Question","name": "What does roof maintenance include?","acceptedAnswer": {"@type": "Answer","text": "Our maintenance service includes a full roof inspection, debris removal, gutter cleaning, flashing and sealant reapplication where needed, minor repair of cracked or loose materials, ventilation check, and a condition report with photos. We address small problems on the spot so they don't grow into major issues."}},
      {"@type": "Question","name": "Can maintenance really extend my roof's lifespan?","acceptedAnswer": {"@type": "Answer","text": "Yes. Industry data consistently shows that regular professional maintenance can add 5-10 years to a roof's lifespan. By addressing minor wear, keeping drainage clear, and maintaining sealants and flashing, you prevent the cascading damage that leads to premature replacement. The cost of maintenance is a fraction of what a new roof costs."}},
      {"@type": "Question","name": "Do you offer a maintenance plan or program?","acceptedAnswer": {"@type": "Answer","text": "Yes. Happy Roof offers seasonal maintenance programs that include scheduled inspections and maintenance visits throughout the year. Contact us at (813) 595-7663 to learn about our current maintenance program options and pricing for your property."}},
      {"@type": "Question","name": "Will roof maintenance affect my insurance?","acceptedAnswer": {"@type": "Answer","text": "Generally in a positive direction. Florida insurers tend to look more favorably on well-maintained roofs, and having a documented maintenance history can help support any insurance claim since you are able to demonstrate that the property has been responsibly cared for. Some carriers also require documented maintenance to keep certain coverage provisions valid, particularly for older roofs."}},
      {"@type": "Question","name": "What happens if you find damage during a maintenance visit?","acceptedAnswer": {"@type": "Answer","text": "Minor issues like loose shingles, cracked sealant, or small debris damage will be handled during your scheduled maintenance visit at no extra charge. For anything more time-intensive, we will document it with photos and give you a written estimate to help you decide what to do moving forward."}},
      {"@type": "Question","name": "What roof maintenance can I safely do myself?","acceptedAnswer": {"@type": "Answer","text": "You can usually clean the gutters in spring and fall, trim branches back, and check the attic twice a year for stains or moisture on your own. Things like walking on the roof, pressure washing, patching active leaks, and any work around flashing, skylights, chimneys, or vents, however, are best left to professionals."}},
      {"@type": "Question","name": "How can I prevent roofing algae and moss growth?","acceptedAnswer": {"@type": "Answer","text": "The dark streaks you see on your roof might be Gloeocapsa magma, a type of algae that thrives in heat and humidity. Left alone, it can hold moisture against your shingles and shorten their lifespan. If prevention is your goal, we will install zinc ridge strips on any existing roof and include algae-resistant shingle options in every replacement quote. If you already have streaks and want them removed, the only appropriate method is a professional low-pressure soft wash."}}
    ]
  },{
    "@context": "https://schema.org","@type": "Service","serviceType": "Roof Maintenance",
    "provider": {"@type": "RoofingContractor","name": "Happy Roof LLC","telephone": "+1-813-595-7663","url": "https://happyroof.com"},
    "areaServed": {"@type": "State","name": "Florida"},
    "description": "Professional roof maintenance services in Tampa Bay including inspections, cleaning, gutter maintenance, sealant repair, and seasonal programs. Licensed contractor FL #CCC1337380."
  }]`;
---

<BaseLayout
  title="Roof Maintenance Services in Tampa Bay | Happy Roof"
  description="Interested in professional roof maintenance services? We offer preventative care, seasonal programs, gutter cleaning, and more. Get in touch today!"
  canonical="https://happyroof.com/roof-maintenance"
  ogDescription="Preventive roof maintenance in Tampa Bay. Extend your roof's lifespan with professional seasonal care. FL #CCC1337380."
  schema={schema}
>

<style is:inline>
.check-dot{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);flex-shrink:0;margin-top:.15rem}
    .step-num{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.25rem;color:#E6A817;flex-shrink:0}
</style>

<!-- PAGE HERO -->
<section class="pt-32 pb-20 relative overflow-hidden" style="background:#F5F5F5;border-bottom:1px solid #E5E5E5">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/architectural-shingle-roof-tampa-bay.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-5 text-center">
    <p class="sl gp mb-4">Roof Maintenance</p>
    <h1 class="font-display font-black tracking-tightest mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(3rem,6vw,5rem);line-height:.92;letter-spacing:-.01em;color:#1A1A1A">
      ROOF MAINTENANCE SERVICES<br/><span class="gt">TAMPA BAY.</span>
    </h1>
    <p class="max-w-3xl mx-auto" style="color:#555555;font-size:1.05rem;line-height:1.75">
      Most roof problems don't start with something dramatic. They start with a stretch of shingles that's been losing granules or a gutter that's been clogged long enough that water is backing up under the drip edge. By the time you notice something inside, the damage has usually been developing for months. Happy Roof offers professional roof maintenance services for residential and commercial properties across Tampa Bay, designed specifically for what Florida's climate does to roofing systems over time.
    </p>
    <div class="flex flex-wrap gap-3 justify-center mt-8">
      <a href="/contact" class="btn-t">Schedule Maintenance <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      <a href="tel:8135957663" class="btn-o call-tracking-number">Call (813) 595-7663</a>
    </div>
  </div>
</section>

<!-- INFO STRIP -->
<div style="background:#FFFFFF;border-top:2px solid #E6A817;border-bottom:1px solid #E0E0E0;padding:.85rem 0">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-display font-bold text-sm tracking-widest" style="color:#1A1A1A;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif">
      <span>Tampa Bay, FL</span><span style="color:#E6A817">·</span><span>CCC1337380</span><span style="color:#E6A817">·</span><span>HappyRoof.com</span><span style="color:#E6A817">·</span><span style="color:#3B9FD9">(813) 595-7663</span>
    </div>
  </div>
</div>

<!-- WHY MAINTENANCE MATTERS -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <p class="sl gt mb-3">Why Maintenance Matters</p>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.5rem">WHY DOES PREVENTATIVE MAINTENANCE MATTER?</h2>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          Florida puts roofing systems through more stress than most of the country, and the wear tends to be gradual enough that it sneaks up on you. A few issues that show up the most during our maintenance visits, and that can get expensive if they're missed, include:
        </p>
        <ul style="list-style:none;padding:0;margin:0;color:#555555;font-size:1rem;line-height:1.75">
          <li style="margin-bottom:1rem"><strong style="color:#1A1A1A">Failed Sealant Around Penetrations:</strong> Florida's UV breaks down sealant every three to five years, and it doesn't cost much to refresh it proactively.</li>
          <li style="margin-bottom:1rem"><strong style="color:#1A1A1A">Granule Loss on Asphalt Shingles:</strong> Once shingles start losing protective granules, whether from algae or the aftermath of a storm, their lifespan tends to shorten by 50-80%, which means they could fail within 1 to 5 years. Catching this early generally means the difference between preserving the existing roof and replacing it ahead of schedule.</li>
          <li style="margin-bottom:1rem"><strong style="color:#1A1A1A">Clogged Gutters:</strong> This is probably the most common source of preventable structural damage we see. Water that can't drain backs up under the drip edge and starts rotting fascia, which can end up being a much bigger problem than it needed to be.</li>
          <li style="margin-bottom:1rem"><strong style="color:#1A1A1A">Lifted or Loose Shingles:</strong> Wind breaks the adhesive seal between tabs without tearing them off, so the shingle looks intact from the ground while water is working through the gap every time it rains.</li>
          <li style="margin-bottom:0"><strong style="color:#1A1A1A">Debris Buildup in Roof Valleys:</strong> Anything from leaves to pine needles can hold moisture against the shingles and create the perfect conditions for algae and decay to form.</li>
        </ul>
      </div>
      <div class="space-y-4">
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Add 5-10 Years of Roof Life</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Regular professional maintenance prevents the cascading damage that leads to premature replacement. A well-maintained roof consistently outlasts a neglected one by 5 to 10 years.</p></div></div>
        </div>
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Avoid Emergency Repairs</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Emergency roof repairs are stressful and expensive. Maintenance catches the warning signs - cracked caulk, loose flashing, debris buildup - before they become urgent problems.</p></div></div>
        </div>
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Protect Warranty Coverage</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Many manufacturer warranties require or recommend regular maintenance. Documented professional care helps keep your warranty valid and supports claims if issues arise.</p></div></div>
        </div>
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Lower Energy Bills</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">A well-ventilated, properly sealed roof keeps your attic cooler and reduces the load on your AC system. In Florida's heat, this translates to meaningful savings on your monthly energy bill.</p></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT'S INCLUDED -->
<section class="py-20" style="background:#F5F5F5;border-top:1px solid #E5E5E5;border-bottom:1px solid #E5E5E5">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gp mb-3">What's Included</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.25rem">OUR ROOF MAINTENANCE SERVICES</h2>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:820px;margin:0 auto 1rem">
        Each visit includes a thorough roof inspection, debris removal from the surface and valleys, gutter cleaning and drainage check, sealant and flashing repairs where needed, minor repairs like loose shingles or popped fasteners, and a written condition report with photos after every visit so you have a clear record of what your roof looks like over time.
      </p>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:820px;margin:0 auto 1rem">
        Anything minor we find during the visit will be addressed on the spot at no extra charge. If we do come across something that warrants a separate repair estimate, we'll walk you through your options without any pressure to make a decision right then.
      </p>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:820px;margin:0 auto">
        We also offer seasonal maintenance programs that include scheduled inspections and maintenance visits throughout the year.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="scard p-6">
        <div class="step-num mb-4">01</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.5rem">Full Roof Inspection</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7">Every maintenance visit begins with a comprehensive inspection of your entire roofing system - materials, flashing, vents, soffit, fascia, gutters, and attic ventilation. We document everything with photos so you have a clear record of your roof's condition over time.</p>
      </div>
      <div class="scard p-6">
        <div class="step-num mb-4">02</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.5rem">Debris Removal</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7">Leaves, branches, pine needles, and other organic material trap moisture against your roof and accelerate deterioration. We clear all debris from the roof surface, valleys, and around penetrations to maintain proper drainage and prevent decay.</p>
      </div>
      <div class="scard p-6">
        <div class="step-num mb-4">03</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.5rem">Gutter Cleaning</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7">Clogged gutters cause water to back up under your roofline, leading to fascia rot, foundation problems, and landscape erosion. We clean all gutters and downspouts and verify proper water flow away from your foundation.</p>
      </div>
      <div class="scard p-6">
        <div class="step-num mb-4">04</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.5rem">Sealant &amp; Flashing Repair</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7">Florida's heat and UV exposure cause sealants to dry, crack, and fail faster than in cooler climates. We inspect and reapply sealant around vents, pipes, skylights, and flashing joints as needed - preventing the most common sources of roof leaks.</p>
      </div>
      <div class="scard p-6">
        <div class="step-num mb-4">05</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.5rem">Minor Repairs</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7">Loose shingles, cracked tiles, popped nails, and small gaps are addressed during the maintenance visit at no extra charge. These small fixes prevent water from reaching the deck and causing expensive structural damage down the road.</p>
      </div>
      <div class="scard p-6">
        <div class="step-num mb-4">06</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.5rem">Condition Report</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7">After every visit, you receive a written report with photos documenting your roof's current condition, work performed, and any recommendations for future attention. This documentation is valuable for insurance, warranty claims, and property records.</p>
      </div>
    </div>
  </div>
</section>

<!-- SEASONAL MAINTENANCE -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-10">
      <p class="sl gt mb-3">Seasonal Care</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.25rem">WHAT TYPES OF SEASONAL MAINTENANCE DO FLORIDA ROOFS NEED?</h2>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:720px;margin:0 auto">
        Florida's maintenance calendar is typically dictated by hurricane season, which runs June 1 through November 30.
      </p>
    </div>
    <div class="max-w-3xl mx-auto space-y-8">
      <div class="flex gap-5 items-start">
        <div class="step-num" style="background:rgba(59,159,217,.1);color:#3B9FD9">SPR</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.35rem">Spring (March - May)</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.75">This is the most important window of the year since it's when we address any wear that may have accumulated over the winter dry season and check drainage before the rainy season starts. We'll also refresh sealant at all your roof's penetration points. Any repairs identified during a spring visit can realistically be completed before hurricane season starts.</p>
        </div>
      </div>
      <div class="flex gap-5 items-start">
        <div class="step-num" style="background:rgba(230,168,23,.1);color:#E6A817">PRE</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.35rem">Pre-Hurricane Season (May - June)</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.75">We primarily focus on storm readiness at these visits. This usually includes reinforcing flashing at the transition points most likely to fail in high winds, clearing gutters, and securing anything that's loose.</p>
        </div>
      </div>
      <div class="flex gap-5 items-start">
        <div class="step-num" style="background:rgba(230,168,23,.1);color:#E6A817">PST</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.35rem">Post-Hurricane Season (December - January)</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.75">After hurricane season ends, we'll address the aftermath. Even if a storm doesn't cause obvious immediate damage, there may still be compromised seals or deposited debris that could cause problems over the winter.</p>
        </div>
      </div>
      <div class="flex gap-5 items-start">
        <div class="step-num" style="background:rgba(59,159,217,.1);color:#3B9FD9">ANN</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.15rem;margin-bottom:.35rem">Annual Deep Maintenance</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.75">Once a year, we'll recommend a more thorough visit, which normally goes a few steps further than seasonal appointments. These visits include an attic inspection and a detailed evaluation of all parts of the roof.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- EXTENDING ROOF LIFE -->
<section class="py-20" style="background:#F5F5F5;border-top:1px solid #E5E5E5;border-bottom:1px solid #E5E5E5">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <p class="sl gp mb-3">Roof Longevity</p>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.5rem">TIPS FOR EXTENDING YOUR ROOF'S LIFE IN FLORIDA</h2>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          Beyond professional maintenance, there are steps every homeowner can take to protect their roof investment. These habits, combined with regular professional care, help maximize your roof's performance and lifespan in Tampa Bay's demanding climate.
        </p>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          <strong>Keep trees trimmed.</strong> Overhanging branches drop debris, trap moisture, and can cause physical damage during storms. Maintain at least 6-10 feet of clearance between tree branches and your roof.
        </p>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          <strong>Ensure proper attic ventilation.</strong> Florida's heat builds up in poorly ventilated attics, cooking shingles from below and dramatically shortening their lifespan. Proper ridge and soffit ventilation keeps temperatures manageable and prevents moisture buildup.
        </p>
      </div>
      <div class="space-y-4">
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Check After Every Storm</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">After any significant weather event, do a visual check from the ground. Look for missing material, debris on the roof, or damaged gutters. Call a professional if anything looks off.</p></div></div>
        </div>
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Don't Ignore Gutters</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Clogged gutters are one of the leading causes of preventable roof damage. When water can't drain properly, it backs up under shingles and rots fascia boards. Clean them regularly or include it in your maintenance plan.</p></div></div>
        </div>
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Address Issues Immediately</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">A $200 repair today prevents a $5,000 problem next year. When you notice anything unusual - a water stain, a loose shingle visible from the ground, a musty smell in the attic - act quickly.</p></div></div>
        </div>
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Keep Records</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Maintain a file of all roof-related work, inspections, and maintenance reports. This documentation is valuable for insurance claims, warranty support, and future home sales.</p></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- DIY MAINTENANCE TIPS -->
<section class="py-20" style="background:#FFFFFF;border-top:1px solid #E5E5E5">
  <div class="max-w-5xl mx-auto px-5">
    <div class="text-center mb-12">
      <p class="sl gt mb-3">Homeowner DIY</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1rem">SAFE DIY ROOF MAINTENANCE TIPS</h2>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:680px;margin:0 auto">Most preventable roof problems get caught before they become expensive, by the homeowner, from the ground. Here's what's worth doing yourself, what to skip, and where pros take over.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <!-- Safe to DIY -->
      <div style="background:#F7F7F7;border:1px solid #E0E0E0;border-radius:14px;padding:1.5rem 1.75rem">
        <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:1rem">
          <div style="width:32px;height:32px;border-radius:8px;background:rgba(56,161,105,.12);display:flex;align-items:center;justify-content:center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38a169" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin:0">SAFE TO DIY</h3>
        </div>
        <ul style="list-style:none;padding:0;margin:0;color:#1A1A1A;font-size:.95rem;line-height:1.7">
          <li style="margin-bottom:.85rem"><strong>Clean gutters spring and fall.</strong> Clogged gutters back water under the drip edge and rot fascia. From a ladder against the eave only.</li>
          <li style="margin-bottom:.85rem"><strong>Trim overhanging branches.</strong> Keep at least 6&ndash;10 feet of clearance. Prevents abrasion from limbs in wind and reduces debris.</li>
          <li style="margin-bottom:.85rem"><strong>Visual check after every named storm.</strong> Walk the property and look up: missing shingles, dented gutters, debris on the roof, displaced vent caps.</li>
          <li style="margin-bottom:.85rem"><strong>Check the attic twice a year.</strong> Stains on the underside of decking, daylight through the roof, musty smell, wet insulation, all leak indicators long before you see a ceiling stain.</li>
          <li style="margin-bottom:.85rem"><strong>Photograph your roof annually.</strong> From the ground, same angles each time. Side-by-side comparison year-over-year catches gradual issues fast.</li>
          <li style="margin-bottom:0"><strong>Keep documentation.</strong> File all invoices, inspection reports, and warranty paperwork. Important for insurance claims and resale.</li>
        </ul>
      </div>

      <!-- Leave to the pros -->
      <div style="background:#F7F7F7;border:1px solid #E0E0E0;border-radius:14px;padding:1.5rem 1.75rem">
        <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:1rem">
          <div style="width:32px;height:32px;border-radius:8px;background:rgba(229,62,62,.1);display:flex;align-items:center;justify-content:center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e53e3e" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin:0">LEAVE TO THE PROS</h3>
        </div>
        <ul style="list-style:none;padding:0;margin:0;color:#1A1A1A;font-size:.95rem;line-height:1.7">
          <li style="margin-bottom:.85rem"><strong>Walking the roof.</strong> Florida shingles get brittle in the heat, even careful foot traffic damages granules. Tile roofs crack under weight. Wet roofs are slip hazards.</li>
          <li style="margin-bottom:.85rem"><strong>Pressure-washing shingles.</strong> Strips granules and shortens shingle life by years. Use a manufacturer-approved soft wash or call us for moss/algae removal.</li>
          <li style="margin-bottom:.85rem"><strong>Patching active leaks with caulk or tar.</strong> Hides the symptom, doesn't fix the cause, and complicates the eventual professional repair.</li>
          <li style="margin-bottom:.85rem"><strong>Replacing shingles or flashing.</strong> Wrong nail pattern, wrong overlap, or wrong sealant invalidates manufacturer warranties and creates leak paths.</li>
          <li style="margin-bottom:.85rem"><strong>Working around skylights, chimneys, or vents.</strong> Penetration flashing is where 80% of leaks start. Worth a pro every time.</li>
          <li style="margin-bottom:0"><strong>Anything during or right after a storm.</strong> Wet, hot, debris-strewn roofs are dangerous. Document from the ground and call.</li>
        </ul>
      </div>
    </div>

    <!-- Safety callout -->
    <div style="background:#1A1A1A;color:#FFFFFF;border-radius:14px;padding:1.5rem 1.75rem;max-width:760px;margin:0 auto;display:flex;gap:1rem;align-items:start">
      <div style="width:36px;height:36px;border-radius:50%;background:rgba(230,168,23,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.15rem">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div>
        <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.05rem;letter-spacing:.02em;text-transform:uppercase;margin:0 0 .35rem">Florida Safety Note</p>
        <p style="color:rgba(255,255,255,.85);font-size:.92rem;line-height:1.65;margin:0">Roof falls are one of the most common home-improvement injuries. If a tip requires you to step onto the roof itself, stop and call us. Call us at <a href="tel:8135957663" class="call-tracking-number" style="color:#E6A817;text-decoration:none;font-weight:600">(813) 595-7663</a>. We do free maintenance inspections.</p>
      </div>
    </div>
  </div>
</section>

<!-- ALGAE + MOSS PREVENTION -->
<section class="py-20" style="background:#F5F5F5;border-top:1px solid #E5E5E5;border-bottom:1px solid #E5E5E5">
  <div class="max-w-5xl mx-auto px-5">
    <div class="text-center mb-12">
      <p class="sl gp mb-3">Gloeocapsa Magma</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">PREVENTING ALGAE AND MOSS ON TAMPA BAY ROOFS</h2>
      <p style="color:#555555;font-size:1.05rem;line-height:1.75;margin-top:1rem;max-width:720px;margin-left:auto;margin-right:auto">
        The dark streaks you see on 5-10 year old roofs across Tampa Bay are algae, and our humidity plus warm temperatures plus afternoon rain make Florida one of the toughest shingle climates in the country. Left alone, a heavy algae mat holds moisture against the shingles and can shorten roof life by 3-5 years.
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      <div class="scard p-6">
        <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:.9rem;color:#E6A817;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">1. Zinc or Copper Ridge Strips</p>
        <p style="color:#555555;font-size:.95rem;line-height:1.65">The <a href="https://www.asphaltroofing.org/" target="_blank" rel="noopener" style="color:#3B9FD9;text-decoration:underline">ARMA-endorsed</a> approach. Rain washes trace ions down the roof and inhibits algae growth. Passive, permanent, works on any shingle. $300-$700 installed.</p>
      </div>
      <div class="scard p-6">
        <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:.9rem;color:#E6A817;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">2. Algae-Resistant Shingles at Replacement</p>
        <p style="color:#555555;font-size:.95rem;line-height:1.65">Owens Corning StreakGuard, GAF StainGuard Plus, and CertainTeed StreakFighter embed copper granules with a 10-year or lifetime algae warranty. $200-$400 upgrade over a standard replacement, cheapest lifetime prevention.</p>
      </div>
      <div class="scard p-6">
        <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:.9rem;color:#E6A817;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">3. Trim Overhanging Canopy</p>
        <p style="color:#555555;font-size:.95rem;line-height:1.65">Shade plus trapped humidity is the algae growth zone. Aim for 6-10 feet of clearance from any roof surface, and 10 feet is better than 6 during storm season.</p>
      </div>
      <div class="scard p-6">
        <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:.9rem;color:#E6A817;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">4. Keep the Roof Debris-Free</p>
        <p style="color:#555555;font-size:.95rem;line-height:1.65">Leaves and pine needles hold moisture against the shingles and feed the ecosystem. If you can reach it from a stable ladder at the eave, brush it off. Otherwise call a pro.</p>
      </div>
      <div class="scard p-6" style="grid-column:span 2 / span 2;background:#FEF3C7;border-color:#FDE68A">
        <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:.9rem;color:#B45309;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">Do Not Pressure-Wash</p>
        <p style="color:#78350F;font-size:.95rem;line-height:1.65">High-pressure water strips protective granules and voids most shingle warranties. Existing streaks come off with a professional low-pressure soft-wash only (30-50 PSI, controlled dilution, landscaping pre-wetted). Never use a household pressure washer, and never DIY roof access to attempt it.</p>
      </div>
    </div>
    <div class="text-center mt-8">
      <p style="color:#555555;font-size:.95rem;line-height:1.7;max-width:640px;margin:0 auto">
        Happy Roof installs zinc ridge strips on any existing roof and includes algae-resistant shingle options in every replacement quote. <a href="/contact" style="color:#3B9FD9;text-decoration:underline;font-weight:600">Get a free algae assessment.</a>
      </p>
    </div>
  </div>
</section>

