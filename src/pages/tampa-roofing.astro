---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "RoofingContractor"],
    "name": "Happy Roof LLC",
    "url": "https://happyroof.com",
    "telephone": "+1-813-595-7663",
    "email": "info@happyroof.com",
    "description": "Tampa roofing contractor specializing in shingle, metal, and tile roof replacement and installation. Licensed and insured. FL License #CCC1337380.",
    "image": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "logo": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "141 Stevens Ave #12",
      "addressLocality": "Oldsmar",
      "addressRegion": "FL",
      "postalCode": "34677",
      "addressCountry": "US"
    },
    "areaServed": {
      "@type": "City",
      "name": "Tampa",
      "containedInPlace": {
        "@type": "State",
        "name": "Florida"
      }
    },
    "hasCredential": "Florida Roofing Contractor License #CCC1337380",
    "dateModified": "2026-04-25"
  },{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much does a roof replacement cost?",
        "acceptedAnswer": { "@type": "Answer", "text": "The number depends on the size of your roof, the material you choose, and whether any decking or structural work is needed. Older Tampa neighborhoods like Seminole Heights sometimes have original framing that will require a little more attention during a tear-off. We provide a free, detailed written estimate so there are not any surprises. Call (813) 595-7663 for a personalized quote." }
      },
      {
        "@type": "Question",
        "name": "What roofing materials work best for Tampa's climate?",
        "acceptedAnswer": { "@type": "Answer", "text": "Tampa's hot, humid climate with frequent afternoon storms and hurricane risk means your roofing material must handle intense UV, heavy rain, and high winds. Architectural shingles (Owens Corning Duration) rated for 130+ MPH winds are the most popular choice. Standing seam metal reflects heat and lasts 40-60 years. Tile roofs are ideal for Mediterranean-style homes common in Tampa neighborhoods like Palma Ceia and Beach Park." }
      },
      {
        "@type": "Question",
        "name": "Does Happy Roof handle permits for Tampa roofing projects?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Happy Roof handles all permit applications with the City of Tampa and Hillsborough County building departments. We manage the entire permitting and inspection process so you don't have to visit any government offices or coordinate inspectors yourself." }
      },
      {
        "@type": "Question",
        "name": "How long does a roof replacement take?",
        "acceptedAnswer": { "@type": "Answer", "text": "Shingle replacements typically take one to three days, while metal runs three to five days. For tile, you can generally expect it to be five to seven days, though it ultimately depends on the complexity of the job. Afternoon thunderstorms occasionally cause short delays in the summer months, but we will plan around the weather and keep you updated if anything comes up." }
      },
      {
        "@type": "Question",
        "name": "Is Happy Roof licensed to work in the City of Tampa?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Happy Roof LLC holds Florida Roofing Contractor License #CCC1337380, which authorizes us to perform roofing work throughout the state of Florida, including the City of Tampa and all of Hillsborough County. We carry full general liability and workers' compensation insurance." }
      }
    ]
  },{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Tampa Roofing Contractor | Licensed & Insured | Happy Roof",
    "url": "https://happyroof.com/tampa-roofing",
    "description": "Tampa roofing contractor for roof replacement, repair, and installation. Licensed and insured. FL #CCC1337380.",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".speakable-summary"]
    },
    "inLanguage": "en-US",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Happy Roof",
      "url": "https://happyroof.com"
    }
  }]`;
---

<BaseLayout
  title="Tampa Roofing Contractor | Happy Roof"
  description="Our Tampa roofing contractors provide replacement, repair, and installation services throughout the area. Contact Happy Roof today to learn more!"
  canonical="https://happyroof.com/tampa-roofing"
  ogTitle="Tampa Roofing Contractor | Happy Roof"
  ogDescription="Licensed Tampa roofer for replacements, repairs & storm damage. Free estimates.  Call (813) 595-7663."
  schema={schema}
>

<style is:inline>
.check-dot{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);flex-shrink:0;margin-top:.15rem}
    .step-num{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.25rem;color:#E6A817;flex-shrink:0}
</style>

<!-- HERO -->
<section class="pt-32 pb-20 relative overflow-hidden" style="background:#F5F5F5;border-bottom:1px solid #E5E5E5">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/architectural-shingle-roof-tampa-bay.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-5 text-center">
    <p class="sl gp mb-4">Tampa Roofing</p>
    <h1 class="font-display font-black tracking-tightest mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:.92;letter-spacing:-.01em;color:#1A1A1A">
      TAMPA ROOFING <span class="gt">CONTRACTOR</span>
    </h1>
    <p class="speakable-summary max-w-2xl mx-auto" style="color:#555555;font-size:1.05rem;line-height:1.75">
      Tampa is one of the most hurricane-exposed cities in the country, and with over 30 years of experience, our team has seen what that means for roofs firsthand. Whether your roof needs a repair or a full replacement after a storm, learn more about our services below.
    </p>
    <div class="flex flex-wrap gap-3 justify-center mt-8">
      <a href="/contact" class="btn-t">Get a Free Estimate <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      <a href="tel:8135957663" class="btn-o call-tracking-number">Call (813) 595-7663</a>
    </div>
  </div>
</section>

<!-- INFO STRIP -->
<div style="background:#FFFFFF;border-top:2px solid #E6A817;border-bottom:1px solid #E0E0E0;padding:.85rem 0">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-display font-bold text-sm tracking-widest" style="color:#1A1A1A;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif">
      <span>Tampa, FL</span>
      <span style="color:#E6A817">·</span>
      <span>CCC1337380</span>
      <span style="color:#E6A817">·</span>
      <span>HappyRoof.com</span>
      <span style="color:#E6A817">·</span>
      <span style="color:#3B9FD9">(813) 595-7663</span>
    </div>
  </div>
</div>

<!-- WHY HAPPY ROOF IN TAMPA -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <p class="sl gt mb-3">Why Happy Roof in Tampa</p>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.5rem">WHY TAMPA HOMEOWNERS CALL US FIRST</h2>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          Tampa is a big city, and the roofing issues you run into in South Tampa near the bay are genuinely different from what you might see in New Tampa or Temple Terrace. At Happy Roof, our team has first-hand knowledge of Hillsborough County's permitting process and what the local climate does to different roofing materials over time.
        </p>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          Beyond our local knowledge, what we hear most from home and business owners is that we give them a straight answer. We're not going to tell you your roof needs to be replaced if it doesn't. Also, every job comes with a written estimate up front and warranty documentation before we close out.
        </p>
      </div>
      <div class="space-y-4">
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Up to 15-Year Workmanship Warranty</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Every Tampa roof we install comes with a written up to 15-year workmanship warranty, no exceptions, no fine print.</p></div></div>
        </div>
        <div class="scard p-6">
          <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Hillsborough County Permits Handled</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We pull all required permits with the City of Tampa and Hillsborough County and coordinate every inspection from start to finish.</p></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES IN TAMPA -->
<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">Our Services</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">ROOFING AND STORM RESTORATION SERVICES</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Roof Replacement</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">
          Every roof eventually reaches the point where repairs stop making sense. When that happens, we'll replace it with a system built to handle Tampa's humidity and hurricane season. We'll walk you through your material options, including <a href="/eco-friendly-roofing" style="color:#3B9FD9;text-decoration:none;font-weight:600">ENERGY STAR cool-rated and sustainable</a> upgrades, and handle everything from the tear-off to the final county inspection, so you don't have to worry about anything.
        </p>
      </div>
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Roof Repair</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">
          Whether it's a leak or flashing that's worked its way loose around a chimney, we'll track down the actual cause and repair it. A lot of homeowners assume they need a full replacement when a repair is all that's needed, and we'll always be upfront about which one makes sense for your situation.
        </p>
      </div>
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Storm Damage and Insurance</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">
          After a storm moves through, documentation matters almost as much as the repair itself. We'll assess your roof and photograph the damage for your insurance company. We can also be on-site with you during the adjuster inspection and will work directly with your carrier from start to finish. If water is getting in and you need emergency tarping while everything gets sorted out, we can handle that too.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- OUR PROCESS -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">How It Works</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">WHAT TO EXPECT</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="scard p-8 flex gap-5">
        <div class="step-num">1</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Free Inspection and Estimate</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">We'll inspect every aspect of your roofing system and provide you with a detailed written estimate that includes material options and pricing. Rest assured, there's never any obligation to work with us.</p>
        </div>
      </div>
      <div class="scard p-8 flex gap-5">
        <div class="step-num">2</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Material Selection and Permits</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">Once you're ready to move forward, we'll help you choose the material and color. We'll also handle all permit applications with the City of Tampa and Hillsborough County Building Department and schedule the required inspections. We'll also make sure the job is properly signed off before we close out. You won't have to worry about visiting any government offices or dealing with inspectors yourself.</p>
        </div>
      </div>
      <div class="scard p-8 flex gap-5">
        <div class="step-num">3</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Professional Installation</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">Our licensed, insured crew will handle the entire job from start to finish. We'll be sure to protect your property throughout the process and do a complete cleanup before we leave. Every installation is done to manufacturer specifications.</p>
        </div>
      </div>
      <div class="scard p-8 flex gap-5">
        <div class="step-num">4</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Final Inspection and Warranty</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">As mentioned, we'll coordinate the Hillsborough County inspection and confirm code compliance. You'll receive your workmanship warranty and manufacturer warranty in writing, and we'll follow up with you at the 30-day and one-year marks.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICE AREA -->
<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-10">
      <p class="sl gt mb-3">Tampa Service Area</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1rem">NEIGHBORHOODS WE SERVE IN TAMPA</h2>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:700px;margin:0 auto">Happy Roof provides roofing services throughout the greater Tampa area and all of Hillsborough County. From the historic bungalows in Seminole Heights and the Mediterranean estates in Palma Ceia to the newer construction in New Tampa and Westchase, we know the roofing challenges each neighborhood faces. South Tampa homes near the bay deal with salt air corrosion, while inland areas like Carrollwood and Town 'N Country see more wind damage from summer storms. Hyde Park's historic homes often require architectural-style shingles to match neighborhood character.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 max-w-4xl mx-auto">
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">South Tampa</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Seminole Heights</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Palma Ceia</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Westshore</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Hyde Park</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Davis Islands</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Carrollwood</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">New Tampa</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Town 'n' Country</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Channelside</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Ybor City</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Citrus Park</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Beach Park</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Bayshore</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Harbour Island</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Temple Terrace</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Brandon</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Lutz</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Westchase</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Riverview</span>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-3xl mx-auto px-5">
    <div class="text-center mb-12">
      <p class="sl gt mb-3">Common Questions</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">FREQUENTLY ASKED QUESTIONS</h2>
    </div>

    <div class="faq-item">
      <button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">
        How much does a roof replacement cost?
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">The number depends on the size of your roof, the material you choose, and whether any decking or structural work is needed. Older Tampa neighborhoods like Seminole Heights sometimes have original framing that'll require a little more attention during a tear-off. We provide a free, detailed written estimate so there aren't any surprises. Call <a href="tel:8135957663" class="call-tracking-number" style="color:#3B9FD9;text-decoration:none;font-weight:600">(813) 595-7663</a> for a personalized quote.</div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">
        What roofing materials work best for Tampa's climate?
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">Tampa's hot, humid climate with frequent afternoon storms and hurricane risk means your roof must handle intense UV exposure, heavy rain, and high winds. Architectural shingles (Owens Corning Duration) rated for 130+ MPH winds are the most popular choice. Standing seam metal reflects solar heat and lasts 40–60 years. Tile roofs are ideal for Mediterranean-style homes found throughout Palma Ceia, Beach Park, and Davis Islands. Happy Roof installs all three and can help you choose.</div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">
        Does Happy Roof handle permits for Tampa roofing projects?
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">Yes. Happy Roof handles all permit applications with the City of Tampa and Hillsborough County building departments. We manage the entire permitting and inspection process. You never have to visit a government office or coordinate with an inspector yourself. All work is performed to current Florida Building Code standards.</div>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">
        How long does a roof replacement take?
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="faq-answer">
        <div class="faq-answer-inner">Shingle replacements typically take one to three days, while metal runs three to five days. For tile, you can generally expect it to be five to seven days, though it ultimately depends on the complexity of the job. Afternoon thunderstorms occasionally cause short delays in the summer months, but we'll plan around the weather and keep you updated if anything comes up.</div>
      </div>
