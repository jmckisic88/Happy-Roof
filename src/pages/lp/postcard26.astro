  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Roof Now, Pay Later | Claim Your Postcard Offer | Happy Roof</title>
  <meta name="robots" content="noindex, nofollow" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box}body{background:#FFFFFF;color:#1A1A1A;font-family:'Nunito',sans-serif;margin:0}html{scroll-behavior:smooth}
    .gp{color:#E6A817}.gt{color:#3B9FD9}
    .sl{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.82rem;letter-spacing:.2em;text-transform:uppercase}
    .btn-t{background:#E6A817;color:#1A1A1A;border-radius:8px;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.05rem;letter-spacing:.04em;padding:.85rem 2rem;transition:background .18s,transform .2s cubic-bezier(.34,1.56,.64,1),box-shadow .18s;box-shadow:0 4px 24px -4px rgba(230,168,23,.48);display:inline-flex;align-items:center;justify-content:center;gap:.45rem;text-decoration:none;width:100%;cursor:pointer;border:none}
    .btn-t:hover{background:#F0C040;transform:translateY(-2px)}
    .btn-t:focus-visible{outline:2px solid #E6A817;outline-offset:3px}
    .btn-t:active{transform:translateY(0)}
    .btn-call{background:#3B9FD9;color:#FFFFFF;border-radius:8px;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.05rem;letter-spacing:.04em;padding:.85rem 1.75rem;display:inline-flex;align-items:center;gap:.5rem;text-decoration:none;box-shadow:0 4px 20px -4px rgba(59,159,217,.4);transition:background .18s,transform .2s cubic-bezier(.34,1.56,.64,1)}
    .btn-call:hover{background:#2B8FC9;transform:translateY(-2px)}
    .check{display:flex;align-items:flex-start;gap:.6rem;margin-bottom:.85rem}
    /* Override global.css section:first-of-type !important — this LP has its own header (no fixed nav), so it doesn't need the site-nav top offset */
    .postcard-hero{background:linear-gradient(180deg,#FFFFFF 0%,#FAFAF5 100%);padding-top:1.25rem !important;padding-bottom:3rem !important}
    @media(max-width:767px){.postcard-hero{padding-top:1rem !important;padding-bottom:2rem !important}}
    .offer-box-gold{background:#E6A817;color:#FFFFFF;border-radius:14px;padding:1.15rem 1.25rem;text-align:center;box-shadow:0 6px 24px -8px rgba(230,168,23,.5)}
    .offer-box-black{background:#1A1A1A;color:#FFFFFF;border-radius:14px;padding:1.15rem 1.25rem;text-align:center;border:1.5px solid rgba(230,168,23,.35)}
    .pillar{background:#FFFFFF;border:1px solid #E0E0E0;border-radius:14px;padding:1.75rem 1.25rem;text-align:center}
    .promo-badge{background:rgba(230,168,23,.12);border:1.5px dashed #E6A817;border-radius:10px;padding:.85rem 1rem;text-align:center;margin-bottom:1.25rem}
    .promo-input{background:rgba(230,168,23,.1) !important;border:1.5px solid #E6A817 !important;color:#B87700 !important;font-family:'Barlow Condensed',sans-serif !important;font-weight:900 !important;letter-spacing:.14em !important;text-align:center;text-transform:uppercase;cursor:not-allowed}
    .sticky-cta{position:fixed;bottom:0;left:0;right:0;background:#1A1A1A;padding:.85rem 1rem;box-shadow:0 -4px 20px -4px rgba(0,0,0,.25);z-index:50;display:none}
    @media(max-width:767px){
      .lp-grid{grid-template-columns:1fr !important}
      .sticky-cta{display:block}
      body{padding-bottom:70px}
    }
  </style>
<meta property="og:image" content="https://www.happyroof.com/Brand%20Assets/Happy%20Roof%20Logo_Alt.png">
</head>
<body>
