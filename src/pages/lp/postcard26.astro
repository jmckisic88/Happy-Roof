<script is:inline>
function submitForm(e){
  e.preventDefault();
  var form=e.target;
  var turnstileToken = (form.querySelector('[name="cf-turnstile-response"]') || {}).value || '';
  var data=new FormData(form);
  var obj={};data.forEach(function(v,k){obj[k]=v});
  var heroesNote = obj.heroes_discount==='Yes' ? ' | HEROES DISCOUNT REQUESTED ($500 off eligibility)' : '';
  var stPayload = {
    name: obj.name||'',
    phone: obj.phone||'',
    email: obj.email||'',
    service: 'Direct Mail Lead - POSTCARD26',
    notes: 'Address: ' + (obj.address||'') + ' | Promo: ' + (obj.promo_code||'POSTCARD26') + heroesNote,
    source: 'Direct Mail - POSTCARD26',
    page: '/lp/postcard26',
    turnstile_token: turnstileToken
  };
  fetch('/api/submit-lead', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(stPayload) })
    .then(function(r){ return r.ok ? r.json() : Promise.reject(); })
    .catch(function(){ return fetch('https://formsubmit.co/ajax/info@happyroof.com', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify(obj) }); })
    .finally(function(){
      form.style.display='none';
      document.getElementById('form-success').style.display='block';
    });
  return false;
}
</script>

