<!-- HEADER -->
<header style="background:#FFFFFF;border-bottom:1px solid #E0E0E0;padding:.75rem 1.5rem">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <a href="/" aria-label="Happy Roof Home" style="display:inline-flex;align-items:center;text-decoration:none">
      <img src="/Brand Assets/Happy Roof Logo.png" alt="Happy Roof" style="height:48px;width:auto" />
    </a>
    <a href="tel:8133311032" style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.15rem;color:#3B9FD9;text-decoration:none;display:flex;align-items:center;gap:.4rem">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      (813) 331-1032
    </a>
  </div>
</header>

<!-- HERO + FORM -->
<section class="postcard-hero relative overflow-hidden" style="padding:1.25rem 0 3rem">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-10 items-start lp-grid" style="grid-template-columns:1fr 1fr">
      <!-- LEFT: Copy -->
      <div>
        <p style="font-family:'Nunito',sans-serif;font-size:1rem;color:#555;margin-bottom:.5rem;letter-spacing:.01em">Don't Delay the Roof You Need.</p>
        <h1 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(3rem,7vw,5.5rem);line-height:.86;letter-spacing:-.015em;color:#1A1A1A;margin-bottom:.35rem;text-transform:uppercase">
          Roof Now,<br/>
          <span style="color:#E6A817">Pay Later!</span>
        </h1>
        <p style="color:#555;font-size:1rem;line-height:1.7;margin:1.5rem 0 1.75rem;max-width:480px">
          Claim your postcard offer with Happy Roof, Tampa Bay's licensed roofing contractor with more than 30 years of combined experience. Free inspection, up to 15-year workmanship warranty, and financing options available.
        </p>

        <!-- Two Offer Boxes -->
        <div class="grid grid-cols-2 gap-3 mb-6" style="max-width:520px">
          <div class="offer-box-gold">
            <p style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:2.4rem;line-height:1;margin:0">10% OFF</p>
            <p style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;letter-spacing:.03em;margin:.25rem 0 .5rem">Any Roofing Job</p>
            <p style="font-size:.7rem;line-height:1.4;margin:0;opacity:.85">Code <strong>POSTCARD26</strong>. Offer expires 30 days from mailing.</p>
          </div>
          <div class="offer-box-black">
            <p style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:2.4rem;line-height:1;color:#E6A817;margin:0">$500 OFF</p>
            <p style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;letter-spacing:.03em;margin:.25rem 0 .5rem">Heroes Discount</p>
            <p style="font-size:.7rem;line-height:1.4;margin:0;opacity:.75">Vets, active-duty military, first responders, doctors, nurses, teachers.</p>
          </div>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin-bottom:1rem">
          <a href="tel:8133311032" class="btn-call">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            CALL (813) 331-1032
          </a>
          <span style="color:#555;font-size:.88rem">or fill out the form &rarr;</span>
        </div>
        <p style="color:#888;font-size:.78rem;margin:0;font-style:italic">
          Ask about our available financing options.
        </p>
      </div>

      <!-- RIGHT: Form -->
      <div id="form-anchor" style="background:#FFFFFF;border:1px solid #E0E0E0;border-radius:16px;padding:1.75rem;box-shadow:0 8px 40px -8px rgba(0,0,0,.12)">
        <div class="promo-badge">
          <p style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.72rem;color:#B87700;letter-spacing:.14em;text-transform:uppercase;margin:0 0 .2rem">Your Postcard Offer</p>
          <p style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.15rem;color:#1A1A1A;margin:0;letter-spacing:.02em">POSTCARD26 &middot; <span style="color:#B87700">10% OFF ANY JOB</span></p>
          <p style="font-size:.72rem;color:#555;margin:.3rem 0 0">Automatically applied when you submit below.</p>
        </div>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.5rem;color:#1A1A1A;margin-bottom:.35rem;text-align:center">CLAIM YOUR OFFER</h2>
        <p style="color:#555555;font-size:.9rem;text-align:center;margin-bottom:1.25rem">Free inspection scheduled within 24 hours. No obligation.</p>

        <form id="lp-form" onsubmit="return submitForm(event)">
          <div style="display:flex;flex-direction:column;gap:.7rem">
            <input type="text" name="name" placeholder="Full Name" required />
            <input type="tel" name="phone" placeholder="Phone Number" required />
            <input type="email" name="email" placeholder="Email Address" required />
            <input type="text" name="address" placeholder="Property Address" required />
            <div>
              <label style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.7rem;color:#555;letter-spacing:.1em;text-transform:uppercase;display:block;margin:.15rem 0 .25rem">Promo Code (Applied)</label>
              <input type="text" name="promo_code" value="POSTCARD26" readonly class="promo-input" />
            </div>
            <input type="hidden" name="_subject" value="LP: POSTCARD26 - Roof Now Pay Later" />

            <!-- Heroes Discount -->
            <div style="display:flex;align-items:flex-start;gap:.5rem;background:rgba(59,159,217,.06);border:1px solid rgba(59,159,217,.18);border-radius:8px;padding:.65rem .8rem;margin-top:.35rem">
              <input type="checkbox" id="heroes-discount" name="heroes_discount" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
              <label for="heroes-discount" style="font-size:.78rem;color:#333;line-height:1.5;cursor:pointer">
                I'm a <strong>veteran, active-duty military, first responder, doctor, nurse, or teacher</strong>. Please also apply the <strong style="color:#3B9FD9">$500 Heroes Discount</strong>.
              </label>
            </div>

            <!-- SMS + Terms consent -->
            <div style="display:flex;flex-direction:column;gap:.55rem;margin-top:.5rem">
              <div style="display:flex;align-items:flex-start;gap:.5rem">
                <input type="checkbox" id="sms-transactional-pc" name="sms_transactional" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
                <label for="sms-transactional-pc" style="font-size:.7rem;color:#555;line-height:1.5;cursor:pointer">By checking, you allow <strong>transactional/informational SMS</strong> from Happy Roof (appointment confirmations, etc.). Msg frequency varies. Data rates may apply. Reply <strong>STOP</strong> to opt out.</label>
              </div>
              <div style="display:flex;align-items:flex-start;gap:.5rem">
                <input type="checkbox" id="sms-marketing-pc" name="sms_marketing" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
                <label for="sms-marketing-pc" style="font-size:.7rem;color:#555;line-height:1.5;cursor:pointer">By checking, you allow <strong>promotional/marketing SMS</strong> from Happy Roof. Frequency varies. Data rates may apply. Reply <strong>HELP</strong> for help or <strong>STOP</strong> to opt out.</label>
              </div>
              <div style="display:flex;align-items:flex-start;gap:.5rem">
                <input type="checkbox" id="terms-consent-pc" name="terms_consent" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
                <label for="terms-consent-pc" style="font-size:.7rem;color:#555;line-height:1.5;cursor:pointer">By checking, you accept our <a href="/terms" style="color:#3B9FD9;text-decoration:underline">Terms of Service</a> &amp; <a href="/privacy" style="color:#3B9FD9;text-decoration:underline">Privacy Policy</a>.</label>
              </div>
            </div>

            <!-- Cloudflare Turnstile bot protection -->
            <div class="cf-turnstile" data-sitekey="0x4AAAAAADNeVY-2r71EFud-" data-theme="light" style="margin:.75rem 0"></div>

            <button type="submit" class="btn-t" style="margin-top:.25rem">CLAIM MY 10% OFF + FREE INSPECTION <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></button>
          </div>
        </form>
        <div id="form-success" style="display:none;text-align:center;padding:2rem 0">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.4rem;margin-top:.75rem;color:#1A1A1A">You're All Set!</h3>
          <p style="color:#555555;font-size:.95rem;margin-top:.35rem;line-height:1.6">Your <strong>POSTCARD26</strong> offer is captured. We'll confirm your free inspection within 24 hours.</p>
          <p style="color:#888;font-size:.82rem;margin-top:1rem">Need us sooner? Call <a href="tel:8133311032" style="color:#3B9FD9;font-weight:700;text-decoration:none">(813) 331-1032</a>.</p>
        </div>

        <div style="display:flex;align-items:center;justify-content:center;gap:1rem;margin-top:1.25rem;flex-wrap:wrap">
          <span style="font-size:.7rem;color:#999;display:flex;align-items:center;gap:.3rem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Licensed FL #CCC1337380</span>
          <span style="font-size:.7rem;color:#999;display:flex;align-items:center;gap:.3rem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>15-yr Warranty</span>
          <span style="font-size:.7rem;color:#999;display:flex;align-items:center;gap:.3rem"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Free Inspection</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES STRIP -->
<section style="background:#1A1A1A;padding:1.25rem 0;border-top:2px solid #E6A817">
  <div class="max-w-6xl mx-auto px-5 text-center" style="color:#FFFFFF;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.95rem;letter-spacing:.05em">
    Roof Replacement &nbsp;&middot;&nbsp; Roof Repair &nbsp;&middot;&nbsp; Storm Damage Repair &nbsp;&middot;&nbsp; Gutter Repair &nbsp;&middot;&nbsp; Commercial Roofing
  </div>
</section>

<!-- THREE PILLARS: Extend / Lower / Enjoy -->
<section style="background:#F7F7F7;padding:4rem 0">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-10">
      <p style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:#3B9FD9;margin:0 0 .5rem">Stay Protected Through Florida Storms</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin:0">
        ROOFING BUILT TO LAST
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="pillar">
        <div style="width:56px;height:56px;border-radius:14px;background:rgba(230,168,23,.14);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin:0 0 .5rem;letter-spacing:.02em">Extend</h3>
        <p style="color:#555;font-size:.92rem;line-height:1.6;margin:0">Your roof's lifespan with expert installation and repairs.</p>
      </div>
      <div class="pillar">
        <div style="width:56px;height:56px;border-radius:14px;background:rgba(59,159,217,.12);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin:0 0 .5rem;letter-spacing:.02em">Lower</h3>
        <p style="color:#555;font-size:.92rem;line-height:1.6;margin:0">Insurance costs with a properly installed, high-quality roof.</p>
      </div>
      <div class="pillar">
        <div style="width:56px;height:56px;border-radius:14px;background:rgba(230,168,23,.14);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin:0 0 .5rem;letter-spacing:.02em">Enjoy</h3>
        <p style="color:#555;font-size:.92rem;line-height:1.6;margin:0">Peace of mind with strong warranties and guaranteed workmanship.</p>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIAL -->
<section style="background:#FFFFFF;padding:4rem 0">
  <div class="max-w-3xl mx-auto px-5 text-center">
    <div style="color:#E6A817;font-size:1.5rem;letter-spacing:.15em;margin-bottom:1rem">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <p style="color:#333;font-size:1.02rem;line-height:1.75;font-style:italic;margin:0 0 1.25rem">
      &ldquo;Happy Roof did an amazing job. They were on time, polite and courteous across the board. They ensured my property remained undamaged during the roof replacement. It is refreshing to find a company that is concerned about <strong>quality work, integrity and the added bonus of being very reasonably priced.</strong> In fact, they were the cheapest of all the estimates received. I highly recommend this company for anyone needing a new roof. Rare find!&rdquo;
    </p>
    <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;color:#1A1A1A;letter-spacing:.05em;margin:0">KATHLEEN P.</p>
  </div>
</section>

<!-- REFERRAL BONUS -->
<section style="background:#F7F7F7;padding:3.5rem 0;border-top:1px solid #E0E0E0">
  <div class="max-w-4xl mx-auto px-5">
    <div style="background:#FFFFFF;border:1px solid #E0E0E0;border-radius:16px;padding:2rem 2.5rem;text-align:center;box-shadow:0 4px 24px -8px rgba(0,0,0,.05)">
      <p style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:#3B9FD9;margin:0 0 .35rem">All Set On Your Roof?</p>
      <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(1.5rem,3vw,2.2rem);line-height:1.05;color:#1A1A1A;letter-spacing:-.01em;margin:0 0 1rem">
        KNOW A NEIGHBOR? EARN UP TO <span style="color:#3B9FD9">$1,000 CASH.</span>
      </h3>
      <p style="color:#555;font-size:.95rem;line-height:1.65;margin:0 0 1.5rem;max-width:520px;margin-left:auto;margin-right:auto">
