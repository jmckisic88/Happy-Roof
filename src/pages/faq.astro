---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "RoofingContractor"],
    "name": "Happy Roof LLC",
    "url": "https://happyroof.com",
    "telephone": "+1-813-595-7663",
    "email": "info@happyroof.com",
    "description": "Tampa Bay's trusted roofing contractor. Owens Corning Preferred Contractor installing shingle, metal, and tile roofing systems with up to a 15-year workmanship warranty. BBB Accredited. FL License #CCC1337380.",
    "image": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "logo": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "141 Stevens Ave #12","addressLocality": "Oldsmar",
      "addressRegion": "FL","postalCode": "34677",
      "addressCountry": "US"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 28.0340, "longitude": -82.6651 },
    "priceRange": "$$",
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" }
    ],
    "areaServed": [
      { "@type": "City", "name": "Tampa" },
      { "@type": "City", "name": "St. Petersburg" },
      { "@type": "City", "name": "Clearwater" },
      { "@type": "City", "name": "Brandon" },
      { "@type": "City", "name": "Wesley Chapel" },
      { "@type": "City", "name": "Riverview" },
      { "@type": "City", "name": "Lutz" },
      { "@type": "City", "name": "Land O Lakes" },
      { "@type": "City", "name": "Odessa" },
      { "@type": "City", "name": "Temple Terrace" },
      { "@type": "City", "name": "Oldsmar" },
      { "@type": "City", "name": "Palm Harbor" },
      { "@type": "City", "name": "Tarpon Springs" },
      { "@type": "City", "name": "Safety Harbor" },
      { "@type": "City", "name": "Dunedin" },
      { "@type": "City", "name": "Largo" },
      { "@type": "City", "name": "Seminole" },
      { "@type": "City", "name": "New Port Richey" },
      { "@type": "City", "name": "Trinity" },
      { "@type": "AdministrativeArea", "name": "Hillsborough County" },
      { "@type": "AdministrativeArea", "name": "Pinellas County" },
      { "@type": "AdministrativeArea", "name": "Pasco County" }
    ],
    "sameAs": [
      "https://www.facebook.com/share/1E27RD4hjZ/",
      "https://www.instagram.com/happyroofflorida",
      "https://www.tiktok.com/@happyrooffl",
      "https://share.google/eM5h7LtohVsqVd0Nd"
    ],
    "hasCredential": [
      "Florida Roofing Contractor License #CCC1337380",
      "Owens Corning Preferred Contractor",
      "BBB Accredited Business"
    ],
    "dateModified": "2026-10-05"
  },{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":"What areas does Happy Roof serve?","acceptedAnswer":{"@type":"Answer","text":"We serve all of Hillsborough, Pinellas, and Pasco counties. That includes Tampa, St. Petersburg, Clearwater, Brandon, Riverview, Wesley Chapel, Lutz, Land O' Lakes, Odessa, Temple Terrace, Oldsmar, Palm Harbor, Tarpon Springs, Safety Harbor, Dunedin, Largo, Seminole, New Port Richey, Trinity, and the communities around them."}},
      {"@type":"Question","name":"Are you licensed and insured?","acceptedAnswer":{"@type":"Answer","text":"Yes. Happy Roof LLC holds Florida Roofing Contractor License #CCC1337380 and carries full general liability and workers' compensation insurance. We're happy to provide a certificate of insurance on request."}},
      {"@type":"Question","name":"What roofing contractor certifications should I look for in Florida?","acceptedAnswer":{"@type":"Answer","text":"A legitimate contractor should have either a Certified Roofing Contractor license (CCC) or a Registered Roofing Contractor license (RC), both of which you can verify through the Florida DBPR at MyFloridaLicense.com. It's also usually in your best interest to ask for proof of insurance rather than just taking a contractor's word for it."}},
      {"@type":"Question","name":"How do I get a free estimate from Happy Roof?","acceptedAnswer":{"@type":"Answer","text":"Give us a call at 813-595-7663 or fill out our contact form. We'll schedule a free on-site inspection and get you a detailed, written estimate within 24 to 48 hours."}},
      {"@type":"Question","name":"How long has Happy Roof been in business?","acceptedAnswer":{"@type":"Answer","text":"Happy Roof was founded in 2025. We're a newer company, but our leadership team brings over 30 years of combined roofing experience to every job."}},
      {"@type":"Question","name":"Do you offer emergency roofing services?","acceptedAnswer":{"@type":"Answer","text":"Yes. If you have an active leak or storm damage, give us a call, and we'll get to you as fast as we can. We provide emergency tarping and temporary repairs throughout the Tampa Bay area."}},
      {"@type":"Question","name":"How much does a roof replacement cost in Tampa Bay?","acceptedAnswer":{"@type":"Answer","text":"Most residential replacements in Tampa Bay run between $8,000 and $25,000, depending on the size and pitch of your roof, the material you choose, and whether any structural repairs are needed."}},
      {"@type":"Question","name":"What is the best time of year to replace a roof in Tampa Bay?","acceptedAnswer":{"@type":"Answer","text":"Usually between October and May, since the weather tends to be a bit more predictable. That said, if your roof is actively leaking, don't feel like you have to wait for the ideal time. It's always better to deal with it before it gets worse."}},
      {"@type":"Question","name":"Do you offer military or first responder discounts?","acceptedAnswer":{"@type":"Answer","text":"Yes. We offer a $500 Heroes Discount on roof replacements and major repairs for veterans, active military, first responders, doctors, nurses, and teachers. Mention it when you call or use code HERO26 when you request an estimate online."}},
      {"@type":"Question","name":"How long does a roof replacement take?","acceptedAnswer":{"@type":"Answer","text":"Shingle replacements usually take one to three days. Metal roofs typically run three to five days. Tile can take five to seven days depending on the complexity of the job. Weather delays are possible during Florida's rainy season, but we'll do our best to plan around the forecast and keep you updated throughout."}},
      {"@type":"Question","name":"Do I need to be home during the roof replacement?","acceptedAnswer":{"@type":"Answer","text":"As long as we have access to your property and any gates, you don't need to be there. We'll keep you updated by phone or text and send photos when the job is done."}},
      {"@type":"Question","name":"Do you pull permits?","acceptedAnswer":{"@type":"Answer","text":"Yes. We'll handle all permit applications and coordinate the final building department inspection as part of every project at no extra charge."}},
      {"@type":"Question","name":"Will you remove and dispose of my old roof?","acceptedAnswer":{"@type":"Answer","text":"Always. Every replacement includes full tear-off, disposal of the old materials, and a cleanup of your property after we're done. We use magnetic nail sweepers to make sure nothing gets left behind in your yard or driveway."}},
      {"@type":"Question","name":"Can I stay in my home during a roof replacement?","acceptedAnswer":{"@type":"Answer","text":"Yes, most people do. The work happens entirely from the outside. You can typically expect some noise and vibration, but nothing so loud or jarring that you'll need to leave."}},
      {"@type":"Question","name":"What happens if it rains during my roof installation?","acceptedAnswer":{"@type":"Answer","text":"Our crew will be monitoring the weather and will never leave your roof exposed to the rain. If a storm comes on quickly, we'll install underlayment to protect our progress and pick it up again when the weather clears."}},
      {"@type":"Question","name":"Do I need a permit to replace my roof in Florida?","acceptedAnswer":{"@type":"Answer","text":"Yes. Florida law requires a building permit for all roof replacements. We'll handle the entire permitting process, so you don't have to deal with any of it."}},
      {"@type":"Question","name":"How do I choose between a roof repair and a full replacement?","acceptedAnswer":{"@type":"Answer","text":"Generally speaking, if your roof is under 15 years old and the damage is pretty contained to one area, a repair usually makes sense. If your roof is rapidly deteriorating or it has already been repaired multiple times without much luck, a replacement is going to be the more cost-effective choice in the long run."}},
      {"@type":"Question","name":"Do you remove the old roof or install over it?","acceptedAnswer":{"@type":"Answer","text":"We always do a full tear-off. Installing over old shingles hides existing damage and typically voids manufacturer warranty requirements. Starting with a clean deck is the only way to do it right."}},
      {"@type":"Question","name":"How quickly can you start on my project?","acceptedAnswer":{"@type":"Answer","text":"After your estimate is approved, most projects begin within one to three weeks depending on permit processing and material availability. Emergency storm damage repairs are prioritized and usually start within 24 to 48 hours."}},
      {"@type":"Question","name":"What roofing materials do you install?","acceptedAnswer":{"@type":"Answer","text":"We install Owens Corning and GAF shingles, standing seam and corrugated metal from Gulf Coast Supply, Verea clay and concrete tile, and flat roof systems including TPO, EPDM, and modified bitumen. We'll also work with other brands by request."}},
      {"@type":"Question","name":"What is the difference between 3-tab and architectural shingles?","acceptedAnswer":{"@type":"Answer","text":"Architectural shingles are more durable and wind resistant (up to 130 MPH) compared to basic 3-tab shingles. They also have a more dimensional appearance and come with better manufacturer warranties. 3-tab shingles aren't built for what we deal with here in Florida."}},
      {"@type":"Question","name":"Do you install metal roofs?","acceptedAnswer":{"@type":"Answer","text":"Yes. We install standing seam and corrugated metal in a pretty wide variety of colors and profiles. Metal roofs handle Florida's wind and UV extremely well and typically last upwards of 40 to 70 years."}},
      {"@type":"Question","name":"Can you match my existing tile if I need a repair?","acceptedAnswer":{"@type":"Answer","text":"Most of the time. We work with multiple tile suppliers and can usually source a matching or closely matching tile for repairs. We'll find the closest available option if your profile has been discontinued."}},
      {"@type":"Question","name":"Can you match my HOA requirements?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our team works with HOA guidelines regularly across Tampa Bay. We can help you select approved colors and materials and provide whatever documentation your HOA requires."}},
      {"@type":"Question","name":"What workmanship warranty does Happy Roof offer?","acceptedAnswer":{"@type":"Answer","text":"We provide up to a 15-year workmanship warranty on shingle, metal, and tile roof installations, and up to a 10-year workmanship warranty on flat roof systems, all backed in writing on every project. Most contractors in Tampa Bay offer one to five years."}},
      {"@type":"Question","name":"What do manufacturer warranties cover?","acceptedAnswer":{"@type":"Answer","text":"Manufacturer warranties cover defects in the roofing material itself, such as premature cracking or granule loss, that aren't the result of a storm or other external damage. We offer manufacturer warranties on all Owens Corning and GAF products we install."}},
      {"@type":"Question","name":"What isn't covered by the workmanship warranty?","acceptedAnswer":{"@type":"Answer","text":"Our workmanship warranty covers defects in how the roof was installed. It doesn't cover damage from hurricanes, storms, falling trees, or hail; modifications made by someone else after our work is done; lack of maintenance; or normal wear and tear over time. We'll fix things at no cost if something we installed fails under normal circumstances."}},
      {"@type":"Question","name":"How do I file a warranty claim with Happy Roof?","acceptedAnswer":{"@type":"Answer","text":"Call or email us. We'll inspect the issue, and if it's covered by our workmanship warranty, we'll fix it for free."}},
      {"@type":"Question","name":"Do you offer financing for roof replacements?","acceptedAnswer":{"@type":"Answer","text":"Yes. We partner with Service Finance, GreenSky, and Enhancify to offer flexible financing options, including low monthly payments and promotional 0% APR periods for qualified customers. See our financing page for more information."}},
      {"@type":"Question","name":"What credit score do I need to qualify for roof financing?","acceptedAnswer":{"@type":"Answer","text":"Our financing partners work with all kinds of credit profiles. The initial inquiry is a soft credit check that won't affect your score. The best way to find out what you qualify for is to apply."}},
      {"@type":"Question","name":"Can I finance a roof repair?","acceptedAnswer":{"@type":"Answer","text":"Financing is available for both replacements and larger repair projects. Minimum project amounts may apply depending on the financing partner."}},
      {"@type":"Question","name":"Do you help with insurance claims?","acceptedAnswer":{"@type":"Answer","text":"Yes. We can be there from the initial inspection all the way up to working directly with your adjuster. Our storm damage inspections are always free."}},
      {"@type":"Question","name":"How do I know if my roof has storm damage?","acceptedAnswer":{"@type":"Answer","text":"A lot of storm damage isn't visible from the ground, but common signs include missing or lifted shingles, dented metal flashing or vents, cracked tile, excessive granule buildup in your gutters, water stains on interior ceilings, and dented gutters or downspouts. Call us for a free inspection if you suspect your roof may have sustained damage during a recent storm."}},
      {"@type":"Question","name":"Should I file an insurance claim or pay out of pocket for roof damage?","acceptedAnswer":{"@type":"Answer","text":"It depends on the extent of the damage and your deductible. If the damage is widespread or covers a good portion of your roof, filing a claim probably makes the most sense. Otherwise, paying out of pocket might be more practical. Either way, we can inspect your roof and give you our opinion before you have to make a decision."}},
      {"@type":"Question","name":"Do you offer emergency tarping after storms?","acceptedAnswer":{"@type":"Answer","text":"Yes. If water is actively getting into your home after a storm, we can be there to tarp the roof and stop any damage from spreading while your claim is processed or your replacement gets scheduled."}},
      {"@type":"Question","name":"What is a wind mitigation inspection?","acceptedAnswer":{"@type":"Answer","text":"A wind mitigation inspection documents your roof's wind-resistance features for your insurance company. In Florida, this can help reduce your homeowner's insurance premium by up to several hundred dollars per year. We can coordinate this inspection after your new roof is installed."}},
      {"@type":"Question","name":"How much can I save on insurance with a new roof in Florida?","acceptedAnswer":{"@type":"Answer","text":"Many Tampa Bay homeowners report saving $500 to $2,000 or more per year after having a new roof installed, though this will depend on your insurer, home, and current policy."}},
      {"@type":"Question","name":"Can a new roof lower my energy bills in Tampa Bay?","acceptedAnswer":{"@type":"Answer","text":"Definitely. If your current roof is on the older side and absorbs a lot of heat, either a new roof with better ventilation or one made of more energy-efficient materials could help reduce your cooling costs year-round."}},
      {"@type":"Question","name":"Are there eco-friendly or sustainable roofing options?","acceptedAnswer":{"@type":"Answer","text":"Yes. Metal is considered to be one of the most sustainable roofing materials because it usually contains recycled material and tends to last for decades. There are also certain types of shingles that are designed to reflect heat if you're looking for something other than metal."}},
      {"@type":"Question","name":"Does Happy Roof install solar-ready roofing systems?","acceptedAnswer":{"@type":"Answer","text":"Yes. While we won't install the solar panels ourselves, we can coordinate with a local company before installing a roofing system that's ready for future solar panel installation."}},
      {"@type":"Question","name":"What is a cool roof?","acceptedAnswer":{"@type":"Answer","text":"Cool roofs are designed to absorb less heat from the sun, which can help keep your home cooler and take some of the strain off your air conditioning system. Metal, light-colored tile, and certain reflective shingles could qualify as cool roof materials."}},
      {"@type":"Question","name":"How should I prepare my roof for hurricane season in Tampa Bay?","acceptedAnswer":{"@type":"Answer","text":"Having someone come inspect your roof before the season begins is usually the best place to start. A professional inspection can catch loose shingles, damaged flashing, worn sealant, or other issues that could worsen in stormy weather. It's also a good time to make sure your gutters are clean and trim back any overhanging branches before summer arrives."}}
    ]
  },{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://happyroof.com/index.html"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://happyroof.com/faq.html"}]}]`;
---

<BaseLayout
  title="Roofing FAQs | Happy Roof"
  description="From warranties and financing to materials, insurance claims, and the roof replacement process, find honest answers to common roofing questions from Tampa Bay's trusted roofing contractor."
  canonical="https://happyroof.com/faq"
  ogTitle="Roofing FAQ | Happy Roof Tampa Bay"
  ogDescription="Honest answers to common roofing questions: warranties, financing, materials, insurance claims, and more. Serving Tampa Bay, FL."
  schema={schema}
>

<style is:inline>
/* FAQ */
    .cat-tab{padding:.55rem 1.2rem;border-radius:100px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background .18s,color .18s;border:1px solid #E0E0E0;background:#FFFFFF;color:#555555}
    .cat-tab:hover{background:#F7F7F7}
    .cat-tab.active{background:#E6A817;color:#1A1A1A;border-color:#E6A817}
    .faq-item{background:#FFFFFF;border:1px solid #E0E0E0;border-radius:12px;margin-bottom:.65rem;overflow:hidden;cursor:pointer;transition:border-color .2s}
    .faq-item:hover{border-color:rgba(230,168,23,.3)}
    .faq-q{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;gap:.75rem}
    .faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s ease;padding:0 1.25rem}
    .faq-item.open .faq-a{max-height:900px;padding:0 1.25rem 1.1rem}
    .faq-arr{transition:transform .25s ease;flex-shrink:0}
    .faq-item.open .faq-arr{transform:rotate(180deg)}
</style>

<section class="relative overflow-hidden" style="padding:8rem 0 5rem;background:#FFFFFF">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/architectural-shingle-roof-tampa-bay.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-5xl mx-auto px-5 text-center">
    <p class="sl mb-4" style="color:#E6A817">Honest Answers</p>
    <h1 class="font-display font-black tracking-tightest mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.5rem,6vw,5rem);line-height:.88;letter-spacing:-.01em;color:#1A1A1A">
      ROOFING FREQUENTLY<br/><span style="color:#E6A817">ASKED QUESTIONS.</span>
    </h1>
    <p style="color:#555555;font-size:1.05rem;line-height:1.75;max-width:620px;margin:0 auto 2.5rem">
      Whether you're dealing with a leak or trying to figure out what a full replacement involves, it's normal to have questions before getting started. Here are honest answers to the ones we hear most often from homeowners across the Tampa Bay area.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/contact" class="btn-p" style="font-size:1.1rem;padding:.9rem 2rem">Get a Free Estimate</a>
      <a href="tel:8135957663" class="btn-o call-tracking-number" style="font-size:1rem;padding:.85rem 1.8rem">Call (813) 595-7663</a>
    </div>
  </div>
</section>

<!-- ══════ CATEGORY FILTER + FAQ ACCORDIONS ══════ -->
<section style="background:#F7F7F7;padding:4rem 0 5rem">
  <div class="max-w-3xl mx-auto px-5">
    <!-- Category tabs -->
    <div class="flex flex-wrap gap-2 justify-center mb-10">
      <button class="cat-tab active" onclick="filterFaq('all',this)">All</button>
      <button class="cat-tab" onclick="filterFaq('general',this)">General</button>
      <button class="cat-tab" onclick="filterFaq('process',this)">Process</button>
      <button class="cat-tab" onclick="filterFaq('materials',this)">Materials</button>
      <button class="cat-tab" onclick="filterFaq('warranties',this)">Warranties</button>
      <button class="cat-tab" onclick="filterFaq('financing',this)">Financing</button>
      <button class="cat-tab" onclick="filterFaq('insurance',this)">Insurance &amp; Storm</button>
      <button class="cat-tab" onclick="filterFaq('energy',this)">Energy &amp; Sustainability</button>
    </div>

    <!-- GENERAL -->
    <div class="mb-8" data-cat="general">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#3B9FD9;margin-bottom:1rem">General</h2>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What areas does Happy Roof serve?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">We serve all of Hillsborough, Pinellas, and Pasco counties. That includes Tampa, St. Petersburg, Clearwater, Brandon, Riverview, Wesley Chapel, Lutz, Land O' Lakes, Odessa, Temple Terrace, Oldsmar, Palm Harbor, Tarpon Springs, Safety Harbor, Dunedin, Largo, Seminole, New Port Richey, Trinity, and the communities around them.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Are you licensed and insured?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes. Happy Roof LLC holds Florida Roofing Contractor License #CCC1337380 and carries full general liability and workers' compensation insurance. We're happy to provide a certificate of insurance on request.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What roofing contractor certifications should I look for in Florida?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">A legitimate contractor should have either a Certified Roofing Contractor license (CCC) or a Registered Roofing Contractor license (RC), both of which you can verify through the Florida DBPR at <a href="https://www.myfloridalicense.com" target="_blank" rel="noopener" style="color:#3B9FD9;text-decoration:none;font-weight:600">MyFloridaLicense.com</a>. It's also usually in your best interest to at least ask for proof of insurance rather than just taking a contractor's word for it.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How do I get a free estimate?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Give us a call at <a href="tel:8135957663" class="call-tracking-number" style="color:#3B9FD9;text-decoration:none;font-weight:600">(813) 595-7663</a> or <a href="/contact" style="color:#3B9FD9;text-decoration:none;font-weight:600">fill out our contact form</a>. We'll schedule a free on-site inspection and get you a detailed, written estimate within 24 to 48 hours.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How long have you been in business?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Happy Roof was founded in 2025. We're a newer company, but our leadership team brings over 30 years of combined roofing experience to every job.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you offer emergency roofing services?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">We do. If you have an active leak or storm damage, give us a call, and we'll get to you as fast as we can. We provide emergency tarping and temporary repairs throughout the Tampa Bay area.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How much does a roof replacement cost in Tampa Bay?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Most residential replacements in Tampa Bay run between $8,000 and $25,000, depending on the size and pitch of your roof, the material you choose, and whether any structural repairs are needed.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What is the best time of year to replace a roof in Tampa Bay?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Usually between October and May, since the weather tends to be a bit more predictable. That said, if your roof is actively leaking, don't feel like you have to wait for the "ideal" time. It's always better to deal with it before it gets worse.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you offer military or first responder discounts?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes. We offer a <strong>$500 Heroes Discount</strong> on roof replacements and major repairs for veterans, active military, first responders, doctors, nurses, and teachers. Mention it when you call or use code <strong>HERO26</strong> when you request an estimate online.</p></div></div>
    </div>

    <!-- PROCESS -->
    <div class="mb-8" data-cat="process">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#3B9FD9;margin-bottom:1rem">Process</h2>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How long does a roof replacement take?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Shingle replacements usually take one to three days. Metal roofs typically run three to five days. Tile can take five to seven days depending on the complexity of the job. Weather delays are possible during Florida's rainy season, but we'll do our best to plan around the forecast and keep you updated throughout.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do I need to be home during the roof replacement?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">As long as we have access to your property and any gates, you don't need to be there. We'll keep you updated by phone or text and send photos when the job is done.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you pull permits?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Absolutely. We'll handle all permit applications and coordinate the final building department inspection as part of every project at no extra charge.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Will you remove and dispose of my old roof?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Always. Every replacement includes full tear-off, disposal of the old materials, and a cleanup of your property after we're done. We use magnetic nail sweepers to make sure nothing gets left behind in your yard or driveway.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Can I stay in my home during a roof replacement?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes, most people do. The work happens entirely from the outside. You can typically expect some noise and vibration, but nothing so loud or jarring that you'll need to leave.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What happens if it rains during my roof installation?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Our crew will be monitoring the weather and will never leave your roof exposed to the rain. If a storm comes on quickly, we'll install underlayment to protect our progress and pick it up again when the weather clears.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do I need a permit to replace my roof in Florida?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes. Florida law requires a building permit for all roof replacements. We'll handle the entire permitting process, so you don't have to deal with any of it.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How do I choose between a repair and a full replacement?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Generally speaking, if your roof is under 15 years old and the damage is pretty contained to one area, a repair usually makes sense for the situation. If your roof is rapidly deteriorating or it has already been repaired multiple times without much luck, a replacement is going to be the more cost-effective choice in the long run.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you remove the old roof or install over it?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">We always do a full tear-off. Installing over old shingles hides existing damage and typically voids manufacturer warranty requirements. In our professional opinion, starting with a clean deck is the only way to do it.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How quickly can you start on my project?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">After your estimate is approved, most projects begin within one to three weeks depending on permit processing and material availability. Emergency storm damage repairs are prioritized and usually start within 24 to 48 hours.</p></div></div>
    </div>

    <!-- MATERIALS -->
    <div class="mb-8" data-cat="materials">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#3B9FD9;margin-bottom:1rem">Materials</h2>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What roofing materials do you install?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">We install Owens Corning and GAF shingles, standing seam and corrugated metal from Gulf Coast Supply, Verea clay and concrete tile, and flat roof systems including TPO, EPDM, and modified bitumen. We'll also work with other brands by request.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What is the difference between 3-tab and architectural shingles?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Architectural shingles are more durable and wind resistant (up to 130 MPH) compared to basic 3-tab shingles. They also have a more dimensional appearance and come with better manufacturer warranties. In general, 3-tab shingles aren't built for what we deal with here in Florida.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you install metal roofs?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">We install standing seam and corrugated metal in a pretty wide variety of colors and profiles. It's worth noting that metal roofs handle Florida's wind and UV extremely well and typically last upwards of 40 to 70 years.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Can you match my existing tile if I need a repair?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Most of the time. We work with multiple tile suppliers and can usually source a matching or closely matching tile for repairs. We'll find the closest available option if your profile has been discontinued.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Can you match my HOA requirements?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes. Our team works with HOA guidelines regularly across Tampa Bay. We can help you select approved colors and materials and provide whatever documentation your HOA requires.</p></div></div>
    </div>

    <!-- WARRANTIES -->
    <div class="mb-8" data-cat="warranties">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#3B9FD9;margin-bottom:1rem">Warranties</h2>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What warranty do you offer on workmanship?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">We provide up to a 15-year workmanship warranty on all shingle, metal, and tile roof installations, and up to a 10-year workmanship warranty on flat roof systems, all backed in writing on every project. Most contractors in Tampa Bay offer one to five years.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What do manufacturer warranties cover?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Manufacturer warranties cover defects in the roofing material itself, whether that's premature cracking or granule loss, that aren't the result of a storm or other external damage. We offer manufacturer warranties on all Owens Corning and GAF products we install.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What isn't covered by the workmanship warranty?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Our workmanship warranty covers defects in how the roof was installed. It doesn't cover damage from hurricanes, storms, falling trees, or hail; modifications made by someone else after our work is done; lack of maintenance; or normal wear and tear over time. We'll fix things at no cost if something we installed fails under normal circumstances.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How do I file a warranty claim?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Call or email us. We'll inspect the issue, and if it's covered by our workmanship warranty, we'll fix it for free.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How long is the warranty on a Happy Roof installation?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">The warranty covers up to 15 years for workmanship on shingle, metal, and tile roofs and up to 10 years for flat roof systems. That's on top of whatever manufacturer warranty applies to the materials.</p></div></div>
    </div>

    <!-- FINANCING -->
    <div class="mb-8" data-cat="financing">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#3B9FD9;margin-bottom:1rem">Financing</h2>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you offer financing for roof replacements?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">We partner with Service Finance, GreenSky, and Enhancify to offer flexible <a href="/finance" style="color:#3B9FD9;text-decoration:none;font-weight:600">financing options</a>, including low monthly payments and promotional 0% APR periods for qualified customers. Check out our financing page for more information.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What credit score do I need to qualify for financing?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Our financing partners work with all kinds of credit profiles. The initial inquiry is a soft credit check that won't affect your score. In short, the best way to find out what you qualify for is to apply.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Can I finance a roof repair?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Financing is available for both replacements and larger repair projects. Minimum project amounts may apply depending on the financing partner.</p></div></div>
    </div>

    <!-- INSURANCE -->
    <div class="mb-8" data-cat="insurance">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#3B9FD9;margin-bottom:1rem">Insurance &amp; Storm Repair</h2>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you help with insurance claims?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes. We can be there from the initial inspection all the way up to working directly with your adjuster. Our storm damage inspections are always free.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How do I know if my roof has storm damage?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">A lot of storm damage isn't visible from the ground, but several common signs include missing or lifted shingles, dented metal flashing or vents, cracked tile, excessive granule buildup in your gutters, water stains on interior ceilings, and dented gutters or downspouts. Call us for a free inspection if you suspect your roof may have sustained damage during a recent storm.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Should I file an insurance claim or pay out of pocket?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">It really depends on the extent of the damage and your deductible. If the damage is pretty widespread or it covers a good portion of your roof, then filing a claim would probably make the most sense. Otherwise, paying out of pocket might be more practical. Either way, we can inspect your roof and give you our opinion before you have to make a decision.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you offer emergency tarping after storms?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes. If water is actively getting into your home after a storm, we can be there to tarp the roof and stop any damage from spreading while your claim is processed or your replacement gets scheduled.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How do I know if my roof damage is covered by insurance?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">The easiest way to know is to schedule a free inspection with us. We'll document any damage and put together a report for your insurance company.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What is a wind mitigation inspection?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">A wind mitigation inspection documents your roof's wind-resistance features for your insurance company. In Florida, this can help to reduce your homeowner's insurance premium by up to several hundred dollars per year. We can coordinate this inspection after your new roof is installed.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How much can I save on insurance with a new roof in Florida?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Many Tampa Bay homeowners report saving $500 to $2,000 or more per year after having a new roof installed, though this will depend on your insurer, home, and current policy.</p></div></div>
    </div>

    <!-- ENERGY -->
    <div class="mb-8" data-cat="energy">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:.12em;text-transform:uppercase;color:#3B9FD9;margin-bottom:1rem">Energy &amp; Sustainability</h2>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Can a new roof lower my energy bills in Tampa Bay?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Definitely. If your current roof is on the older side and absorbs a lot of heat, either a new roof with better ventilation or one made of more energy-efficient materials could help reduce your cooling costs year-round.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Are there eco-friendly or sustainable roofing options?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Absolutely. Metal is considered to be one of the most sustainable roofing materials because it usually contains recycled material and tends to last for decades. There are also certain types of shingles that are designed to reflect heat if you're looking for something other than metal. See our <a href="/eco-friendly-roofing" style="color:#3B9FD9;text-decoration:none;font-weight:600">eco-friendly roofing</a> page for more.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">Do you install solar-ready roofing systems?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Yes. While we won't install the solar panels ourselves, we can coordinate with a local company before installing a roofing system that's ready for future solar panel installation.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">What is a cool roof?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Cool roofs are specifically designed to absorb less heat from the sun, which, in turn, can help keep your home cooler and take some of the strain off your air conditioning system. Anything from metal to light-colored tile or certain reflective shingles could qualify as cool roof materials.</p></div></div>
      <div class="faq-item" onclick="toggleFaq(this)"><div class="faq-q"><p class="font-medium text-sm" style="color:#1A1A1A">How should I prepare my roof for hurricane season in Tampa Bay?</p><svg class="faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem">Having someone come inspect your roof before the season begins is usually the best place to start. A professional inspection can help catch loose shingles, damaged flashing, worn sealant, or other issues that could worsen in stormy weather day after day. It's also probably a good time to make sure your gutters are clean and trim back any overhanging branches before summer arrives.</p></div></div>
    </div>

  </div>
</section>

<!-- CTA -->
<section class="cta-grad relative overflow-hidden py-20">
