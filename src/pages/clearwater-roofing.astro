---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{"@context":"https://schema.org","@type":["LocalBusiness","RoofingContractor"],"name":"Happy Roof LLC","url":"https://happyroof.com","telephone":"+1-813-595-7663","email":"info@happyroof.com","description":"Clearwater roofing contractor specializing in shingle, metal, and tile roof replacement. Licensed and insured. FL License #CCC1337380.","image":"/Brand%20Assets/Happy%20Roof%20Logo.jpeg","logo":"/Brand%20Assets/Happy%20Roof%20Logo.jpeg","address":{"@type":"PostalAddress","streetAddress":"141 Stevens Ave #12","addressLocality":"Oldsmar","addressRegion":"FL","postalCode":"34677","addressCountry":"US"},"areaServed":{"@type":"City","name":"Clearwater","containedInPlace":{"@type":"State","name":"Florida"}},"hasCredential":"Florida Roofing Contractor License #CCC1337380","dateModified":"2026-04-10"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {"@type":"Question","name":"What is the best roofing material for Clearwater homes?","acceptedAnswer":{"@type":"Answer","text":"It ultimately depends on where in Clearwater you are and what matters most to you. If you are on or near the Gulf, metal typically holds up to salt air better than any other option. For most inland Clearwater neighborhoods, architectural shingles rated for 130+ MPH winds would likely offer the best value. Either way, a member of our team can walk you through the tradeoffs for your home or commercial property."}},
    {"@type":"Question","name":"Does salt air actually affect roofs?","acceptedAnswer":{"@type":"Answer","text":"Yes. Salt air can speed up corrosion on metal fasteners and degrade sealant and adhesive products. The closer you are to the water, the more likely you will encounter these issues, which is why properties on Clearwater Beach and Sand Key generally need fasteners and flashing materials specifically rated for coastal exposure."}},
    {"@type":"Question","name":"How much do new roofs usually cost?","acceptedAnswer":{"@type":"Answer","text":"Most Clearwater residential replacements fall between $8,000 and $25,000 for an average-sized home, depending on material choice and whether any structural or decking work is needed. Coastal properties sometimes carry a modest premium for wind-mitigation and corrosion-resistant hardware. Either way, we provide a free, detailed written estimate so you know exactly what you are paying for before anything starts. Call (813) 595-7663."}},
    {"@type":"Question","name":"Do you handle building permits?","acceptedAnswer":{"@type":"Answer","text":"Yes. We take care of all permit applications with the City of Clearwater and Pinellas County Building Department and coordinate the final inspection. You do not need to contact any government office or track down an inspector yourself."}},
    {"@type":"Question","name":"How quickly can you start a project?","acceptedAnswer":{"@type":"Answer","text":"After your free inspection and estimate approval, most projects get underway within one to three weeks depending on permit processing and material availability. Storm damage repairs are prioritized and typically start within 24 to 48 hours."}},
    {"@type":"Question","name":"Is Happy Roof licensed to work in Clearwater?","acceptedAnswer":{"@type":"Answer","text":"Yes. Happy Roof LLC holds Florida Roofing Contractor License #CCC1337380 and is authorized to perform roofing work throughout all of Florida, including the City of Clearwater and Pinellas County. We carry full general liability and workers' compensation insurance."}}
  ]}]`;
---

<BaseLayout
  title="Clearwater Roofing Contractor | Happy Roof"
  description="Whether your roof needs repairs or a replacement, our Clearwater roofing contractors provide residential and commercial services. Contact us today!"
  canonical="https://happyroof.com/clearwater-roofing"
  ogTitle="Clearwater Roofing Contractor | Happy Roof"
  ogDescription="Licensed Clearwater roofer for replacements, repairs & storm damage. Free estimates.  Call (813) 595-7663."
  schema={schema}
>

<style is:inline>
.check-dot{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);flex-shrink:0;margin-top:.15rem}
    .step-num{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.25rem;color:#E6A817;flex-shrink:0}
</style>

<section class="pt-32 pb-20 relative overflow-hidden" style="background:#F5F5F5;border-bottom:1px solid #E5E5E5">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/standing-seam-metal-roof-tampa.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-5 text-center">
    <p class="sl gp mb-4">Clearwater Roofing</p>
    <h1 class="font-display font-black tracking-tightest mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:.92;letter-spacing:-.01em;color:#1A1A1A">
      CLEARWATER ROOFING CONTRACTOR<br/><span class="gt">LICENSED & INSURED</span>
    </h1>
    <p class="max-w-2xl mx-auto" style="color:#555555;font-size:1.05rem;line-height:1.75">
      Clearwater homeowners rely on Happy Roof for expert roof replacement, repair, and installation. As a licensed and insured roofing contractor, we build roofing systems designed to protect against Gulf Coast salt air, tropical storms, and Florida's relentless sun, backed by our up to 15-year workmanship warranty.
    </p>
    <div class="flex flex-wrap gap-3 justify-center mt-8">
      <a href="/contact" class="btn-t">Get a Free Estimate <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      <a href="tel:8135957663" class="btn-o call-tracking-number">Call (813) 595-7663</a>
    </div>
  </div>
</section>

<div style="background:#FFFFFF;border-top:2px solid #E6A817;border-bottom:1px solid #E0E0E0;padding:.85rem 0">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-display font-bold text-sm tracking-widest" style="color:#1A1A1A;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif">
      <span>Clearwater, FL</span><span style="color:#E6A817">·</span><span>CCC1337380</span><span style="color:#E6A817">·</span><span>HappyRoof.com</span><span style="color:#E6A817">·</span><span style="color:#3B9FD9">(813) 595-7663</span>
    </div>
  </div>
</div>

<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-4xl mx-auto px-5 text-center">
    <p class="sl gt mb-3">About Happy Roof</p>
    <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.5rem">FLORIDA'S FIRST-RATE ROOFING PROFESSIONALS</h2>
    <p style="color:#555555;font-size:1.05rem;line-height:1.75">
      From repairs and inspections to full replacements and storm restoration, we offer roofing services designed for Florida's Gulf Coast climate. Our team has helped homeowners across Clearwater and upper Pinellas County understand what their roofs actually need, backed by decades of combined roofing experience. Learn more about our services below.
    </p>
  </div>
</section>

<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <p class="sl gt mb-3">Why Happy Roof in Clearwater</p>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.5rem">WHY CLEARWATER HOMEOWNERS CHOOSE HAPPY ROOF</h2>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          We've been working in Pinellas County long enough to know the difference between what a beach property needs and what an inland Clearwater home needs, and we don't treat them the same. Every estimate we give is written and itemized before anything starts. We're not going to recommend more work than your roof actually needs, and you'll have your warranty paperwork in hand before we leave.
        </p>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          We follow up at 30 days and one year because we want to know the roof is holding up the way it should. If something comes up in between, let us know. As an Owens Corning Preferred Contractor holding Florida Roofing Contractor License #CCC1337380, we back every Clearwater installation with an up to 15-year workmanship warranty in writing.
        </p>
      </div>
      <div class="space-y-4">
        <div class="scard p-6"><div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Owens Corning Installer</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We install premium Owens Corning roofing systems with manufacturer warranties on all products.</p></div></div></div>
        <div class="scard p-6"><div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Up to 15-Year Workmanship Warranty</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Every Clearwater roof installation includes a written up to 15-year workmanship warranty. No exceptions.</p></div></div></div>
        <div class="scard p-6"><div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">City of Clearwater Permits Handled</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We manage all permit applications and coordinate inspections with the City of Clearwater and Pinellas County.</p></div></div></div>
      </div>
    </div>
  </div>
</section>

<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">Our Services</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">OUR ROOFING SERVICES</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Roof Replacement</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">If your roof has reached the end of its life or it's taken on enough storm damage that repairs no longer make sense, we'll handle the full replacement from tear-off through county inspection. Choose from Owens Corning Duration shingles, standing seam metal, or concrete and clay tile, all installed to manufacturer specifications.</p>
      </div>
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Roof Repair</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">Whether it's a leak or a few lifted shingles after a storm, we'll find what's actually causing the issue and fix that. If a repair is what your roof needs, that's what we'll recommend, no upsell to a full replacement when a targeted repair will solve the problem.</p>
      </div>
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Storm Damage</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">Clearwater's position on the Gulf makes it more directly exposed to tropical systems than most of Tampa Bay. We provide damage assessments and can be on-site during the insurance adjuster inspection to make sure the full scope of damage gets captured. We work with all major Florida insurers.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">How It Works</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">OUR 4-STEP PROCESS</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="scard p-8 flex gap-5"><div class="step-num">1</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Free Inspection and Estimate</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">We'll carefully inspect every part of your roof, from the decking and underlayment to the flashing around transition points and the ventilation system. After the inspection, you'll receive a detailed written estimate outlining your material options, project timeline, and pricing.</p></div></div>
      <div class="scard p-8 flex gap-5"><div class="step-num">2</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Material Selection and Permits</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">Once you're ready to move forward, we'll help you choose the best material and color for your home or building. We'll also handle all required permits through the City of Clearwater or the Pinellas County Building Department and order your materials directly from the manufacturer. You'll also be able to choose the start date.</p></div></div>
      <div class="scard p-8 flex gap-5"><div class="step-num">3</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Professional Installation</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">Our licensed and insured crew manages the entire project from start to finish. While doing so, we'll take care to protect your landscaping and surrounding property throughout the job. We'll also walk around the grounds and make sure everything's cleaned up before we leave.</p></div></div>
      <div class="scard p-8 flex gap-5"><div class="step-num">4</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Final Inspection and Warranty</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">We'll coordinate the final county inspection and confirm everything meets code requirements. Then, we'll provide your workmanship warranty and manufacturer warranty in writing, and follow up with you after 30 days and again in one year.</p></div></div>
    </div>
  </div>
</section>

<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-10">
      <p class="sl gt mb-3">Clearwater Service Area</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1rem">NEIGHBORHOODS WE SERVE IN CLEARWATER</h2>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:700px;margin:0 auto">Happy Roof provides roofing services throughout Clearwater and all of upper Pinellas County. Clearwater Beach and Sand Key properties face constant salt spray that tests every fastener and sealant, requiring marine-grade materials and experienced installation. Harbor Oaks and Countryside homes benefit from impact-resistant shingles that can lower insurance premiums. The established neighborhoods near Clearwater Marine Aquarium and along the Courtney Campbell Causeway each present unique roofing needs that our local crews understand.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 max-w-4xl mx-auto">
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Clearwater Beach</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Sand Key</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Island Estates</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Harbor Oaks</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Countryside</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Clearwater East</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Belleair</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Belleair Bluffs</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Dunedin</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Safety Harbor</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Oldsmar</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Palm Harbor</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Largo</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Seminole</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Indian Rocks Beach</span>
    </div>
  </div>
</section>

<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-3xl mx-auto px-5">
    <div class="text-center mb-12">
      <p class="sl gt mb-3">Common Questions</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">FREQUENTLY ASKED QUESTIONS</h2>
    </div>
    <div class="faq-item"><button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">What is the best roofing material for Clearwater homes?<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer-inner">It ultimately depends on where in Clearwater you are and what matters most to you. If you're on or near the Gulf, metal typically holds up to salt air better than any other option. For most inland Clearwater neighborhoods, architectural shingles rated for 130+ MPH winds would likely offer the best value. Either way, a member of our team can walk you through the tradeoffs for your home or commercial property.</div></div></div>
    <div class="faq-item"><button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">Does salt air actually affect roofs?<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer-inner">Yes. Salt air can speed up corrosion on metal fasteners and degrade sealant and adhesive products. The closer you are to the water, the more likely you'll encounter these issues, which is why properties on Clearwater Beach and Sand Key generally need fasteners and flashing materials specifically rated for coastal exposure.</div></div></div>
    <div class="faq-item"><button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">How much do new roofs usually cost?<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer-inner">Most Clearwater residential replacements fall between $8,000 and $25,000 for an average-sized home, depending on material choice and whether any structural or decking work is needed. Coastal properties sometimes carry a modest premium for wind-mitigation and corrosion-resistant hardware. Either way, we'll provide a free, detailed written estimate so you know exactly what you're paying for before anything starts. Call <a href="tel:8135957663" class="call-tracking-number" style="color:#3B9FD9;text-decoration:none;font-weight:600">(813) 595-7663</a> for a free estimate.</div></div></div>
    <div class="faq-item"><button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">Do you handle building permits?<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer-inner">Yes. We'll take care of all permit applications with the City of Clearwater and Pinellas County Building Department and coordinate the final inspection. You don't need to contact any government office or track down an inspector yourself.</div></div></div>
    <div class="faq-item"><button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">How quickly can you start a project?<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer-inner">After your free inspection and estimate approval, most of our projects get underway within one to three weeks depending on permit processing and material availability. Storm damage repairs are prioritized and typically start within 24 to 48 hours.</div></div></div>
    <div class="faq-item"><button class="faq-btn" aria-expanded="false" onclick="this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');this.nextElementSibling.classList.toggle('open')">Is Happy Roof licensed to work in Clearwater?<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button><div class="faq-answer"><div class="faq-answer-inner">Yes. Happy Roof LLC holds Florida Roofing Contractor License #CCC1337380 and is authorized to work throughout all of Florida, including the City of Clearwater and Pinellas County. We carry full general liability and workers' compensation insurance, with certificates available on request.</div></div></div>
  </div>
</section>

<section class="cta-grad relative overflow-hidden py-20">
  <div class="relative z-10 max-w-3xl mx-auto px-5 text-center">
