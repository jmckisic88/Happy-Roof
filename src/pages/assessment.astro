// Downscale + recompress an uploaded photo to stay well under Vercel's 4.5 MB
// request-body ceiling. The OpenAI edit endpoint only accepts 1024x1024, so
// anything larger is wasted bytes. We target 1600px max dimension at JPEG 0.85
// (typical output ~350-700 KB, ~470-930 KB as base64) which leaves plenty of
// headroom for the rest of the JSON payload.
function finalizeUploadedPhoto(dataUrl) {
  uploadedImageData = dataUrl;
  lastOriginalImageUrl = dataUrl;
  document.getElementById('viz-original').src = dataUrl;
  document.getElementById('viz-source-label').innerHTML = 'Your <b>uploaded</b> photo';
  document.getElementById('viz-streetview').style.display = 'block';
  document.getElementById('viz-style-picker').style.display = 'block';
  streetViewLoaded = true;
  updateUploadAffordance('uploaded');
  updateColorUI();
}

function resizeAndEncode(source, maxDim) {
  var w = source.width || source.naturalWidth;
  var h = source.height || source.naturalHeight;
  if (!w || !h) throw new Error('Could not read image dimensions.');
  var scale = Math.min(1, maxDim / Math.max(w, h));
  var dw = Math.max(1, Math.round(w * scale));
  var dh = Math.max(1, Math.round(h * scale));
  var canvas = document.createElement('canvas');
  canvas.width = dw;
  canvas.height = dh;
  var ctx = canvas.getContext('2d');
  ctx.drawImage(source, 0, 0, dw, dh);
  return canvas.toDataURL('image/jpeg', 0.85);
}

function handleFileUpload(input) {
  var file = input.files[0];
  if (!file) return;
  if (!validateYourInfo()) { input.value = ''; return; }
  // Soft cap at 20 MB raw. We resize client-side anyway, so this is just a
  // sanity ceiling for truly absurd files.
  if (file.size > 20 * 1024 * 1024) { alert('Image must be under 20MB.'); input.value = ''; return; }

  var MAX = 1600;

  // Preferred path: createImageBitmap with imageOrientation 'from-image' honors
  // the EXIF Orientation tag so phone portrait photos render upright even in
  // browsers where canvas.drawImage of an <img> ignores EXIF. Falls back to the
  // classic FileReader + <img> path on engines that lack ImageBitmap support.
  if (typeof createImageBitmap === 'function') {
    createImageBitmap(file, { imageOrientation: 'from-image' })
      .then(function(bmp) {
        try {
          var dataUrl = resizeAndEncode(bmp, MAX);
          finalizeUploadedPhoto(dataUrl);
        } finally {
          if (typeof bmp.close === 'function') bmp.close();
        }
      })
      .catch(function() {
        // createImageBitmap failed (HEIC on non-Safari, corrupt file, etc.) —
        // try the <img> fallback. If that also fails we surface a clean error.
        legacyImgDecode(file, MAX);
      });
  } else {
    legacyImgDecode(file, MAX);
  }
}

function legacyImgDecode(file, maxDim) {
  var reader = new FileReader();
  reader.onload = function(e) {
    var img = new Image();
    img.onload = function() {
      try {
        var dataUrl = resizeAndEncode(img, maxDim);
        finalizeUploadedPhoto(dataUrl);
      } catch (err) {
        console.error('[roof-viz] resize failed:', err);
        alert('We could not process that photo. Please try a JPG or PNG, or let us use the Google Street View photo instead.');
      }
    };
    img.onerror = function() {
      alert('We could not read that photo. HEIC/HEIF files are not supported in every browser. Please export as JPEG and try again, or let us use the Google Street View photo instead.');
    };
    img.src = e.target.result;
  };
  reader.onerror = function() { alert('We could not read that photo. Please try a different file.'); };
  reader.readAsDataURL(file);
}

