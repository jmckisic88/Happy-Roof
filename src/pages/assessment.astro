function getGenerationCount() {
  try {
    var data = JSON.parse(localStorage.getItem('hr_viz_gens') || '{}');
    var now = Date.now();
    // Reset if older than 24 hours
    if (data.timestamp && (now - data.timestamp) > 86400000) {
      localStorage.removeItem('hr_viz_gens');
      return 0;
    }
    return data.count || 0;
  } catch(e) { return 0; }
}

function incrementGenerationCount() {
  try {
    var data = JSON.parse(localStorage.getItem('hr_viz_gens') || '{}');
    data.count = (data.count || 0) + 1;
    if (!data.timestamp) data.timestamp = Date.now();
    localStorage.setItem('hr_viz_gens', JSON.stringify(data));
  } catch(e) {}
}

function generateVisualization() {
  if (!streetViewLoaded) { alert('Load a photo of your home first. Click Find My Home, or upload a photo of the house.'); return; }
  if (!selectedColors.length) { alert('Pick at least one color.'); return; }
  if (!validateYourInfo()) return;

  // Validate metal profile BEFORE flipping the UI into loading state so the
  // early-return cannot leave the spinner stuck on screen.
  var roofStyle = 'architectural shingle';
  if (currentRoofType === 'metal') {
    if (!currentMetalProfile) { alert('Pick a metal profile (5V Crimp or Standing Seam) first.'); return; }
    roofStyle = METAL_PROFILES[currentMetalProfile].prompt;
  }

  var genCount = getGenerationCount();
  if (genCount >= 3) {
    var msg = document.getElementById('viz-limit-msg');
    msg.textContent = 'You\'ve used all 3 comparisons today. Come back tomorrow or call us at (813) 595-7663 for a free in-person consultation.';
    msg.style.display = 'block';
    return;
  }

  var address = document.getElementById('viz-address').value.trim();
  var btn = document.getElementById('viz-generate-btn');
  var lbl = document.getElementById('viz-generate-label');

  document.getElementById('viz-loading').style.display = 'flex';
  document.getElementById('viz-result').style.display = 'none';
  document.getElementById('viz-style-picker').style.display = 'none';
  btn.disabled = true;
  if (lbl) lbl.textContent = 'Generating ' + selectedColors.length + ' preview' + (selectedColors.length === 1 ? '' : 's') + '...';

  // Fire-and-forget lead capture to Breeze \u2014 Josh gets the name+address even without email/phone
  captureVisualizerLead();

  // Build the lead payload that the server also emails directly on success
  var leadPayload = {
    first_name: (document.getElementById('viz-firstname').value || '').trim(),
    last_name: (document.getElementById('viz-lastname').value || '').trim(),
    address: address,
    email: ((document.getElementById('viz-email') || {}).value || '').trim(),
    phone: ((document.getElementById('viz-phone') || {}).value || '').trim()
  };

  var payload = {
    roofStyle: roofStyle,
    colors: selectedColors.map(function(c) { return { name: c.name, hex: c.hex }; }),
    lead: leadPayload,
    source: '/assessment?tab=viz'
  };
  if (uploadedImageData) {
    payload.uploadedImage = uploadedImageData;
  } else {
    payload.address = address;
  }

  function resetChrome() {
    document.getElementById('viz-loading').style.display = 'none';
    document.getElementById('viz-style-picker').style.display = 'block';
    updateColorUI();
  }

  // AbortController so a stalled connection fails gracefully instead of hanging
  // forever. 100s matches the server's 120s maxDuration with a 20s buffer.
  var ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
  var abortTimer = ctrl ? setTimeout(function() { ctrl.abort(); }, 100000) : null;

  fetch('/api/roof-visualizer', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
    signal: ctrl ? ctrl.signal : undefined
  })
  // Pull the body as text first so a non-JSON error page (Vercel 413 / 504 /
  // deployment-protection challenge) does not poison the chain with a
  // SyntaxError that lands in the generic .catch.
  .then(function(r) {
    return r.text().then(function(txt) {
      var data;
      try { data = txt ? JSON.parse(txt) : {}; }
      catch (e) { data = { _raw: (txt || '').slice(0, 400), _parseError: true }; }
      return { status: r.status, ok: r.ok, data: data };
    });
  })
  .then(function(resp) {
    if (abortTimer) clearTimeout(abortTimer);
    resetChrome();
    var data = resp.data;

    // 413 = Vercel edge rejected the body as too large (usually a huge uploaded photo).
    if (resp.status === 413) {
      console.error('[roof-viz] 413 payload too large', resp);
      alert('That photo is too large to upload. Please choose a smaller image (ideally under ~3 MB raw) or let us use the Google Street View photo instead.');
      return;
    }
    // 504 = Vercel function timeout (OpenAI took too long across all 4 colors).
    if (resp.status === 504 || (data && /timeout|FUNCTION_INVOCATION_TIMEOUT/i.test(data.error || data._raw || ''))) {
      console.error('[roof-viz] 504 timeout', resp);
      alert('The preview generator took too long this time. Please try again in a moment, or call us at (813) 595-7663.');
      return;
    }

    if (data.success && data.generatedImages && data.generatedImages.length) {
      incrementGenerationCount();
      compositeComparisonGrid(data.generatedImages, selectedColors);
      var remaining = 3 - getGenerationCount();
      document.getElementById('viz-style-label').textContent = remaining > 0
        ? remaining + ' comparison' + (remaining === 1 ? '' : 's') + ' remaining today'
        : 'No more comparisons today. Call us at (813) 595-7663 for an in-person review.';
      document.getElementById('viz-result').style.display = 'block';
      updateCostEstimate();
      document.getElementById('viz-result').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }

    if (data.noStreetView) {
      // Upload area is already visible. Reinforce it and pulse the dropzone.
      updateUploadAffordance('initial');
      var dz = document.getElementById('viz-upload-area');
      if (dz) { dz.style.background = '#FFF8E6'; setTimeout(function(){ dz.style.background = '#FAFAFA'; }, 1800); }
      alert('Google does not have a street-level photo for this address. Upload a photo of the home using the box below and we will generate from that.');
      return;
    }
    if (data.verificationUrl) {
      // Model-access / verification failure. Show the owner-facing hint prominently.
      var vhint = (data.hint ? '\n\n' + data.hint : '') + '\n\nVerification URL: ' + data.verificationUrl;
      alert('We could not generate the roof previews right now. ' + (data.error || '') + vhint + '\n\nEveryone else: please try again shortly or call us at (813) 595-7663 and we will walk you through colors over the phone.');
      console.error('[roof-viz] model/verification failure:', resp);
      return;
    }

    // Generic server-side failure. Surface whatever details we have.
    var detail = (data && data.details) ? '\n\nDetails: ' + data.details : '';
    var firstFail = (data && data.failures && data.failures[0]) ? '\n\nFirst failure: ' + data.failures[0].error : '';
    var statusTag = (!resp.ok && resp.status) ? ' (HTTP ' + resp.status + ')' : '';
    alert('We could not generate a comparison' + statusTag + '. ' + (data.error || 'Please try again.') + detail + firstFail);
    console.error('[roof-viz] generation failed:', resp);
  })
  .catch(function(err) {
    if (abortTimer) clearTimeout(abortTimer);
    resetChrome();
    console.error('[roof-viz] network/abort failure:', err);
    var isAbort = err && (err.name === 'AbortError' || /aborted/i.test(err.message || ''));
    alert(isAbort
      ? 'The request took too long and was cancelled. Please try again or call us at (813) 595-7663.'
      : 'Could not reach the preview service. Check your connection and try again, or call us at (813) 595-7663.');
  });
}

function compositeComparisonGrid(images, colors) {
  var canvas = document.getElementById('viz-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var count = images.length;
  var cols = count >= 2 ? 2 : 1;
  var rows = Math.ceil(count / cols);
  var firstImg = new Image();
  firstImg.crossOrigin = 'anonymous';
  firstImg.onload = function() {
    var w = firstImg.naturalWidth;
    var h = firstImg.naturalHeight;
    var header = 80;
    var labelH = 54;
    var tileH = h + labelH;
    canvas.width = w * cols;
    canvas.height = header + tileH * rows;

    // Header band
    ctx.fillStyle = '#1A1A1A';
    ctx.fillRect(0, 0, canvas.width, header);
    ctx.fillStyle = '#FFFFFF';
    ctx.font = '800 32px "Barlow Condensed", Arial, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('ROOFING COLOR COMPARISON', canvas.width/2, header/2 - 10);
    ctx.fillStyle = 'rgba(255,255,255,0.65)';
    ctx.font = '600 14px "Barlow Condensed", Arial, sans-serif';
    ctx.fillText('YOUR HOME  |  ' + count + ' SHINGLE OPTION' + (count === 1 ? '' : 'S') + '  |  HAPPYROOF.COM', canvas.width/2, header/2 + 16);

    images.forEach(function(src, i) {
      var r = Math.floor(i / cols);
      var c = i % cols;
      var x = c * w;
      var y = header + r * tileH;
      var img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = function() {
        ctx.drawImage(img, x, y, w, h);
        ctx.fillStyle = '#1A1A1A';
        ctx.fillRect(x, y + h, w, labelH);
        ctx.fillStyle = 'rgba(255,255,255,0.6)';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.font = '600 12px "Barlow Condensed", Arial, sans-serif';
        ctx.fillText('OPTION ' + (i + 1), x + 18, y + h + 16);
        ctx.fillStyle = '#FFFFFF';
        ctx.font = '800 22px "Barlow Condensed", Arial, sans-serif';
        ctx.fillText(colors[i].name, x + 18, y + h + 36);
        // Swatch chip
        ctx.fillStyle = colors[i].hex;
        ctx.beginPath();
        ctx.arc(x + w - 28, y + h + 26, 12, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.lineWidth = 1;
        ctx.stroke();
      };
      img.onerror = function() { /* ignore tile load failure */ };
      img.src = src;
    });
  };
  firstImg.onerror = function() { alert('Preview images did not load. Please try again.'); };
  firstImg.src = images[0];
}

function downloadComparison() {
  var canvas = document.getElementById('viz-canvas');
  if (!canvas || !canvas.width) return;
  canvas.toBlob(function(blob) {
    if (!blob) return;
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'happy-roof-color-comparison.png';
    document.body.appendChild(a);
    a.click();
    setTimeout(function() {
      URL.revokeObjectURL(url);
      if (a.parentNode) a.parentNode.removeChild(a);
    }, 200);
  }, 'image/png');
}

