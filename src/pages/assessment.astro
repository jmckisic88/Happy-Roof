<script is:inline>
// ── Assessment Quiz Logic ──
var currentStep = 1;
var totalSteps = 8;

function selectOption(el, step) {
  el.closest('.assess-step').querySelectorAll('.assess-option').forEach(function(o) { o.classList.remove('selected'); });
  el.classList.add('selected');
  el.querySelector('input').checked = true;
  document.getElementById('btn-next').style.opacity = '1';
  document.getElementById('btn-next').style.pointerEvents = 'auto';
  // Auto-advance after a short delay
  setTimeout(function() { nextStep(); }, 400);
}

function toggleCheck(el) {
  var input = el.querySelector('input');
  var svg = el.querySelector('svg');
  el.classList.toggle('selected');
  input.checked = !input.checked;
  svg.style.display = input.checked ? 'block' : 'none';
  // If "none" is selected, deselect others
  if (input.value === 'none' && input.checked) {
    el.closest('.assess-step').querySelectorAll('.assess-check').forEach(function(c) {
      if (c !== el) { c.classList.remove('selected'); c.querySelector('input').checked = false; c.querySelector('svg').style.display = 'none'; }
    });
  } else if (input.value !== 'none' && input.checked) {
    var noneCheck = el.closest('.assess-step').querySelector('input[value="none"]');
    if (noneCheck && noneCheck.checked) { noneCheck.checked = false; noneCheck.closest('.assess-check').classList.remove('selected'); noneCheck.closest('.assess-check').querySelector('svg').style.display = 'none'; }
  }
  // Enable next button if any checked
  var anyChecked = el.closest('.assess-step').querySelectorAll('input:checked').length > 0;
  document.getElementById('btn-next').style.opacity = anyChecked ? '1' : '.4';
  document.getElementById('btn-next').style.pointerEvents = anyChecked ? 'auto' : 'none';
}

function nextStep() {
  if (currentStep >= totalSteps) { showResults(); return; }
  document.getElementById('step-' + currentStep).classList.remove('active');
  currentStep++;
  document.getElementById('step-' + currentStep).classList.add('active');
  updateProgress();
  document.getElementById('btn-back').style.display = 'inline-block';
  // Reset next button state
  var stepEl = document.getElementById('step-' + currentStep);
  var hasSelection = stepEl.querySelector('input:checked');
  document.getElementById('btn-next').style.opacity = hasSelection ? '1' : '.4';
  document.getElementById('btn-next').style.pointerEvents = hasSelection ? 'auto' : 'none';
  document.getElementById('btn-next').textContent = currentStep === totalSteps ? 'See Results' : 'Next →';
  window.scrollTo({ top: document.getElementById('quiz').offsetTop - 100, behavior: 'smooth' });
}

function prevStep() {
  if (currentStep <= 1) return;
  document.getElementById('step-' + currentStep).classList.remove('active');
  currentStep--;
  document.getElementById('step-' + currentStep).classList.add('active');
  updateProgress();
  if (currentStep === 1) document.getElementById('btn-back').style.display = 'none';
  document.getElementById('btn-next').style.opacity = '1';
  document.getElementById('btn-next').style.pointerEvents = 'auto';
  document.getElementById('btn-next').textContent = 'Next →';
}

function updateProgress() {
  var pct = ((currentStep - 1) / totalSteps) * 100;
  document.getElementById('progress-fill').style.width = pct + '%';
}

// ── GoNano + legacy score result variants ──
// Decision tree layering on top of the existing 4-tier score model:
//   - Hard overrides (structural failure / storm / insurance-driven) → Replace.
//   - Non-shingle paths fall through to the legacy score-based tiers.
//   - Shingle roofs branch by age, then budget punt can override 15+ to a GoNano bridge.
// Fortify pitch copy ships live for Josh to review in prod.

var RESULT_VARIANTS = {
  'urgent': { title: 'YOUR ROOF NEEDS IMMEDIATE ATTENTION', color: '#dc2626', icon: '⚠️', cls: 'result-urgent', desc: 'Based on your answers, your roof is showing serious warning signs. We strongly recommend scheduling a professional inspection as soon as possible to prevent further damage to your home.', tip: "Don't wait. Water damage from a failing roof can lead to mold, structural issues, and significantly higher repair costs." },
  'soon': { title: 'REPLACEMENT RECOMMENDED SOON', color: '#E6A817', icon: '🔶', cls: 'result-soon', desc: 'Your roof is aging and showing some signs of wear. While it may not be an emergency today, planning for a replacement in the near future will save you money and protect your home.', tip: 'Getting ahead of a roof replacement lets you choose materials and timing on your terms, rather than being forced into an emergency repair.' },
  'maintain': { title: 'INSPECTION RECOMMENDED', color: '#3B9FD9', icon: '🔍', cls: 'result-maintain', desc: "Your roof appears to be in decent shape, but a professional inspection can catch issues that aren't visible from the ground. A small repair now can prevent a costly replacement later.", tip: "Annual inspections are the best way to extend your roof's lifespan. Most homeowners in Tampa Bay should inspect after every major storm." },
  'good': { title: 'YOUR ROOF IS GOOD. NOW IS THE TIME TO LOCK IT IN.', color: '#8B6914', icon: '🛡️', cls: 'result-gonano', desc: 'Your answers tell us your roof is in strong shape today. That is exactly the window where GoNano NuRoof is at its most powerful. A Structural Roof Rejuvenation treatment applied now locks in the current condition of your roof, earns you the longest warranty tier we offer, and typically pushes the replacement conversation out 10 to 15 years. Protecting a healthy roof always costs less than fixing one that failed.', tip: 'Free GoNano consultation. We walk the roof with you, show you the warranty options side by side, and give you honest numbers. No obligation, no pressure.' },

  'insurance-replace': { title: 'FULL REPLACEMENT RECOMMENDED', color: '#dc2626', icon: '🛡️', cls: 'result-urgent', desc: 'Insurance-driven replacements and storm-damage claims need a new roof system, not a rejuvenation. A full replacement resets your warranty, restores insurability, and gives us the documentation your carrier will ask for.', tip: 'Bring us your carrier letter and photos. We handle the inspection, scope, and supplement conversation so you don\'t end up underpaid on the claim.' },
  'structural-replace': { title: 'FULL REPLACEMENT RECOMMENDED', color: '#dc2626', icon: '⚠️', cls: 'result-urgent', desc: 'Active leaks, sagging, or daylight through the deck are structural problems that a rejuvenation treatment cannot address. The safe path is a full tear-off and new roof system so we can inspect the deck, replace any rot, and start the warranty clock over.', tip: 'Move fast. Every rain event compounds interior damage and drywall, insulation, and framing repairs quickly outrun the cost of the roof itself.' },

  'gonano-fortify': { title: 'LOCK IN YOUR ROOF WITH GONANO FORTIFY', color: '#8B6914', icon: '🌱', cls: 'result-gonano', desc: 'Your roof is still young, which means you are in the ideal window for GoNano NuRoof Fortify. Fortify is our top-tier Structural Roof Rejuvenation treatment, and because your shingles still have their original integrity, we can apply it now and lock in the current condition of your roof for the longest warranty we offer.', tip: 'Fortify at year 0-5 is the smartest preventative play in roofing. You get a renewable 15-year warranty, you protect the roof you already paid for, and you push the replacement conversation out by a decade or more.' },
  'gonano-dual': { title: 'YOU HAVE TWO SOLID OPTIONS', color: '#8B6914', icon: '🔀', cls: 'result-dual', desc: 'Your roof is in that middle window where either path works. The right call usually comes down to how long you plan to own the home and how your budget looks right now.' },
  'replace-with-bridge': { title: 'REPLACE WHEN READY, OR BRIDGE WITH GONANO', color: '#8B6914', icon: '🌉', cls: 'result-bridge', desc: "Your roof is past the point where we'd normally recommend a full replacement, but if a replacement isn't in the budget for the next 2-3 years, GoNano NuRoof can bridge the gap safely. It won't replace the roof you'll eventually need, but it will buy you the time to plan one on your terms." },
  'legacy-replace': { title: 'FULL REPLACEMENT RECOMMENDED', color: '#dc2626', icon: '🔨', cls: 'result-urgent', desc: 'Your roof is past its useful life and a rejuvenation treatment is no longer the right call. The next conversation should be about material choices, financing, and timing a replacement before a storm forces the decision.', tip: 'A proactive replacement gives you color, material, and warranty choices. An emergency one gives you whatever is on the truck.' }
};

function hasAny(list, values) {
  for (var i = 0; i < values.length; i++) { if (list.indexOf(values[i]) !== -1) return true; }
  return false;
}

function pickRecommendation(a) {
  var structuralFailure = hasAny(a.issues, ['leaks', 'sagging', 'daylight']);
  var stormDamage = a.issues.indexOf('storm') !== -1 || a.goal === 'damage';
  var insuranceDriven = a.insurance === 'yes-required' || a.insurance === 'yes-recommended' || a.goal === 'insurance';
  var minorIssues = hasAny(a.issues, ['missing', 'granules', 'mold']);
  var wantsBridge = a.budget === 'postpone';
  var wantsInvestNow = a.budget === 'invest-now';

  // Hard overrides apply to every material
  if (structuralFailure) return { variant: 'structural-replace' };
  if (stormDamage || insuranceDriven) return { variant: 'insurance-replace' };

  // Non-shingle paths fall back to the legacy score tiers (GoNano is shingle-first)
  if (a.material !== 'shingle' && a.material !== 'unsure') {
    return { variant: scoreToVariant(a.score) };
  }

  // Shingle decision tree by age
  switch (a.age) {
    case '0-5':
      return { variant: 'gonano-fortify' };

    case '5-10':
      return {
        variant: 'gonano-dual',
        paths: [
          {
            tag: 'RECOMMENDED', tagBg: '#FFF4D6', tagColor: '#8B6914',
            title: 'GoNano NuRoof Fortify',
            body: 'Lock in the useful life you have left with our top-tier Structural Roof Rejuvenation. Comes with a renewable 15-year warranty and typically pushes the replacement conversation out 10+ years.'
          },
          {
            tag: minorIssues ? 'TARGETED REPAIR' : 'MAINTENANCE', tagBg: '#E8F3FB', tagColor: '#2E6E9C',
            title: minorIssues ? 'Targeted Repair' : 'Inspection + Tune-Up',
            body: minorIssues
              ? 'Address the missing shingles, granule loss, or algae now before they become bigger problems. A targeted repair buys you time either way.'
              : 'A free inspection confirms the roof is still in good shape and gives you documentation for your insurance renewal.'
          }
        ]
      };

    case '10-15':
      if (wantsInvestNow) return { variant: 'legacy-replace' };
      return {
        variant: 'gonano-dual',
        paths: [
          {
            tag: 'BUDGET-FRIENDLY', tagBg: '#FFF4D6', tagColor: '#8B6914',
            title: 'GoNano NuRoof Revive or Protect',
            body: "Structural Roof Rejuvenation is the right call if you want to extend this roof instead of replacing it. We'll apply the right tier for your roof's current condition and back it with a renewable warranty."
          },
          {
            tag: 'LONG-TERM', tagBg: '#FDECEC', tagColor: '#B23636',
            title: 'Full Replacement',
            body: "If you plan to stay in the home 10+ more years, a new roof system resets the warranty clock and locks in today's material pricing before the next round of insurance pressure hits."
          }
        ]
      };

    case '15-20':
      if (wantsBridge) return { variant: 'replace-with-bridge' };
      return { variant: 'legacy-replace' };

    case '20+':
      return { variant: 'legacy-replace' };
  }
  // Fallback
  return { variant: scoreToVariant(a.score) };
}

function scoreToVariant(score) {
  if (score >= 10) return 'urgent';
  if (score >= 6) return 'soon';
  if (score >= 3) return 'maintain';
  return 'good';
}

function collectAnswers() {
  var q1 = document.querySelector('input[name="q1"]:checked');
  var q2 = document.querySelector('input[name="q2"]:checked');
  var q4 = document.querySelector('input[name="q4"]:checked');
  var q5 = document.querySelector('input[name="q5"]:checked');
  var q6 = document.querySelector('input[name="q6"]:checked');
  var q7 = document.querySelector('input[name="q7"]:checked');
  var q8 = document.querySelector('input[name="q8"]:checked');
  var issues = Array.prototype.map.call(document.querySelectorAll('input[name="q3"]:checked'), function(el){ return el.value; });

  var score = 0;
  document.querySelectorAll('#quiz input:checked').forEach(function(input) {
    score += parseInt(input.getAttribute('data-score') || '0');
  });

  return {
    age: q1 ? q1.value : null,
    material: q2 ? q2.value : null,
    issues: issues,
    goal: q4 ? q4.value : null,
    stormUrgency: q5 ? q5.value : null,
    insurance: q6 ? q6.value : null,
    homeowner: q7 ? q7.value : null,
    budget: q8 ? q8.value : null,
    score: score
  };
}

function renderDualResult(result) {
  var html = '<div class="result-card ' + result.cls + '">';
  html += '<p style="font-size:2.5rem;margin-bottom:.5rem">' + result.icon + '</p>';
  html += '<h2 style="font-family:\'Barlow Condensed\',sans-serif;font-weight:900;font-size:clamp(1.5rem,3vw,2rem);color:' + result.color + ';margin-bottom:1rem">' + result.title + '</h2>';
  html += '<p style="color:#555;font-size:.95rem;line-height:1.75;margin-bottom:.5rem">' + result.desc + '</p>';
  html += '<div class="result-paths">';
  for (var i = 0; i < result.paths.length; i++) {
    var p = result.paths[i];
    html += '<div class="result-path">';
    html += '<span class="path-tag" style="background:' + p.tagBg + ';color:' + p.tagColor + '">' + p.tag + '</span>';
    html += '<h3>' + p.title + '</h3>';
    html += '<p>' + p.body + '</p>';
    html += '</div>';
  }
  html += '</div>';
  html += '<p style="color:#888;font-size:.82rem;margin-top:1.25rem;line-height:1.6">A free inspection is the fastest way to lock in the right path. Our rep will walk both options on-site and show you real numbers.</p>';
  html += '</div>';
  return html;
}

function renderSingleResult(result) {
  var html = '<div class="result-card ' + result.cls + '">';
  html += '<p style="font-size:2.5rem;margin-bottom:.5rem">' + result.icon + '</p>';
  html += '<h2 style="font-family:\'Barlow Condensed\',sans-serif;font-weight:900;font-size:clamp(1.5rem,3vw,2rem);color:' + result.color + ';margin-bottom:1rem">' + result.title + '</h2>';
  html += '<p style="color:#555;font-size:.95rem;line-height:1.75;margin-bottom:1.5rem">' + result.desc + '</p>';
  if (result.tip) {
    html += '<div style="background:rgba(0,0,0,.04);border-radius:10px;padding:1rem 1.25rem;text-align:left"><p style="font-family:\'Barlow Condensed\',sans-serif;font-weight:700;font-size:.85rem;color:#888;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.35rem">Pro Tip</p><p style="color:#555;font-size:.88rem;line-height:1.65">' + result.tip + '</p></div>';
  }
  html += '</div>';
  return html;
}

function showResults() {
  var answers = collectAnswers();
  var decision = pickRecommendation(answers);
  var result = RESULT_VARIANTS[decision.variant] || RESULT_VARIANTS[scoreToVariant(answers.score)];

  var html;
  if (decision.paths && decision.paths.length) {
    result = Object.assign({}, result, { paths: decision.paths });
    html = renderDualResult(result);
  } else {
    html = renderSingleResult(result);
  }

  // Context line below the card for any GoNano-flavored path (fortify, dual,
  // bridge, or the "lock it in" pitch when the roof is in great shape).
  if (result.cls === 'result-gonano' || result.cls === 'result-dual' || result.cls === 'result-bridge') {
    html += '<div style="margin-top:1.25rem;padding:1rem 1.25rem;background:#FAF7F0;border:1px solid #E6D9B8;border-radius:12px"><p style="font-family:\'Barlow Condensed\',sans-serif;font-weight:700;font-size:.82rem;letter-spacing:.08em;color:#8B6914;text-transform:uppercase;margin-bottom:.4rem">What is GoNano NuRoof?</p><p style="color:#555;font-size:.88rem;line-height:1.65">GoNano NuRoof is a nano-penetrating Structural Roof Rejuvenation treatment. It is not a coating. It restores the flexibility of your shingles, is backed by a renewable 5, 10, or 15-year warranty depending on tier, and is a fraction of the cost of a full replacement. <a href="/gonano" style="color:#8B6914;font-weight:700;text-decoration:underline">Learn more about GoNano &rarr;</a></p></div>';
  }

  document.getElementById('result-container').innerHTML = html;
  document.getElementById('quiz').style.display = 'none';
  document.getElementById('results-section').style.display = 'block';
  document.getElementById('progress-fill').style.width = '100%';
  window.scrollTo({ top: document.getElementById('results-section').offsetTop - 80, behavior: 'smooth' });
}

// ── Tab Switching ──
function switchTab(tab) {
  var quizTab = document.getElementById('tab-quiz');
  var vizTab = document.getElementById('tab-viz');
  var quizSection = document.getElementById('quiz');
  var resultsSection = document.getElementById('results-section');
  var vizSection = document.getElementById('visualizer-section');

  if (tab === 'quiz') {
    quizTab.style.color = '#E6A817';
