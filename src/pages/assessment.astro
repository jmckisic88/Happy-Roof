var selectedColors = [];           // [{name,hex,line}]
var streetViewLoaded = false;
var uploadedImageData = null;
var lastOriginalImageUrl = '';

function renderColorSwatches() {
  var container = document.getElementById('color-options');
  if (!container) return;
  container.innerHTML = '';
  OC_COLORS.forEach(function(c) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'viz-color-swatch';
    btn.setAttribute('data-color', c.name);
    btn.style.cssText = 'display:flex;flex-direction:column;align-items:stretch;padding:0;background:#fff;border:2px solid #E0E0E0;border-radius:10px;cursor:pointer;overflow:hidden;transition:border-color .15s,box-shadow .15s,transform .1s';
    btn.innerHTML = '<div style="height:44px;background:' + c.hex + '"></div>' +
      '<div style="padding:.35rem .4rem .4rem;text-align:center">' +
        '<p style="font-family:\'Barlow Condensed\',sans-serif;font-weight:700;font-size:.76rem;color:#1A1A1A;margin:0;line-height:1.1">' + c.name + '</p>' +
        '<p style="font-size:.58rem;color:#888;margin:.1rem 0 0;letter-spacing:.04em;text-transform:uppercase">' + c.line.replace('TruDefinition Designer','Designer') + '</p>' +
      '</div>';
    btn.addEventListener('click', function() { toggleColor(c); });
    container.appendChild(btn);
  });
}

function toggleColor(c) {
  var idx = -1;
  for (var i = 0; i < selectedColors.length; i++) {
    if (selectedColors[i].name === c.name) { idx = i; break; }
  }
  if (idx >= 0) {
    selectedColors.splice(idx, 1);
  } else {
    if (selectedColors.length >= 4) {
      flashColorCounter();
      return;
    }
    selectedColors.push(c);
  }
  updateColorUI();
}

function flashColorCounter() {
  var el = document.getElementById('viz-color-count');
  if (!el) return;
  var orig = el.style.color;
  el.style.transition = 'color .2s';
  el.style.color = '#dc2626';
  setTimeout(function() { el.style.color = orig || ''; }, 500);
}

function updateColorUI() {
  var counter = document.getElementById('viz-color-count');
  if (counter) counter.textContent = selectedColors.length + ' / 4 selected';
  document.querySelectorAll('.viz-color-swatch').forEach(function(btn) {
    var name = btn.getAttribute('data-color');
    var isSel = selectedColors.some(function(sc) { return sc.name === name; });
    btn.style.borderColor = isSel ? '#E6A817' : '#E0E0E0';
    btn.style.boxShadow = isSel ? '0 2px 10px -2px rgba(230,168,23,.3)' : 'none';
    btn.style.transform = isSel ? 'translateY(-1px)' : 'none';
  });
  var btn = document.getElementById('viz-generate-btn');
  var lbl = document.getElementById('viz-generate-label');
  if (btn && lbl) {
    if (selectedColors.length === 0) {
      btn.disabled = true;
      lbl.textContent = 'Pick at least one color';
    } else {
      btn.disabled = false;
      lbl.textContent = selectedColors.length === 1
        ? 'Generate My Preview'
        : 'Generate ' + selectedColors.length + '-Color Comparison';
    }
  }
}

function validateYourInfo() {
  var fn = (document.getElementById('viz-firstname').value || '').trim();
  var ln = (document.getElementById('viz-lastname').value || '').trim();
  var addr = (document.getElementById('viz-address').value || '').trim();
  if (!fn) { alert('Please enter your first name.'); document.getElementById('viz-firstname').focus(); return false; }
  if (!ln) { alert('Please enter your last name.'); document.getElementById('viz-lastname').focus(); return false; }
  if (!addr) { alert('Please enter the property address.'); document.getElementById('viz-address').focus(); return false; }
  return true;
}

function handleFileUpload(input) {
  var file = input.files[0];
  if (!file) return;
  if (!validateYourInfo()) { input.value = ''; return; }
  if (file.size > 10 * 1024 * 1024) { alert('Image must be under 10MB'); return; }
  var reader = new FileReader();
  reader.onload = function(e) {
    uploadedImageData = e.target.result;
    lastOriginalImageUrl = uploadedImageData;
    document.getElementById('viz-original').src = uploadedImageData;
    document.getElementById('viz-source-label').textContent = 'Your uploaded photo';
    document.getElementById('viz-streetview').style.display = 'block';
    document.getElementById('viz-style-picker').style.display = 'block';
    document.getElementById('viz-upload-area').style.display = 'none';
    streetViewLoaded = true;
    updateColorUI();
  };
  reader.readAsDataURL(file);
}

function loadStreetView() {
  if (!validateYourInfo()) return;
  var address = document.getElementById('viz-address').value.trim();
  uploadedImageData = null;
  var apiKey = 'AIzaSyB2dfmJRH3YQvnnezQLGD2gBwbf0aJLAbU';
  var imgUrl = 'https://maps.googleapis.com/maps/api/streetview?size=800x500&location=' + encodeURIComponent(address) + '&key=' + apiKey + '&fov=90&pitch=15';
  lastOriginalImageUrl = imgUrl;
  document.getElementById('viz-original').src = imgUrl;
  document.getElementById('viz-source-label').textContent = 'Your home from Google Street View';
  document.getElementById('viz-streetview').style.display = 'block';
  document.getElementById('viz-style-picker').style.display = 'block';
  document.getElementById('viz-upload-area').style.display = 'none';
  streetViewLoaded = true;
  updateColorUI();
}

function getGenerationCount() {
  try {
    var data = JSON.parse(localStorage.getItem('hr_viz_gens') || '{}');
    var now = Date.now();
    // Reset if older than 24 hours
    if (data.timestamp && (now - data.timestamp) > 86400000) {
      localStorage.removeItem('hr_viz_gens');
      return 0;
    }
    return data.count || 0;
  } catch(e) { return 0; }
}

function incrementGenerationCount() {
  try {
    var data = JSON.parse(localStorage.getItem('hr_viz_gens') || '{}');
    data.count = (data.count || 0) + 1;
    if (!data.timestamp) data.timestamp = Date.now();
    localStorage.setItem('hr_viz_gens', JSON.stringify(data));
  } catch(e) {}
}

function generateVisualization() {
  if (!streetViewLoaded) { alert('Please find your home first.'); return; }
  if (!selectedColors.length) { alert('Pick at least one color.'); return; }
  if (!validateYourInfo()) return;

  var genCount = getGenerationCount();
  if (genCount >= 3) {
    var msg = document.getElementById('viz-limit-msg');
    msg.textContent = 'You\'ve used all 3 comparisons today. Come back tomorrow or call us at (813) 595-7663 for a free in-person consultation.';
    msg.style.display = 'block';
    return;
  }

  var address = document.getElementById('viz-address').value.trim();
  var btn = document.getElementById('viz-generate-btn');
  var lbl = document.getElementById('viz-generate-label');

  document.getElementById('viz-loading').style.display = 'flex';
  document.getElementById('viz-result').style.display = 'none';
  document.getElementById('viz-style-picker').style.display = 'none';
  btn.disabled = true;
  if (lbl) lbl.textContent = 'Generating ' + selectedColors.length + ' preview' + (selectedColors.length === 1 ? '' : 's') + '...';

  // Fire-and-forget lead capture to Breeze \u2014 Josh gets the name+address even without email/phone
  captureVisualizerLead();

  // Build the lead payload that the server also emails directly on success
  var leadPayload = {
    first_name: (document.getElementById('viz-firstname').value || '').trim(),
    last_name: (document.getElementById('viz-lastname').value || '').trim(),
    address: address,
    email: ((document.getElementById('viz-email') || {}).value || '').trim(),
    phone: ((document.getElementById('viz-phone') || {}).value || '').trim()
  };

  var payload = {
    roofStyle: 'architectural shingle',
    colors: selectedColors.map(function(c) { return { name: c.name, hex: c.hex }; }),
    lead: leadPayload,
    source: '/assessment?tab=viz'
  };
  if (uploadedImageData) {
    payload.uploadedImage = uploadedImageData;
  } else {
    payload.address = address;
  }

  fetch('/api/roof-visualizer', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    document.getElementById('viz-loading').style.display = 'none';
    document.getElementById('viz-style-picker').style.display = 'block';
    updateColorUI();

    if (data.success && data.generatedImages && data.generatedImages.length) {
      incrementGenerationCount();
      compositeComparisonGrid(data.generatedImages, selectedColors);
      var remaining = 3 - getGenerationCount();
      document.getElementById('viz-style-label').textContent = remaining > 0
        ? remaining + ' comparison' + (remaining === 1 ? '' : 's') + ' remaining today'
        : 'No more comparisons today. Call us at (813) 595-7663 for an in-person review.';
      document.getElementById('viz-result').style.display = 'block';
      updateCostEstimate();
      document.getElementById('viz-result').scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      if (data.noStreetView) {
        document.getElementById('viz-upload-area').style.display = 'block';
        alert('Google does not have street-level imagery for this address yet. Upload a photo of the home below and we will generate from that.');
      } else {
        // Surface the server details so we can diagnose what OpenAI returned
        var detail = (data && data.details) ? '\n\nDetails: ' + data.details : '';
        var firstFail = (data && data.failures && data.failures[0]) ? '\n\nFirst failure: ' + data.failures[0].error : '';
        alert('We could not generate a comparison. ' + (data.error || 'Please try again.') + detail + firstFail);
        console.error('[roof-viz] generation failed:', data);
      }
    }
  })
  .catch(function() {
    document.getElementById('viz-loading').style.display = 'none';
    document.getElementById('viz-style-picker').style.display = 'block';
    updateColorUI();
    alert('Something went wrong. Please try again or call us at (813) 595-7663.');
  });
}

function compositeComparisonGrid(images, colors) {
  var canvas = document.getElementById('viz-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var count = images.length;
  var cols = count >= 2 ? 2 : 1;
  var rows = Math.ceil(count / cols);
  var firstImg = new Image();
  firstImg.crossOrigin = 'anonymous';
  firstImg.onload = function() {
    var w = firstImg.naturalWidth;
    var h = firstImg.naturalHeight;
    var header = 80;
    var labelH = 54;
    var tileH = h + labelH;
    canvas.width = w * cols;
    canvas.height = header + tileH * rows;

    // Header band
    ctx.fillStyle = '#1A1A1A';
    ctx.fillRect(0, 0, canvas.width, header);
    ctx.fillStyle = '#FFFFFF';
    ctx.font = '800 32px "Barlow Condensed", Arial, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('ROOFING COLOR COMPARISON', canvas.width/2, header/2 - 10);
    ctx.fillStyle = 'rgba(255,255,255,0.65)';
    ctx.font = '600 14px "Barlow Condensed", Arial, sans-serif';
    ctx.fillText('YOUR HOME  |  ' + count + ' SHINGLE OPTION' + (count === 1 ? '' : 'S') + '  |  HAPPYROOF.COM', canvas.width/2, header/2 + 16);

    images.forEach(function(src, i) {
      var r = Math.floor(i / cols);
      var c = i % cols;
      var x = c * w;
      var y = header + r * tileH;
      var img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = function() {
        ctx.drawImage(img, x, y, w, h);
        ctx.fillStyle = '#1A1A1A';
        ctx.fillRect(x, y + h, w, labelH);
        ctx.fillStyle = 'rgba(255,255,255,0.6)';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.font = '600 12px "Barlow Condensed", Arial, sans-serif';
        ctx.fillText('OPTION ' + (i + 1), x + 18, y + h + 16);
        ctx.fillStyle = '#FFFFFF';
        ctx.font = '800 22px "Barlow Condensed", Arial, sans-serif';
        ctx.fillText(colors[i].name, x + 18, y + h + 36);
        // Swatch chip
        ctx.fillStyle = colors[i].hex;
        ctx.beginPath();
        ctx.arc(x + w - 28, y + h + 26, 12, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.lineWidth = 1;
        ctx.stroke();
      };
      img.onerror = function() { /* ignore tile load failure */ };
      img.src = src;
    });
  };
  firstImg.onerror = function() { alert('Preview images did not load. Please try again.'); };
  firstImg.src = images[0];
}

function downloadComparison() {
  var canvas = document.getElementById('viz-canvas');
  if (!canvas || !canvas.width) return;
  canvas.toBlob(function(blob) {
    if (!blob) return;
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'happy-roof-color-comparison.png';
    document.body.appendChild(a);
    a.click();
    setTimeout(function() {
      URL.revokeObjectURL(url);
      if (a.parentNode) a.parentNode.removeChild(a);
    }, 200);
  }, 'image/png');
}

function resetVisualization() {
  document.getElementById('viz-result').style.display = 'none';
  document.getElementById('viz-style-picker').style.display = 'block';
  document.getElementById('viz-style-picker').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

