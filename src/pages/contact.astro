---
import BaseLayout from '../layouts/BaseLayout.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';

const schema = `{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "RoofingContractor"],
    "name": "Happy Roof LLC",
    "url": "https://happyroof.com",
    "telephone": "+1-813-595-7663",
    "email": "info@happyroof.com",
    "description": "Tampa Bay's trusted roofing contractor specializing in roof replacement, repair, storm damage, inspections, and new construction. Licensed & insured. FL License #CCC1337380.",
    "image": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "logo": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "141 Stevens Ave #12","addressLocality": "Oldsmar",
      "addressRegion": "FL","postalCode": "34677",
      "addressCountry": "US"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 28.0340, "longitude": -82.6651 },
    "priceRange": "$$",
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" }
    ],
    "areaServed": [
      { "@type": "City", "name": "Tampa" },
      { "@type": "City", "name": "St. Petersburg" },
      { "@type": "City", "name": "Clearwater" },
      { "@type": "City", "name": "Brandon" },
      { "@type": "City", "name": "Wesley Chapel" },
      { "@type": "City", "name": "Riverview" },
      { "@type": "City", "name": "Lutz" },
      { "@type": "City", "name": "Land O Lakes" },
      { "@type": "City", "name": "Odessa" },
      { "@type": "City", "name": "Temple Terrace" },
      { "@type": "City", "name": "New Tampa" },
      { "@type": "City", "name": "Carrollwood" },
      { "@type": "City", "name": "Oldsmar" },
      { "@type": "City", "name": "Palm Harbor" },
      { "@type": "City", "name": "Tarpon Springs" },
      { "@type": "City", "name": "Safety Harbor" },
      { "@type": "City", "name": "Dunedin" },
      { "@type": "City", "name": "Largo" },
      { "@type": "City", "name": "Seminole" },
      { "@type": "City", "name": "New Port Richey" },
      { "@type": "City", "name": "Trinity" },
      { "@type": "City", "name": "Valrico" },
      { "@type": "City", "name": "Plant City" },
      { "@type": "City", "name": "Seffner" },
      { "@type": "City", "name": "Town n Country" },
      { "@type": "City", "name": "Citrus Park" },
      { "@type": "City", "name": "Fish Hawk" },
      { "@type": "City", "name": "Apollo Beach" },
      { "@type": "City", "name": "Sun City Center" },
      { "@type": "AdministrativeArea", "name": "Hillsborough County" },
      { "@type": "AdministrativeArea", "name": "Pinellas County" },
      { "@type": "AdministrativeArea", "name": "Pasco County" }
    ],
    "sameAs": [
      "https://www.facebook.com/share/1E27RD4hjZ/",
      "https://www.instagram.com/happyroofflorida",
      "https://www.tiktok.com/@happyrooffl",
      "https://share.google/eM5h7LtohVsqVd0Nd"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Roofing Services",
      "itemListElement": [
        { "@type": "OfferCatalog", "name": "Roof Replacement", "description": "Complete residential and commercial roof replacement with asphalt shingles, metal, tile, or flat roof systems" },
        { "@type": "OfferCatalog", "name": "Roof Repair", "description": "Leak repair, shingle replacement, flashing repair, and emergency tarping" },
        { "@type": "OfferCatalog", "name": "Storm Damage Repair", "description": "Hurricane and storm damage roof repair with full insurance claim assistance" },
        { "@type": "OfferCatalog", "name": "Roof Inspection", "description": "Professional roof inspections for real estate, insurance, and maintenance" },
        { "@type": "OfferCatalog", "name": "Commercial Roofing", "description": "TPO, EPDM, modified bitumen, and metal roofing for commercial properties" },
        { "@type": "OfferCatalog", "name": "New Construction Roofing", "description": "Roofing systems for new residential and commercial construction" }
      ]
    },
    "dateModified": "2026-04-25",
    "hasCredential": "Florida Roofing Contractor License #CCC1337380",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "6",
      "bestRating": "5",
      "worstRating": "1"
    }
  }`;
---

<BaseLayout
  title="Contact Us | Happy Roof"
  description="Looking to protect your Tampa Bay home? Contact Happy Roof to schedule a FREE estimate with our residential and commercial roofing contractors."
  canonical="https://happyroof.com/contact"
  ogTitle="Free Roofing Estimate | Happy Roof Tampa Bay"
  ogDescription="Request your free roofing estimate in Tampa Bay. Call (813) 595-7663 or fill out our quick online form. We respond within 24 hours."
  activePage="contact"
  schema={schema}
>

<style is:inline>
/* Form */
    .fgroup{margin-bottom:1.1rem}
    /* Contact info card */
    .info.card{background:#FFFFFF;border:1px dashed #E0E0E0;border-radius:16px;padding:1.25rem 1.5rem;display:flex;align-items:flex-start;gap:.875rem;transition:border-color .2s}
    .info-card:hover{border-color:rgba(230,168,23,.25)}
    .info-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    /* Service radio cards */
    .service-grid{display:grid;grid-template-columns:1fr;gap:.5rem}
    @media (min-width:640px){.service-grid{grid-template-columns:1fr 1fr}}
    .service-opt{display:flex;align-items:center;gap:.6rem;padding:.75rem .9rem;background:#FFFFFF;border:1px solid #E0E0E0;border-radius:10px;cursor:pointer;transition:border-color .18s ease,background .18s ease;font-size:.92rem;color:#333}
    .service-opt:hover{border-color:#3B9FD9;background:#FAFCFE}
    .service-opt input[type=radio]{accent-color:#3B9FD9;width:16px;height:16px;flex-shrink:0;cursor:pointer}
    .service-opt:has(input:checked){border-color:#3B9FD9;background:rgba(59,159,217,.06)}
    /* ── Hero photo bg ── */
</style>

<!-- HERO -->
<section class="pt-32 pb-16 relative overflow-hidden" style="background:#F5F5F5;border-bottom:1px solid #E5E5E5">
  <!-- Hero background photo -->
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/commercial-tpo-roof-tampa.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-5 text-center">
    <p class="sl gp mb-4">Get in Touch</p>
    <h1 class="font-display font-black tracking-tightest mb-4" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(3rem,6vw,5rem);line-height:.92;letter-spacing:-.01em;color:#1A1A1A">
      LET'S TALK ROOFING.
    </h1>
    <p class="max-w-xl mx-auto" style="color:#555555;font-size:1.05rem;line-height:1.75">
      No call centers. No automated responses. Fill out the form or call us directly, and a real person from our team will get back to you within 24 hours.
    </p>
  </div>
</section>

<!-- Trust Signals — Accreditations + Credentials (mirrors / and /about) -->
<style>
  .tb {display:flex;align-items:center;gap:.7rem;padding:.7rem 1rem;background:#FFFFFF;border:1px solid #E0E0E0;border-radius:10px;min-width:170px;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
  .tb:hover {transform:translateY(-2px);box-shadow:0 8px 20px -6px rgba(26,26,26,.12);border-color:#CFCFCF}
  .tb-icon {width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .tb-name {font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:.92rem;color:#1A1A1A;letter-spacing:.015em;margin:0;line-height:1.1}
  .tb-sub {font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:.7rem;color:#888;letter-spacing:.06em;text-transform:uppercase;margin:.2rem 0 0;line-height:1.15}
  .tb-emblem .tb-icon {width:44px;height:44px;border-radius:10px}
  .tb-emblem .tb-name {font-size:1rem;letter-spacing:.02em}
  .tb-eyebrow {text-align:center;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:#888;margin:0 0 1.15rem}
  a.tb {text-decoration:none;color:inherit}
  .tb-seal-img {height:44px;width:80px;object-fit:contain;object-position:center;display:block}
  @media (max-width:640px) {.tb {min-width:0;flex:1 1 calc(50% - .35rem)} .tb-name {font-size:.85rem} .tb-sub {font-size:.65rem}}
</style>
<section aria-labelledby="contact-trust-heading" style="background:#F7F7F7;border-top:1px solid #E0E0E0;border-bottom:1px solid #E0E0E0;padding:1.75rem 0">
  <div class="max-w-7xl mx-auto px-5">
    <p id="contact-trust-heading" class="tb-eyebrow">Accreditations &amp; Credentials</p>
    <div style="display:flex;flex-wrap:wrap;align-items:stretch;justify-content:center;gap:.7rem">

      <!-- BBB Accredited Business -->
      <a class="tb tb-emblem" href="https://www.bbb.org/us/fl/oldsmar/profile/roofing-contractors/happy-roof-llc-0653-90461345" target="_blank" rel="noopener noreferrer" aria-label="BBB Accredited Business — view Happy Roof LLC profile on bbb.org">
        <img class="tb-seal-img" src="https://m.bbb.org/brand/seals/Accredited_Business_Seal_NoRating_RGB.svg" alt="BBB Accredited Business" width="80" height="44" loading="eager" />
        <div>
          <p class="tb-name">Accredited</p>
          <p class="tb-sub">Verify on BBB.org &rarr;</p>
        </div>
      </a>

      <!-- Owens Corning Preferred Contractor -->
      <div class="tb tb-emblem" role="group" aria-label="Owens Corning Preferred Contractor">
        <div class="tb-icon" style="background:rgba(232,65,90,0.10);color:#E8415A" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
        </div>
        <div>
          <p class="tb-name">Preferred Contractor</p>
          <p class="tb-sub">Owens Corning</p>
        </div>
      </div>

      <!-- Certified GoNano Contractor -->
      <a class="tb tb-emblem" href="/gonano" aria-label="Certified GoNano Contractor for GoNano NuRoof" style="text-decoration:none;color:inherit">
        <div class="tb-icon" style="background:rgba(103,92,231,0.12);color:#675CE7" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><circle cx="12" cy="12" r="2.5"/><path d="M8.1 7.5l2.1 3M15.9 7.5l-2.1 3M8.1 16.5l2.1-3M15.9 16.5l-2.1-3"/></svg>
        </div>
        <div>
          <p class="tb-name">Certified Contractor</p>
          <p class="tb-sub">GoNano NuRoof</p>
        </div>
      </a>

      <!-- FL License -->
      <div class="tb" role="group" aria-label="Florida Licensed Roofing Contractor">
        <div class="tb-icon" style="background:rgba(59,159,217,0.10);color:#3B9FD9" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
          <p class="tb-name">FL Licensed</p>
          <p class="tb-sub">CCC1337380</p>
        </div>
      </div>

      <!-- Insured -->
      <div class="tb" role="group" aria-label="Fully insured">
        <div class="tb-icon" style="background:rgba(230,168,23,0.12);color:#E6A817" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <p class="tb-name">Insured</p>
          <p class="tb-sub">General liability + WC</p>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- CONTACT INFO STRIP -->
<div style="background:#F7F7F7;border-top:1px solid #E0E0E0;border-bottom:1px solid #E0E0E0">
  <div class="max-w-7xl mx-auto px-5 py-5">
    <div class="flex flex-wrap justify-center gap-4">
      <a href="tel:8135957663" class="call-tracking-number flex items-center gap-3 px-5 py-3 rounded-xl transition-colors" style="background:#F7F7F7;border:1px solid #E0E0E0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.18 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.82-.82a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <div><p style="color:#555555;font-size:.68rem;letter-spacing:.1em">CALL OR TEXT</p><p class="font-display font-bold" style="font-family:'Barlow Condensed',sans-serif;color:#3B9FD9;font-size:1rem">(813) 595-7663</p></div>
      </a>
      <div class="flex items-center gap-3 px-5 py-3 rounded-xl" style="background:#F7F7F7;border:1px solid #E0E0E0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F0C040" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <div><p style="color:#555555;font-size:.68rem;letter-spacing:.1em">HOURS</p><p class="font-display font-bold" style="font-family:'Barlow Condensed',sans-serif;color:#1A1A1A;font-size:1rem">Mon–Fri 9am–5pm</p></div>
      </div>
      <div class="flex items-center gap-3 px-5 py-3 rounded-xl" style="background:#F7F7F7;border:1px solid #E0E0E0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div><p style="color:#555555;font-size:.68rem;letter-spacing:.1em">LOCATION</p><p class="font-display font-bold" style="font-family:'Barlow Condensed',sans-serif;color:#1A1A1A;font-size:1rem">Tampa Bay, FL</p></div>
      </div>
      <div class="flex items-center gap-3 px-5 py-3 rounded-xl" style="background:#F7F7F7;border:1px solid #E0E0E0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F0C040" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        <div><p style="color:#555555;font-size:.68rem;letter-spacing:.1em">EMERGENCY</p><p class="font-display font-bold" style="font-family:'Barlow Condensed',sans-serif;color:#1A1A1A;font-size:1rem">48-hr Response</p></div>
      </div>
    </div>
  </div>
</div>

<!-- MAIN CONTENT -->
<section id="form" class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid lg:grid-cols-5 gap-12">

      <!-- Form (3/5) -->
      <div class="lg:col-span-3">
        <div id="estimate-form" class="rounded-2xl p-8" style="background:#F7F7F7;border:1px solid #E0E0E0;box-shadow:0 24px 60px -12px rgba(0,0,0,.4);scroll-margin-top:75px">
          <h2 class="font-display font-black tracking-tightest mb-2" style="font-family:'Barlow Condensed',sans-serif;font-size:1.8rem;line-height:.95;letter-spacing:-.01em">GET A FREE ESTIMATE</h2>
          <p style="color:#888888;font-size:.85rem;margin-bottom:1.75rem">We typically respond within 1 business day.</p>

<form id="contact-form" onsubmit="handleSubmit(event)">
            <div class="grid sm:grid-cols-2 gap-4 mb-0">
              <div class="fgroup">
                <label class="flabel">Name <span style="color:#3B9FD9">*</span></label>
                <input type="text" name="name" class="finput" placeholder="Jane Smith" required />
              </div>
              <div class="fgroup">
                <label class="flabel">Phone <span style="color:#3B9FD9">*</span></label>
                <input type="tel" name="phone" class="finput" placeholder="(813) 555-0000" required />
              </div>
            </div>
            <div class="fgroup">
              <label class="flabel">Email</label>
              <input type="email" name="email" class="finput" placeholder="jane@example.com" />
            </div>
            <div class="fgroup">
              <label class="flabel">Property Address</label>
              <div style="position:relative">
                <input type="text" name="address" id="contact-address" class="finput" placeholder="Start typing your address" autocomplete="off" />
              </div>
              <!-- Structured components populated by Google Places selection. Empty if the customer types freely without picking a suggestion. -->
              <input type="hidden" name="address_street" id="contact-address-street" />
              <input type="hidden" name="address_city" id="contact-address-city" />
              <input type="hidden" name="address_state" id="contact-address-state" />
              <input type="hidden" name="address_postal_code" id="contact-address-zip" />
              <input type="hidden" name="address_lat" id="contact-address-lat" />
              <input type="hidden" name="address_lng" id="contact-address-lng" />
              <input type="hidden" name="address_place_id" id="contact-address-placeid" />
            </div>
            <div class="fgroup">
              <label class="flabel">What can we help with? <span style="color:#3B9FD9">*</span></label>
              <div class="service-grid" role="radiogroup" aria-label="Service interest">
                <label class="service-opt">
                  <input type="radio" name="service" value="Roof Replacement" required />
                  <span>Full roof replacement</span>
                </label>
                <label class="service-opt">
                  <input type="radio" name="service" value="Repair or Inspection" />
                  <span>Repair or inspection</span>
                </label>
                <label class="service-opt">
                  <input type="radio" name="service" value="GoNano NuRoof" />
                  <span>GoNano NuRoof (extend my roof)</span>
                </label>
                <label class="service-opt">
                  <input type="radio" name="service" value="Not Sure" />
                  <span>Not sure, help me figure it out</span>
                </label>
              </div>
            </div>
            <div class="fgroup">
              <label class="flabel">Promo Code</label>
              <div style="position:relative">
                <input type="text" name="promo_code" class="finput promo-input" placeholder="e.g. POSTCARD26" style="text-transform:uppercase;padding-right:2.5rem" />
                <span class="promo-status" style="position:absolute;right:.75rem;top:50%;transform:translateY(-50%);font-size:1rem;line-height:1;display:none"></span>
              </div>
              <p class="promo-msg" style="font-size:.75rem;margin-top:.35rem;line-height:1.4;display:none"></p>
            </div>
            <!-- SMS Consent (Twilio mixed-use compliance) -->
            <div class="fgroup" style="display:flex;flex-direction:column;gap:.6rem">
              <div style="display:flex;align-items:flex-start;gap:.5rem">
                <input type="checkbox" id="sms-transactional" name="sms_transactional" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
                <label for="sms-transactional" style="font-size:.72rem;color:#555555;line-height:1.55;cursor:pointer">By checking, you are allowing to receive <strong>transactional/informational SMS</strong> communications regarding account notifications, customer care, etc, from <strong>Happy Roof</strong>. Messages frequency may vary. Data rates may apply, <strong>reply STOP to opt-out.</strong></label>
              </div>
              <div style="display:flex;align-items:flex-start;gap:.5rem">
                <input type="checkbox" id="sms-marketing" name="sms_marketing" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
                <label for="sms-marketing" style="font-size:.72rem;color:#555555;line-height:1.55;cursor:pointer">By checking, you are allowing to receive <strong>promotional/marketing SMS</strong> communications from <strong>Happy Roof</strong>. Frequency may vary, Data rates may apply, <strong>reply HELP for help or STOP to opt-out.</strong></label>
              </div>
              <div style="display:flex;align-items:flex-start;gap:.5rem">
                <input type="checkbox" id="newsletter" name="newsletter" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
                <label for="newsletter" style="font-size:.72rem;color:#555555;line-height:1.55;cursor:pointer">By checking, you are allowing to receive <strong>email newsletters and promotions</strong> from <strong>Happy Roof</strong>. You can unsubscribe at any time using the link in any email.</label>
              </div>
              <div style="display:flex;align-items:flex-start;gap:.5rem">
                <input type="checkbox" id="terms-consent" name="terms_consent" value="Yes" style="width:16px;height:16px;min-width:16px;margin-top:.15rem;accent-color:#3B9FD9;cursor:pointer" />
                <label for="terms-consent" style="font-size:.72rem;color:#555555;line-height:1.55;cursor:pointer">By checking, you accept <a href="/terms" style="color:#3B9FD9;text-decoration:underline">Terms of Service</a> &amp; <a href="/privacy" style="color:#3B9FD9;text-decoration:underline">Privacy Policy</a>.</label>
              </div>
            </div>
            <!-- Cloudflare Turnstile bot protection -->
            <TurnstileWidget formId="contact-form" />
            <button type="submit" class="btn-t w-full justify-center" style="font-size:1.1rem;padding:1rem">
              Get My Free Estimate
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </form>

          <!-- Success message (hidden by default) -->
          <div id="success-msg" class="hidden mt-5 p-5 rounded-xl text-center" style="background:rgba(59,159,217,.08);border:1px solid rgba(59,159,217,.2)">
