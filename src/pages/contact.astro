<script is:inline>
function toggleFaq(el) {
  const isOpen = el.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
  if (!isOpen) el.classList.add('open');
}
function handleSubmit(e) {
  e.preventDefault();
  const form = e.target;
  const inputs = form.querySelectorAll('input,select,textarea');
  const data = { _subject: 'New Contact Form - Happy Roof Website' };
  inputs.forEach(el => { if (el.name) data[el.name] = el.type==='checkbox' ? (el.checked?'Yes':'No') : el.value; });
  const btn = form.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = 'Sending…';
  var promoNote = data.promo_code ? 'Promo Code: ' + data.promo_code.toUpperCase() : '';
  var service = data.service || '';
  var source = service === 'GoNano NuRoof' ? 'Website - Contact (GoNano)' : 'Website - Contact';
  const stPayload = {
    name: data.name||'',
    phone: data.phone||'',
    email: data.email||'',
    service: service,
    address: data.address||'',
    address_street: data.address_street||'',
    address_city: data.address_city||'',
    address_state: data.address_state||'',
    address_postal_code: data.address_postal_code||'',
    address_lat: data.address_lat||'',
    address_lng: data.address_lng||'',
    address_place_id: data.address_place_id||'',
    notes: promoNote,
    source: source,
    page: window.location.pathname,
    newsletter: data.newsletter === 'Yes'
  };
  window.HR_Forms.submitLead(form, stPayload, { formId: 'contact-form', formSubmitPayload: data }).then(function(result) {
    if (result.status === 'ok' || result.status === 'fallback_sent') {
      document.getElementById('success-msg').classList.remove('hidden');
      form.style.display = 'none';
      return;
    }
    // Real failure surface: verification expired OR widget unavailable OR total error.
    // Preserve customer input, re-enable submit, show inline notice + call CTA.
    btn.disabled = false; btn.textContent = 'Get My Free Estimate';
    var msg = (result.status === 'verification_expired')
      ? 'Verification expired. Please retry, or call us at <a href="tel:8135957663" style="color:#78350F;font-weight:700;text-decoration:underline">(813) 595-7663</a>.'
      : (result.status === 'verification_unavailable')
        ? 'Verification could not load. Please retry, or call us at <a href="tel:8135957663" style="color:#78350F;font-weight:700;text-decoration:underline">(813) 595-7663</a>.'
        : (result.message || 'Something went wrong. Please call <a href="tel:8135957663" style="color:#78350F;font-weight:700;text-decoration:underline">(813) 595-7663</a>.');
    window.HR_Forms.showInlineNotice(form, 'error', msg);
  });
}
// Pre-select the service radio from ?service= (e.g. /gonano CTAs).
function preselectServiceFromQuery() {
  try {
    var params = new URLSearchParams(window.location.search);
    var raw = (params.get('service') || '').toLowerCase();
    if (!raw) return;
    var map = {
      'gonano': 'GoNano NuRoof',
      'gonano-nuroof': 'GoNano NuRoof',
      'replacement': 'Roof Replacement',
      'roof-replacement': 'Roof Replacement',
      'repair': 'Repair or Inspection',
      'inspection': 'Repair or Inspection'
    };
    var target = map[raw];
    if (!target) return;
    var radio = document.querySelector('input[name="service"][value="' + target + '"]');
    if (radio) radio.checked = true;
  } catch (e) { /* no-op */ }
}
// Draft persistence: repopulate on mount, snapshot on input.
document.addEventListener('DOMContentLoaded', function() {
  var f = document.getElementById('contact-form');
  if (f && window.HR_Forms) window.HR_Forms.attachDraft(f, { formId: 'contact-form' });
  preselectServiceFromQuery();
});
</script>

<!-- Google Places autocomplete for the property address field (server-side proxy; no client API key). Gracefully degrades to a plain text input if the Places API is unavailable. -->
<script is:inline>
(function() {
  var input = document.getElementById('contact-address');
  if (!input) return;

  var fStreet  = document.getElementById('contact-address-street');
  var fCity    = document.getElementById('contact-address-city');
  var fState   = document.getElementById('contact-address-state');
  var fZip     = document.getElementById('contact-address-zip');
  var fLat     = document.getElementById('contact-address-lat');
  var fLng     = document.getElementById('contact-address-lng');
  var fPlaceId = document.getElementById('contact-address-placeid');

  function clearStructured() {
    if (fStreet)  fStreet.value  = '';
    if (fCity)    fCity.value    = '';
    if (fState)   fState.value   = '';
    if (fZip)     fZip.value     = '';
    if (fLat)     fLat.value     = '';
    if (fLng)     fLng.value     = '';
    if (fPlaceId) fPlaceId.value = '';
  }

  function newSession() {
    if (window.crypto && typeof window.crypto.randomUUID === 'function') {
      return window.crypto.randomUUID();
    }
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      var r = Math.random() * 16 | 0;
      var v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  }
  var sessionToken = newSession();

  var dropdown = document.createElement('div');
  dropdown.id = 'contact-address-dropdown';
  dropdown.style.cssText = 'position:absolute;left:0;right:0;top:100%;background:#fff;border:1px solid #E0E0E0;border-top:none;border-radius:0 0 8px 8px;box-shadow:0 8px 24px -4px rgba(0,0,0,.12);z-index:100;display:none;max-height:250px;overflow-y:auto';
  input.parentElement.style.position = 'relative';
  input.parentElement.appendChild(dropdown);

  function hideDropdown() { dropdown.style.display = 'none'; }
  function showDropdown() { dropdown.style.display = 'block'; }

  var apiDisabled = false;
  var debounceId;

  input.addEventListener('input', function() {
    clearStructured();
    if (apiDisabled) return;
    clearTimeout(debounceId);
    var q = input.value.trim();
    if (q.length < 4) { hideDropdown(); return; }
    debounceId = setTimeout(function() {
      fetch('/api/address-suggest?q=' + encodeURIComponent(q) + '&session=' + encodeURIComponent(sessionToken))
        .then(function(r) {
          if (r.status === 500) { apiDisabled = true; hideDropdown(); return null; }
          return r.json();
        })
        .then(function(data) {
          if (!data) return;
          var preds = Array.isArray(data.predictions) && data.predictions.length
            ? data.predictions
            : (Array.isArray(data.suggestions) ? data.suggestions.map(function(s) { return { text: s, placeId: '' }; }) : []);
          if (!preds.length) { hideDropdown(); return; }
          dropdown.innerHTML = '';
          preds.forEach(function(p) {
            var item = document.createElement('div');
            item.textContent = p.text;
            item.style.cssText = 'padding:.75rem 1rem;cursor:pointer;font-size:.9rem;color:#1A1A1A;border-bottom:1px solid #F0F0F0;transition:background .1s';
            item.addEventListener('mouseenter', function() { item.style.background = 'rgba(59,159,217,.06)'; });
            item.addEventListener('mouseleave', function() { item.style.background = 'transparent'; });
            item.addEventListener('mousedown', function(ev) {
              ev.preventDefault();
              selectPrediction(p);
            });
            dropdown.appendChild(item);
          });
          showDropdown();
        })
        .catch(function() { hideDropdown(); });
    }, 300);
  });

  function selectPrediction(p) {
    input.value = p.text;
    hideDropdown();
    if (!p.placeId) return;
    fetch('/api/place-details?placeId=' + encodeURIComponent(p.placeId) + '&session=' + encodeURIComponent(sessionToken))
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d || !d.ok) return;
        if (fStreet)  fStreet.value  = d.street || '';
        if (fCity)    fCity.value    = d.city || '';
        if (fState)   fState.value   = d.state || 'FL';
        if (fZip)     fZip.value     = d.postal_code || '';
        if (fLat)     fLat.value     = (d.lat != null ? String(d.lat) : '');
        if (fLng)     fLng.value     = (d.lng != null ? String(d.lng) : '');
        if (fPlaceId) fPlaceId.value = d.placeId || p.placeId;
        sessionToken = newSession();
      })
      .catch(function() { /* fall back to unstructured submit */ });
  }

  document.addEventListener('click', function(e) {
    if (!input.contains(e.target) && !dropdown.contains(e.target)) hideDropdown();
  });
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hideDropdown();
  });
})();
</script>

