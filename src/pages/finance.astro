---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "RoofingContractor"],
    "name": "Happy Roof LLC",
    "url": "https://happyroof.com",
    "telephone": "+1-813-595-7663",
    "email": "info@happyroof.com",
    "description": "Tampa Bay roofing contractor offering flexible roof financing through Service Finance, GreenSky, and Enhancify. Owens Corning Preferred Contractor. BBB Accredited. FL License #CCC1337380.",
    "image": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "logo": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "141 Stevens Ave #12","addressLocality": "Oldsmar",
      "addressRegion": "FL","postalCode": "34677",
      "addressCountry": "US"
    },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Hillsborough County" },
      { "@type": "AdministrativeArea", "name": "Pinellas County" },
      { "@type": "AdministrativeArea", "name": "Pasco County" }
    ],
    "hasCredential": [
      "Florida Roofing Contractor License #CCC1337380",
      "Owens Corning Preferred Contractor",
      "BBB Accredited Business"
    ],
    "dateModified": "2026-10-05"
  },{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":"Does checking my rate affect my credit score?","acceptedAnswer":{"@type":"Answer","text":"No. All three of our financing partners (Service Finance, GreenSky, and Enhancify) start with a soft credit check that doesn't affect your credit score. You only move to a hard pull if you decide to proceed with a formal application."}},
      {"@type":"Question","name":"What credit score do I need to qualify for roof financing?","acceptedAnswer":{"@type":"Answer","text":"Our three partners cover a wide range of credit profiles, which is one reason we work with multiple lenders. The best way to find out what you qualify for is to request an estimate so we can match you with the right partner for your situation."}},
      {"@type":"Question","name":"Can I finance a roof repair or just a replacement?","acceptedAnswer":{"@type":"Answer","text":"Financing is available for both replacements and larger repair projects. Minimum project amounts may apply depending on the financing partner."}},
      {"@type":"Question","name":"How quickly can I get approved for roof financing?","acceptedAnswer":{"@type":"Answer","text":"Most of our partners return decisions in minutes once you apply. Enhancify's prequalification takes about 60 seconds. We'll walk you through the application after your free estimate so you know exactly which partner is the best fit before you fill anything out."}}
    ]
  }]`;
---

<BaseLayout
  title="Roof Financing in Tampa Bay | Happy Roof"
  description="Flexible roof financing from Happy Roof. We work with Service Finance, GreenSky, and Enhancify to match you with the right lender for your project, credit profile, and timeline. Start with a free estimate."
  canonical="https://happyroof.com/finance"
  ogTitle="Roof Financing | Happy Roof Tampa Bay"
  ogDescription="Flexible roof financing with Service Finance, GreenSky, and Enhancify. We match you with the right lender. Start with a free estimate."
  activePage="finance"
  schema={schema}
>

<style is:inline>
    .fin-hero-grad{background:linear-gradient(135deg,rgba(230,168,23,.08) 0%,rgba(59,159,217,.06) 100%)}
    .part-card{background:#FFFFFF;border:1px solid #E0E0E0;border-radius:18px;padding:1.75rem;display:flex;flex-direction:column;transition:border-color .22s ease,transform .22s cubic-bezier(.34,1.56,.64,1),box-shadow .22s ease}
    .part-card:hover{border-color:#3B9FD9;transform:translateY(-3px);box-shadow:0 18px 44px -18px rgba(0,0,0,.18)}
    .part-logo-box{height:72px;display:flex;align-items:center;justify-content:flex-start;margin-bottom:1rem}
    .part-logo-box img{max-height:40px;max-width:200px;width:auto;height:auto;display:block;object-fit:contain}
    .part-scope{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:#3B9FD9;margin-bottom:.55rem}
    .part-headline{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.4rem;line-height:1.15;letter-spacing:-.005em;color:#1A1A1A;margin:0 0 .75rem}
    .part-body{color:#555555;font-size:.95rem;line-height:1.65;margin:0 0 1.25rem;flex:1}
    .part-link{display:inline-flex;align-items:center;gap:.35rem;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.82rem;letter-spacing:.1em;text-transform:uppercase;color:#555;text-decoration:none;transition:color .18s ease}
    .part-link:hover{color:#3B9FD9}
    .fin-step{background:#FFFFFF;border:1px solid #E0E0E0;border-radius:14px;padding:1.5rem;display:flex;flex-direction:column;gap:.75rem}
    .fin-step-num{width:40px;height:40px;border-radius:10px;background:rgba(230,168,23,.12);color:#E6A817;font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.3rem;display:flex;align-items:center;justify-content:center}
    .fin-faq{background:#FFFFFF;border:1px solid #E0E0E0;border-radius:12px;margin-bottom:.65rem;overflow:hidden;cursor:pointer;transition:border-color .2s}
    .fin-faq:hover{border-color:rgba(230,168,23,.3)}
    .fin-faq-q{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;gap:.75rem}
    .fin-faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease,padding .35s ease;padding:0 1.25rem}
    .fin-faq.open .fin-faq-a{max-height:500px;padding:0 1.25rem 1.1rem}
    .fin-faq-arr{transition:transform .25s ease;flex-shrink:0}
    .fin-faq.open .fin-faq-arr{transform:rotate(180deg)}
    .tb {display:flex;align-items:center;gap:.7rem;padding:.7rem 1rem;background:#FFFFFF;border:1px solid #E0E0E0;border-radius:10px;min-width:170px;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
    .tb:hover {transform:translateY(-2px);box-shadow:0 8px 20px -6px rgba(26,26,26,.12);border-color:#CFCFCF}
    .tb-icon {width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .tb-name {font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:.92rem;color:#1A1A1A;letter-spacing:.015em;margin:0;line-height:1.1}
    .tb-sub {font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:.7rem;color:#888;letter-spacing:.06em;text-transform:uppercase;margin:.2rem 0 0;line-height:1.15}
    .tb-emblem .tb-icon {width:44px;height:44px;border-radius:10px}
    .tb-emblem .tb-name {font-size:1rem;letter-spacing:.02em}
    .tb-eyebrow {text-align:center;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:#888;margin:0 0 1.15rem}
    a.tb {text-decoration:none;color:inherit}
    .tb-seal-img {height:44px;width:80px;object-fit:contain;object-position:center;display:block}
    @media (max-width:640px) {.tb {min-width:0;flex:1 1 calc(50% - .35rem)} .tb-name {font-size:.85rem} .tb-sub {font-size:.65rem}}
</style>

<!-- HERO -->
<section class="pt-32 pb-16 relative overflow-hidden fin-hero-grad" style="border-bottom:1px solid #E5E5E5">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/architectural-shingle-roof-tampa-bay.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-5xl mx-auto px-5 text-center">
    <p class="sl mb-4" style="color:#E6A817">Roofing Financing</p>
    <h1 class="font-display font-black mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.8rem,7vw,5.2rem);line-height:.9;letter-spacing:-.01em;color:#1A1A1A">
      FLEXIBLE WAYS TO PAY<br/><span style="color:#3B9FD9">FOR YOUR NEW ROOF.</span>
    </h1>
    <p style="font-size:1.1rem;color:#555555;line-height:1.75;max-width:640px;margin:0 auto 2rem">
      Happy Roof partners with three of the top home-improvement lenders so you have real options, whether that's the fastest approval, the lowest APR, or the longest term. Start with a free estimate and we'll help you figure out which fits best.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/contact" class="btn-t" style="font-size:1.1rem;padding:1rem 2.25rem">Get a Free Estimate <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      <a href="tel:8135957663" class="btn-o call-tracking-number" style="font-size:1rem;padding:.95rem 2rem">Call (813) 595-7663</a>
    </div>
  </div>
</section>

<!-- Trust Signals — Accreditations + Credentials -->
<section aria-labelledby="finance-trust-heading" style="background:#F7F7F7;border-top:1px solid #E0E0E0;border-bottom:1px solid #E0E0E0;padding:1.75rem 0">
  <div class="max-w-7xl mx-auto px-5">
    <p id="finance-trust-heading" class="tb-eyebrow">Accreditations &amp; Credentials</p>
    <div style="display:flex;flex-wrap:wrap;align-items:stretch;justify-content:center;gap:.7rem">
      <a class="tb tb-emblem" href="https://www.bbb.org/us/fl/oldsmar/profile/roofing-contractors/happy-roof-llc-0653-90461345" target="_blank" rel="noopener noreferrer" aria-label="BBB Accredited Business">
        <img class="tb-seal-img" src="https://m.bbb.org/brand/seals/Accredited_Business_Seal_NoRating_RGB.svg" alt="BBB Accredited Business" width="80" height="44" loading="eager" />
        <div><p class="tb-name">Accredited</p><p class="tb-sub">Verify on BBB.org &rarr;</p></div>
      </a>
      <div class="tb tb-emblem" role="group" aria-label="Owens Corning Preferred Contractor">
        <div class="tb-icon" style="background:rgba(232,65,90,0.10);color:#E8415A" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg></div>
        <div><p class="tb-name">Preferred Contractor</p><p class="tb-sub">Owens Corning</p></div>
      </div>
      <a class="tb tb-emblem" href="/gonano" aria-label="Certified GoNano Contractor for GoNano NuRoof" style="text-decoration:none;color:inherit">
        <div class="tb-icon" style="background:rgba(103,92,231,0.12);color:#675CE7" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="18" r="2.5"/><circle cx="12" cy="12" r="2.5"/><path d="M8.1 7.5l2.1 3M15.9 7.5l-2.1 3M8.1 16.5l2.1-3M15.9 16.5l-2.1-3"/></svg></div>
        <div><p class="tb-name">Certified Contractor</p><p class="tb-sub">GoNano NuRoof</p></div>
      </a>
      <div class="tb" role="group" aria-label="Florida Licensed Roofing Contractor">
        <div class="tb-icon" style="background:rgba(59,159,217,0.10);color:#3B9FD9" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></div>
        <div><p class="tb-name">FL Licensed</p><p class="tb-sub">CCC1337380</p></div>
      </div>
      <div class="tb" role="group" aria-label="Fully insured">
        <div class="tb-icon" style="background:rgba(230,168,23,0.12);color:#E6A817" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <div><p class="tb-name">Insured</p><p class="tb-sub">General liability + WC</p></div>
      </div>
    </div>
  </div>
</section>

<!-- THREE PARTNERS -->
<section style="background:#FFFFFF;padding:5rem 0">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-12">
      <p class="sl gt mb-3">Three Partners, More Approvals</p>
      <h2 class="font-display font-black" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.2rem,4vw,3.4rem);line-height:.95;letter-spacing:-.01em;color:#1A1A1A">
        WE WORK WITH THREE LENDERS<br/><span style="color:#3B9FD9">SO YOU HAVE OPTIONS.</span>
      </h2>
      <p style="color:#555555;font-size:1.05rem;line-height:1.75;max-width:640px;margin:1.25rem auto 0">
        Different projects, credit profiles, and timelines fit different lenders. Instead of routing every homeowner through a single partner, we pick the one that fits your situation after we quote your roof.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      <!-- SERVICE FINANCE -->
      <article class="part-card">
        <div class="part-logo-box"><img src="/Brand%20Assets/finance-partners/service-finance.png" alt="Service Finance Company" loading="lazy" /></div>
        <p class="part-scope">For Roof Replacements</p>
        <h3 class="part-headline">Service Finance</h3>
        <p class="part-body">
          Our go-to lender for full roof replacements. Built for larger project amounts with long terms and promotional 0% APR options for qualified homeowners.
        </p>
        <a class="part-link" href="https://www.svcfin.com" target="_blank" rel="noopener noreferrer">
          Learn more at svcfin.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
        </a>
      </article>

      <!-- GREENSKY -->
      <article class="part-card">
        <div class="part-logo-box"><img src="/Brand%20Assets/finance-partners/greensky.svg" alt="GreenSky" loading="lazy" /></div>
        <p class="part-scope">For GoNano NuRoof Projects</p>
        <h3 class="part-headline">GreenSky</h3>
        <p class="part-body">
          Our financing partner for GoNano NuRoof treatments. Streamlined approvals designed to fit coating and roof-extension projects.
        </p>
        <a class="part-link" href="https://www.greensky.com" target="_blank" rel="noopener noreferrer">
          Learn more at greensky.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
        </a>
      </article>

      <!-- ENHANCIFY -->
      <article class="part-card">
        <div class="part-logo-box"><img src="/Brand%20Assets/finance-partners/enhancify.png" alt="Enhancify" loading="lazy" style="max-height:28px" /></div>
        <p class="part-scope">Quick &amp; Easy</p>
        <h3 class="part-headline">Enhancify</h3>
        <p class="part-body">
          The fastest soft-pull prequalification we offer. Great if you want to see your rate in about 60 seconds before we come out for your free estimate.
        </p>
        <a class="part-link" href="https://www.enhancify.com" target="_blank" rel="noopener noreferrer">
          Learn more at enhancify.com
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
        </a>
      </article>
    </div>

    <p style="text-align:center;color:#888;font-size:.82rem;margin-top:1.75rem;max-width:640px;margin-left:auto;margin-right:auto;line-height:1.6">
      All three partners offer soft-pull prequalification, which means checking your rate will not affect your credit score. Terms, APR, and approval are determined by each lender.
    </p>
  </div>
</section>

<!-- HOW IT WORKS -->
<section style="background:#F7F7F7;padding:5rem 0;border-top:1px solid #E0E0E0">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-10">
      <p class="sl gt mb-3">How It Works</p>
      <h2 class="font-display font-black" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.2rem,4vw,3.2rem);line-height:.95;letter-spacing:-.01em;color:#1A1A1A">
        FROM ESTIMATE TO FINANCED<br/><span style="color:#E6A817">IN THREE STEPS.</span>
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="fin-step">
        <div class="fin-step-num">1</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin:0">Request a free estimate</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.65;margin:0">Call us or submit the contact form. We come out, inspect the roof, and send you a written estimate within one business day.</p>
      </div>
      <div class="fin-step">
        <div class="fin-step-num">2</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin:0">Pick the right partner together</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.65;margin:0">We walk you through which of our three partners fits your project cost, credit profile, and timeline best. No pressure, no up-sell.</p>
      </div>
      <div class="fin-step">
        <div class="fin-step-num">3</div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin:0">Apply and schedule the work</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.65;margin:0">You submit the application to the partner we picked together. Most decisions come back the same day, and we schedule installation as soon as you're approved.</p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section style="background:#FFFFFF;padding:5rem 0;border-top:1px solid #E0E0E0">
  <div class="max-w-3xl mx-auto px-5">
    <div class="text-center mb-10">
      <p class="sl gt mb-3">Common Questions</p>
      <h2 class="font-display font-black" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.2rem,4vw,3.2rem);line-height:.95;letter-spacing:-.01em;color:#1A1A1A">FINANCING FAQ</h2>
    </div>
    <div class="fin-faq" onclick="this.classList.toggle('open')"><div class="fin-faq-q"><p class="font-medium text-sm" style="color:#1A1A1A;margin:0">Does checking my rate affect my credit score?</p><svg class="fin-faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="fin-faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem;margin:0">No. All three of our financing partners start with a soft credit check that doesn't affect your credit score. You only move to a hard pull if you decide to proceed with a formal application.</p></div></div>
    <div class="fin-faq" onclick="this.classList.toggle('open')"><div class="fin-faq-q"><p class="font-medium text-sm" style="color:#1A1A1A;margin:0">What credit score do I need to qualify?</p><svg class="fin-faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="fin-faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem;margin:0">Our three partners cover a wide range of credit profiles, which is one of the reasons we work with multiple lenders. The best way to find out what you qualify for is to request an estimate so we can match you with the right partner for your situation.</p></div></div>
    <div class="fin-faq" onclick="this.classList.toggle('open')"><div class="fin-faq-q"><p class="font-medium text-sm" style="color:#1A1A1A;margin:0">Can I finance a roof repair or just a replacement?</p><svg class="fin-faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="fin-faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem;margin:0">Financing is available for both replacements and larger repair projects. Minimum project amounts may apply depending on the financing partner.</p></div></div>
    <div class="fin-faq" onclick="this.classList.toggle('open')"><div class="fin-faq-q"><p class="font-medium text-sm" style="color:#1A1A1A;margin:0">How quickly can I get approved?</p><svg class="fin-faq-arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="fin-faq-a"><p style="color:#555555;font-size:.88rem;line-height:1.7;padding-top:.5rem;margin:0">Most of our partners return decisions in minutes once you apply. Enhancify's prequalification takes about 60 seconds. We'll walk you through the application after your free estimate so you know exactly which partner is the best fit before you fill anything out.</p></div></div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="cta-grad relative overflow-hidden py-20">
  <div class="relative z-10 max-w-3xl mx-auto px-5 text-center">
    <h2 class="font-display font-black tracking-tightest mb-4" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.5rem,5vw,4.5rem);line-height:.92;letter-spacing:-.01em">NOT SURE WHICH OPTION<br/>IS RIGHT<span style="color:#F0C040">?</span></h2>
    <p style="color:rgba(255,248,240,.85);font-size:1rem;line-height:1.75;margin-bottom:2rem;max-width:540px;margin-left:auto;margin-right:auto">Start with a free estimate. We'll quote your roof, walk through which partner fits best, and help you through the application if you want to move forward.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/contact" class="btn-t" style="font-size:1.15rem;padding:1rem 2.5rem">Get My Free Estimate <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      <a href="tel:8135957663" class="btn-o call-tracking-number" style="font-size:1.05rem;padding:1rem 2.5rem">Call (813) 595-7663</a>
    </div>
  </div>
</section>

</BaseLayout>
