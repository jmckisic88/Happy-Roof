---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "RoofingContractor"],
    "name": "Happy Roof LLC",
    "url": "https://happyroof.com",
    "telephone": "+1-813-595-7663",
    "email": "info@happyroof.com",
    "description": "Tampa Bay commercial roofing contractor specializing in TPO, EPDM, modified bitumen, and metal roofing systems for businesses. FL License #CCC1337380.",
    "image": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "logo": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "141 Stevens Ave #12","addressLocality": "Oldsmar",
      "addressRegion": "FL","postalCode": "34677","addressCountry": "US"
    },
    "hasCredential": "Florida Roofing Contractor License #CCC1337380",
    "dateModified": "2026-04-25"
  },{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What Types of Commercial Roofing Does Happy Roof Install?",
        "acceptedAnswer": { "@type": "Answer", "text": "Happy Roof installs TPO (thermoplastic polyolefin), EPDM (ethylene propylene diene monomer), modified bitumen, built-up roofing (BUR), and standing seam metal roofing for commercial properties in Tampa Bay. We work with warehouses, retail centers, offices, multi-family buildings, HOA properties, and industrial facilities." }
      },
      {
        "@type": "Question",
        "name": "How Long Does a Commercial Roof Replacement Take?",
        "acceptedAnswer": { "@type": "Answer", "text": "Generally speaking, it depends on the building's size and the system being installed. That said, a typical 10,000 square foot TPO or EPDM installation will usually take five to ten business days. We may recommend phasing larger or more complex projects to reduce any disruption." }
      },
      {
        "@type": "Question",
        "name": "Do You Offer Warranties on Commercial Roofing?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every flat roof installation, including TPO, EPDM, and modified bitumen, comes with our 10-year workmanship warranty in writing. Commercial metal roofing comes with up to a 15-year workmanship warranty. Both are backed by manufacturer material warranties of 20 to 30 years, depending on the system. You'll receive all of this in writing before we close out the job." }
      },
      {
        "@type": "Question",
        "name": "Can You Work Around Our Business Hours to Minimize Disruption?",
        "acceptedAnswer": { "@type": "Answer", "text": "Definitely. We understand that operations don't stop for a roof, so we offer phased scheduling and early morning or weekend work windows for occupied buildings. We'll also always make sure to coordinate with you and any project managers or tenants before and during the project, so there are no surprises." }
      },
      {
        "@type": "Question",
        "name": "Do You Handle Commercial Roof Maintenance and Inspections?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Happy Roof offers commercial inspection and preventative maintenance programs. We typically recommend scheduling inspections at least twice a year to catch things like membrane tears, ponding water, and flashing separation before they turn into expensive repairs. Most manufacturer warranties also require documented maintenance to stay valid." }
      },
      {
        "@type": "Question",
        "name": "What TPO Roof Maintenance Should Florida Commercial Building Owners Do?",
        "acceptedAnswer": { "@type": "Answer", "text": "A Florida TPO roof needs a layered maintenance schedule to hit its 20 to 30 year lifespan. QUARTERLY: ground-level visual inspection for punctures, blisters, seam separation, and standing water; clear all roof drains, scuppers, and downspouts (blocked drainage is the single biggest cause of premature TPO failure in Florida). SEMI-ANNUAL: check flashings and sealants around HVAC units, vent stacks, skylights, and any roof penetrations for cracks or lifting. ANNUAL PRE-HURRICANE (May): professional inspection of heat-welded seams for creep or opening (required to protect most material warranties). ANNUAL POST-HURRICANE (Nov/Dec): full assessment of any wind damage. EVERY 3 TO 5 YEARS: consider a manufacturer-approved TPO coating or restoration to extend membrane life. Happy Roof's commercial maintenance program covers all of this on a documented schedule." }
      },
      {
        "@type": "Question",
        "name": "What Are Some Common TPO Roof Maintenance Mistakes to Avoid?",
        "acceptedAnswer": { "@type": "Answer", "text": "A few small mistakes account for the majority of premature TPO failures in Florida. Walking on TPO in high heat: surface temperatures can exceed 150 degrees on summer afternoons, and foot traffic causes permanent indentations that become future leak points. Ignoring ponding water for more than 48 hours: standing water accelerates membrane deterioration by up to three times as quickly. Using solvent-based cleaners: degreasers, gasoline, and most industrial cleaners can cause TPO to swell and lift; use manufacturer-approved cleaners only (typically water and mild detergent). Skipping annual professional inspection: small seam separations are the most common TPO failure mode and can go undetected at ground level until they become full leaks. DIY silicone caulk patches: silicone doesn't permanently bond to TPO, and DIY caulk patches usually fail within 6 to 12 months and may void the manufacturer's warranty. TPO repairs generally require a specific primer and heat-welded, TPO-compatible cover strips." }
      }
    ]
  },{
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Commercial Roofing",
    "provider": { "@type": "RoofingContractor", "name": "Happy Roof LLC", "telephone": "+1-813-595-7663", "url": "https://happyroof.com" },
    "areaServed": { "@type": "State", "name": "Florida" },
    "description": "Complete commercial roofing services in Tampa Bay including TPO, EPDM, modified bitumen, and metal roofing systems. Phased scheduling for minimal business disruption. 10-year flat roof workmanship warranty."
  },{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://happyroof.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://happyroof.com/services"},{"@type":"ListItem","position":3,"name":"Commercial Roofing","item":"https://happyroof.com/commercial-roofing"}]},{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Commercial Roofing",
    "description": "Commercial roofing services in Tampa Bay including TPO, EPDM, modified bitumen, and metal roofing systems for businesses.",
    "provider": {"@type": "RoofingContractor", "name": "Happy Roof LLC"},
    "areaServed": {"@type": "City", "name": "Tampa Bay"},
    "offers": {
      "@type": "Offer",
      "priceRange": "$12,000 - $50,000",
      "priceCurrency": "USD"
    },
    "termsOfService": "Up to 10-year workmanship warranty on flat roof systems"
  }]`;
---

<BaseLayout
  title="Commercial Roofing in Tampa Bay | Happy Roof"
  description="Need a commercial roofing contractor in the Tampa Bay area? We specialize in everything from roof replacement to repairs. Get in touch for an estimate!"
  canonical="https://happyroof.com/commercial-roofing"
  ogTitle="Commercial Roofing Tampa Bay | Happy Roof"
  ogDescription="Commercial roofing in Tampa Bay. TPO, EPDM, modified bitumen, metal. 10-year warranty. Minimal disruption."
  schema={schema}
>

<style is:inline>
.check-dot{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(245,184,0,.1);flex-shrink:0;margin-top:.15rem}
    .step-num{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(245,184,0,.1);font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.25rem;color:#F5B800;flex-shrink:0}
</style>

<section class="relative overflow-hidden" style="padding:8rem 0 5rem;background:#FFFFFF">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/architectural-shingle-roof-tampa-bay.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-5 text-center">
    <p class="sl gp mb-4">Commercial Roofing</p>
    <h1 class="font-display font-black tracking-tightest mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(3rem,6vw,5rem);line-height:.92;letter-spacing:-.01em;color:#1A1A1A">
      COMMERCIAL ROOFING IN<br/><span class="gt">TAMPA BAY.</span>
    </h1>
    <p class="max-w-2xl mx-auto" style="color:#555555;font-size:1.05rem;line-height:1.75">
      When your commercial roof has a problem, it usually doesn't stay a small one for long. Happy Roof has been taking care of commercial properties across Tampa Bay for years, and we're here to help whether you need a repair, a replacement, or just want to know what shape your roof is in. For a detailed breakdown of each system, read our guide to <a href="/blog/commercial-roofing-types" style="color:#3B9FD9;text-decoration:none;font-weight:600">commercial roofing systems explained</a>.
    </p>
  </div>
</section>

<!-- INFO STRIP -->
<div style="background:#FFFFFF;border-top:2px solid #F5B800;border-bottom:1px solid #E0E0E0;padding:.85rem 0">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-display font-bold text-sm tracking-widest" style="color:#1A1A1A;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif">
      <span>Tampa Bay, FL</span>
      <span style="color:#F5B800">·</span>
      <span>CCC1337380</span>
      <span style="color:#F5B800">·</span>
      <span>HappyRoof.com</span>
      <span style="color:#F5B800">·</span>
      <span style="color:#5AAFE0">(813) 595-7663</span>
    </div>
  </div>
</div>

<!-- SERVICES WE PROVIDE -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-4xl mx-auto px-5">
    <div class="text-center mb-8">
      <p class="sl gt mb-3">What We Do</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">COMMERCIAL ROOFING SERVICES WE PROVIDE</h2>
    </div>
    <div style="color:#555555;font-size:1.05rem;line-height:1.8">
      <p style="margin-bottom:1.25rem">We work with property owners, building managers, and business owners on everything from single-tenant offices to large-scale warehouses and multi-unit commercial properties. Our commercial roofing services include full replacements, repairs, and ongoing maintenance and inspection programs.</p>
      <p>If the damage is covered by insurance, we'll document everything and can meet with your adjusters on-site to make sure nothing gets missed. If it's a repair, we'll tell you what actually needs to be done and what can wait.</p>
    </div>
  </div>
</section>

<!-- ROOFING SYSTEMS -->
<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">Systems We Install</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">COMMERCIAL ROOFING SYSTEMS WE INSTALL</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-8">

      <!-- TPO -->
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(245,184,0,.1);margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">TPO Roofing</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">
          TPO is the most widely used commercial roofing membrane in Florida. It's highly reflective, which can reduce cooling costs by up to 30% in Tampa Bay's climate, and it holds up well against UV exposure and the kind of chemical runoffs that are common around HVAC equipment. Happy Roof installs mechanically fastened and fully adhered TPO systems with heat-welded seams that create a watertight bond that's even stronger than the membrane itself.
        </p>
      </div>

      <!-- EPDM -->
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(245,184,0,.1);margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">EPDM Roofing</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">
          EPDM is a synthetic rubber membrane that's also durable and resistant to ozone and weathering, which makes it a great long-term option for flat and low-slope commercial roofs. We install ballasted, mechanically attached, and fully adhered EPDM systems. EPDM is available in black or white, and it's particularly well-suited for larger buildings like warehouses and industrial facilities where cost per square foot usually matters the most.
        </p>
      </div>

      <!-- Modified Bitumen -->
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(245,184,0,.1);margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Modified Bitumen</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">
          Modified bitumen systems layer multiple materials to create a roof with built-in redundancy, which is pretty much exactly what you want on a building exposed to temperature swings and storm seasons. We install torch-applied, cold-applied, and self-adhered modified bitumen from top manufacturers, and they're a reliable option for any commercial property that needs a dependable flat roof system without a lot of complexity.
        </p>
      </div>

      <!-- Metal -->
      <div class="scard p-8">
        <div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(245,184,0,.1);margin-bottom:1rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Commercial Metal Roofing</h3>
        <p style="color:#555555;font-size:.95rem;line-height:1.7">
          Standing seam and R-panel metal systems are known for lasting 40 to 60 years and handling high winds better than most other systems. At Happy Roof, we install Gulf Coast Supply panels, including GulfLok, GulfSeam, GulfRib, and MegaLoc, all of which are engineered for Florida's building codes and climate. Metal roofing tends to be ideal for retail centers, churches, restaurants, and any commercial property that wants a low-maintenance, yet highly durable, option.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- WHY CHOOSE US -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-12">
      <p class="sl gt mb-3">The Happy Roof Difference</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.25rem">WHY BUSINESSES CHOOSE HAPPY ROOF</h2>
      <div style="max-width:760px;margin:0 auto;color:#555555;font-size:1rem;line-height:1.75;text-align:left">
        <p style="margin-bottom:1rem">Choosing the right contractor matters. We're licensed, insured, and experienced with all types of commercial roofing systems, and we only use materials built to hold up in Florida's climate. Every project is managed by an experienced foreman from start to finish, and we handle all permits and county inspections ourselves so you're not chasing paperwork.</p>
        <p>We also understand that a roofing project on an occupied building is a different situation than an empty one. We work around your schedule and make sure tenants and property managers know what to expect before we start.</p>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="scard p-7">
        <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Minimal Business Disruption</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We offer phased scheduling, early-morning and weekend work windows, and noise-sensitive installation methods for occupied buildings. Your operations come first.</p></div></div>
      </div>
      <div class="scard p-7">
        <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">On-Time Delivery</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We provide a detailed project timeline during the proposal phase and stick to it. If weather or supply delays arise, we communicate immediately and adjust proactively.</p></div></div>
      </div>
      <div class="scard p-7">
        <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">10-Year Flat Roof Warranty</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Every flat roof installation (TPO, EPDM, modified bitumen) comes with our 10-year workmanship warranty in writing - plus manufacturer material warranties.</p></div></div>
      </div>
      <div class="scard p-7">
        <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Licensed & Fully Insured</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">FL Roofing Contractor License #CCC1337380 with full general liability and workers' compensation insurance. COI available on request for property managers.</p></div></div>
      </div>
      <div class="scard p-7">
        <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Licensed, Insured Crews</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Every crew member is fully licensed and insured. We oversee every commercial project from start to finish for consistent quality and accountability.</p></div></div>
      </div>
      <div class="scard p-7">
        <div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F5B800" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Maintenance Programs</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We offer ongoing maintenance and inspection programs to extend the life of your commercial roof. Catch small problems before they become expensive repairs.</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">How It Works</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">HOW OUR COMMERCIAL ROOF PROCESS WORKS</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="scard p-8 flex gap-5">
        <div class="step-num">1</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Site Assessment & Proposal</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">We start with an on-site evaluation where we assess the existing roof system, drainage, insulation, and any problem areas you've made note of. For occupied buildings, we'll go over scheduling options before anything gets written up. You'll receive a detailed written proposal with system options, specs, timeline, and pricing.</p>
        </div>
      </div>
      <div class="scard p-8 flex gap-5">
        <div class="step-num">2</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">System Design & Permitting</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">Once the scope is approved, we'll order material directly from the manufacturer and handle all permit applications with the local building department. We also coordinate with your property manager or facilities team so the schedule minimizes impact on your operations.</p>
        </div>
      </div>
      <div class="scard p-8 flex gap-5">
        <div class="step-num">3</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Professional Installation</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">Whether it's a full replacement or storm work, the same standards apply. Our crew installs to manufacturer specs and local code and will make sure to give you regular progress updates. We keep a clean, safe job site throughout the project.</p>
        </div>
      </div>
      <div class="scard p-8 flex gap-5">
        <div class="step-num">4</div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Inspection, Warranty & Follow-Up</h3>
          <p style="color:#555555;font-size:.95rem;line-height:1.7">After the work is done, we'll hand over your workmanship warranty and manufacturer material warranty in writing before we close out the job. We also always follow up at the 30 day mark and can put together an ongoing maintenance schedule if that's something you want going forward.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICE AREA -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-10">
      <p class="sl gt mb-3">Coverage Area</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1rem">AREAS WE SERVE ACROSS TAMPA BAY</h2>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:700px;margin:0 auto">We provide commercial roofing services to buildings across Tampa Bay, including Pinellas, Hillsborough, and Pasco counties.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 max-w-4xl mx-auto">
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Tampa</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">St. Petersburg</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Clearwater</span>
      <span class="scard px-4 py-3 text-center" style="font-size:.9rem;font-weight:600">Brandon</span>
