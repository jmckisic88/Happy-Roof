import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{"@context":"https://schema.org","@type":["LocalBusiness","RoofingContractor"],"name":"Happy Roof LLC","url":"https://happyroof.com","telephone":"+1-813-595-7663","email":"info@happyroof.com","description":"Palm Harbor roofing contractor. Owens Corning Preferred Contractor installing shingle, metal, and tile roofing systems with up to a 15-year workmanship warranty. Licensed and insured. FL License #CCC1337380.","image":"/Brand%20Assets/Happy%20Roof%20Logo.jpeg","logo":"/Brand%20Assets/Happy%20Roof%20Logo.jpeg","address":{"@type":"PostalAddress","streetAddress":"141 Stevens Ave #12","addressLocality":"Oldsmar","addressRegion":"FL","postalCode":"34677","addressCountry":"US"},"areaServed":{"@type":"City","name":"Palm Harbor","containedInPlace":{"@type":"State","name":"Florida"}},"hasCredential":"Florida Roofing Contractor License #CCC1337380","dateModified":"2026-04-10"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {"@type":"Question","name":"How much does a roof replacement cost in Palm Harbor?","acceptedAnswer":{"@type":"Answer","text":"Most Palm Harbor residential replacements run between $8,500 and $25,000 for an average-sized home, depending on roof size, pitch, and material. Homes in communities like Innisbrook and East Lake tend to have larger footprints, which affects the total. Happy Roof provides free, detailed estimates at (813) 595-7663."}},
    {"@type":"Question","name":"How long do roof replacements take in Palm Harbor?","acceptedAnswer":{"@type":"Answer","text":"Shingle replacements typically take one to three days, metal usually runs about three to five, and tile will likely take between five to seven days depending on complexity."}}
  ]}]`;
---

<BaseLayout
  title="Palm Harbor Roofing Contractor | Happy Roof"
  description="Looking for a Palm Harbor roofing contractor? Happy Roof provides residential and commercial services throughout the area. Contact us today!"
  canonical="https://happyroof.com/palm-harbor-roofing"
  ogTitle="Palm Harbor Roofing Contractor | Happy Roof"
  ogDescription="Licensed Palm Harbor roofer for replacements, repairs & storm damage. Free estimates.  Call (813) 595-7663."
  schema={schema}
>

<style is:inline>
.check-dot{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);flex-shrink:0;margin-top:.15rem}
    .step-num{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.25rem;color:#E6A817;flex-shrink:0}
</style>

<section class="pt-32 pb-20 relative overflow-hidden" style="background:#F5F5F5;border-bottom:1px solid #E5E5E5">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/commercial-tpo-roof-tampa.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-5 text-center">
    <p class="sl gp mb-4">Palm Harbor Roofing</p>
    <h1 class="font-display font-black tracking-tightest mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:.92;letter-spacing:-.01em;color:#1A1A1A">PALM HARBOR ROOFING CONTRACTOR<br/><span class="gt">LICENSED & INSURED</span></h1>
    <p class="max-w-2xl mx-auto" style="color:#555555;font-size:1.05rem;line-height:1.75">Palm Harbor covers a lot of ground, whether you're near the waterfront streets of Crystal Beach and Ozona or the golf-course communities of Innisbrook. While each area has its own character, a lot of the homes here were built in the 1980s and 1990s, and many of those roofs are now reaching the point where repairs become more frequent, or replacement starts to make more sense. Happy Roof works with homeowners throughout Palm Harbor on everything from leak repairs to full roof replacements and storm-related damage.</p>
    <div class="flex flex-wrap gap-3 justify-center mt-8"><a href="/contact" class="btn-t">Get a Free Estimate <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a><a href="tel:8135957663" class="btn-o call-tracking-number">Call (813) 595-7663</a></div>
  </div>
</section>

<div style="background:#FFFFFF;border-top:2px solid #E6A817;border-bottom:1px solid #E0E0E0;padding:.85rem 0"><div class="max-w-7xl mx-auto px-5"><div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-display font-bold text-sm tracking-widest" style="color:#1A1A1A;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif"><span>Palm Harbor, FL</span><span style="color:#E6A817">·</span><span>CCC1337380</span><span style="color:#E6A817">·</span><span>HappyRoof.com</span><span style="color:#E6A817">·</span><span style="color:#3B9FD9">(813) 595-7663</span></div></div></div>

<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <p class="sl gt mb-3">Why Palm Harbor homeowners call us</p>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.5rem">WHY PALM HARBOR HOMEOWNERS CALL HAPPY ROOF</h2>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          Palm Harbor is an unincorporated community, which means the permitting process runs through Pinellas County rather than a municipality. We handle all of that (applications, scheduling, inspections) ourselves, so you don't have to deal with it. Not only do we know the county's requirements, but we've been through the process enough times that it doesn't slow anything down for us.
        </p>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          Beyond the logistics, what we hear most from homeowners after the job is done is that we're upfront with them from the start. You'll always receive a written estimate before anything begins, and we'll never pressure you into using more expensive materials when something more affordable will do the job just as well. If your roof has been showing signs of wear, or something just feels off, <a href="/eco-friendly-roofing" style="color:#3B9FD9;text-decoration:none;font-weight:600">we can help you figure out what makes sense next</a>.
        </p>
      </div>
      <div class="space-y-4">
        <div class="scard p-6"><div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Owens Corning Preferred Contractor</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We're an Owens Corning Preferred Contractor and install all major shingle, metal, and tile brands so you can choose what fits your home and budget.</p></div></div></div>
        <div class="scard p-6"><div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Up to 15-Year Workmanship Warranty</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">Every Palm Harbor roof installation includes a written up to 15-year workmanship warranty on top of manufacturer material warranties.</p></div></div></div>
        <div class="scard p-6"><div class="check"><div class="check-dot"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg></div><div><strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem">Pinellas County Permits Handled</strong><p style="color:#555555;font-size:.9rem;line-height:1.6;margin-top:.25rem">We manage all Pinellas County permit applications and inspections for Palm Harbor roofing projects, no hassle for you.</p></div></div></div>
      </div>
    </div>
  </div>
</section>

<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14"><p class="sl gt mb-3">Our Services</p><h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">ROOFING SERVICES WE OFFER IN PALM HARBOR</h2></div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="scard p-8"><div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Roof Repair</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">Whether it's a leak or flashing that's started to pull away from a vent or chimney, our team will find the source of the problem and fix it. We'll never tell you that your roof needs a full replacement when a repair is all it actually needs.</p></div>
      <div class="scard p-8"><div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Roof Replacement</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">Thinking your roof has been repaired one too many times? Our experienced team can handle the full replacement from start to finish. We install Owens Corning Duration shingles, Gulf Coast Supply standing seam and R-panel metal, and concrete and clay tile. We'll walk you through the tradeoffs between each before you make a decision.</p></div>
      <div class="scard p-8"><div style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);margin-bottom:1rem"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.35rem;color:#1A1A1A;margin-bottom:.75rem">Storm Damage & Insurance</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">Documentation matters almost as much as the repair when a named storm or tropical system comes through Palm Harbor. We can be with you on-site to assess the damage and during the adjuster inspection to make sure nothing gets missed. We also offer emergency tarping if you need to stop active intrusion while everything else gets sorted.</p></div>
    </div>
  </div>
</section>

<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14"><p class="sl gt mb-3">How It Works</p><h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">WHAT TO EXPECT WHEN YOU WORK WITH US</h2></div>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="scard p-8 flex gap-5"><div class="step-num">1</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Free Inspection and Estimate</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">We'll get on the roof and take a look at everything from the decking condition and underlayment to penetration and ventilation. You'll then receive a written estimate that details your material options, an estimated timeline, and a no-obligation quote.</p></div></div>
      <div class="scard p-8 flex gap-5"><div class="step-num">2</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Material Selection and Permits</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">If you decide to move forward with a full replacement, we'll help you choose the material and color and order what we need directly from the manufacturer. We'll also pull any required Pinellas County records at this stage.</p></div></div>
      <div class="scard p-8 flex gap-5"><div class="step-num">3</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Professional Installation</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">Our licensed crew will handle everything on the job, from tear-off through cleanup. We'll always do our part to protect your property and will do a walk-around before we leave to make sure everything's cleaned up.</p></div></div>
      <div class="scard p-8 flex gap-5"><div class="step-num">4</div><div><h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:#1A1A1A;margin-bottom:.5rem">Final Inspection and Warranty</h3><p style="color:#555555;font-size:.95rem;line-height:1.7">We'll schedule the county inspection, and you'll receive your roof's workmanship and manufacturer warranties in writing before we close out. A member of our team will follow up at the 30-day mark and again after a year to make sure everything's still holding up as it should.</p></div></div>
    </div>
  </div>
</section>

<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-10"><p class="sl gt mb-3">Palm Harbor Service Area</p><h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1rem">NEIGHBORHOODS WE SERVE IN PALM HARBOR</h2><p style="color:#555555;font-size:1rem;line-height:1.75;max-width:700px;margin:0 auto">Happy Roof serves every neighborhood in Palm Harbor and the surrounding upper Pinellas County communities.</p></div>
