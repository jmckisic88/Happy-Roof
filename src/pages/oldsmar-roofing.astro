import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{"@context":"https://schema.org","@type":["LocalBusiness","RoofingContractor"],"name":"Happy Roof LLC","url":"https://happyroof.com","telephone":"+1-813-595-7663","email":"info@happyroof.com","description":"Oldsmar roofing contractor and Happy Roof headquarters. Owens Corning Preferred Contractor installing shingle, metal, and tile roofing systems. Licensed and insured. FL License #CCC1337380.","image":"/Brand%20Assets/Happy%20Roof%20Logo.jpeg","logo":"/Brand%20Assets/Happy%20Roof%20Logo.jpeg","address":{"@type":"PostalAddress","streetAddress":"141 Stevens Ave #12","addressLocality":"Oldsmar","addressRegion":"FL","postalCode":"34677","addressCountry":"US"},"areaServed":{"@type":"City","name":"Oldsmar","containedInPlace":{"@type":"State","name":"Florida"}},"hasCredential":"Florida Roofing Contractor License #CCC1337380","dateModified":"2026-04-10"},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {"@type":"Question","name":"What roofing material works best for homes in Oldsmar?","acceptedAnswer":{"@type":"Answer","text":"It depends on the home and what matters most to you. Architectural shingles are one of the most popular choices because they are able to withstand Florida's heat and storm season. Metal roofs are another favorite if you are looking for something with a longer lifespan that can reflect heat. Happy Roof installs shingle, metal, and tile roofing systems and can walk you through your options."}},
    {"@type":"Question","name":"Does being near the bay affect roof lifespan in Oldsmar?","acceptedAnswer":{"@type":"Answer","text":"Yes. The combination of heat, humidity, and salt air can wear down roofs over time, especially if a roof is older or was built with lower-quality materials. Not every roof near the water will have issues, but the material you choose still matters."}},
    {"@type":"Question","name":"How much does a new roof cost in Oldsmar?","acceptedAnswer":{"@type":"Answer","text":"Most residential roof replacements in Oldsmar fall between $8,000 and $22,000, depending on the size of the roof, the material you select, and whether any underlying repairs are needed. A significant number of homes built in the 1970s through 1990s are now due for replacement. Happy Roof provides free, no-obligation estimates at (813) 595-7663."}},
    {"@type":"Question","name":"Does Happy Roof handle permits in Oldsmar?","acceptedAnswer":{"@type":"Answer","text":"Yes. If your Oldsmar roofing project requires a permit, we take care of the application and coordinate the inspection process with the City of Oldsmar at no extra charge."}},
    {"@type":"Question","name":"How soon can Happy Roof start on an Oldsmar roofing project?","acceptedAnswer":{"@type":"Answer","text":"It depends on the type of job and material availability. Most of the time we are able to begin within one to three weeks. We prioritize urgent storm-related issues and respond much sooner for emergencies."}}
  ]}]`;
---

<BaseLayout
  title="Oldsmar Roofing Company | Happy Roof"
  description="Having roof issues? Our Oldsmar roofing company provides everything from storm damage repairs to replacement services. Call today to learn more!"
  canonical="https://happyroof.com/oldsmar-roofing"
  ogTitle="Oldsmar Roofing Contractor | Happy Roof"
  ogDescription="Your local Oldsmar roofer. Happy Roof HQ. Replacements, repairs & storm damage. Free estimates."
  schema={schema}
>

<style is:inline>
.check-dot{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);flex-shrink:0;margin-top:.15rem}
    .step-num{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(230,168,23,.1);font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.25rem;color:#E6A817;flex-shrink:0}
</style>

<section class="pt-32 pb-20 relative overflow-hidden" style="background:#F5F5F5;border-bottom:1px solid #E5E5E5">
