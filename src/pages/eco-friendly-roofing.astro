---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = `[{
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "RoofingContractor"],
    "name": "Happy Roof LLC",
    "url": "https://happyroof.com",
    "telephone": "+1-813-595-7663",
    "email": "info@happyroof.com",
    "description": "Tampa Bay eco-friendly roofing contractor offering energy-efficient, sustainable roofing solutions. Cool roofs, metal roofing, solar-ready systems. FL License #CCC1337380.",
    "image": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "logo": "/Brand%20Assets/Happy%20Roof%20Logo.jpeg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "141 Stevens Ave #12","addressLocality": "Oldsmar",
      "addressRegion": "FL","postalCode": "34677","addressCountry": "US"
    },
    "hasCredential": "Florida Roofing Contractor License #CCC1337380",
    "dateModified": "2026-04-23"
  },{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the most energy-efficient roofing material for Florida?",
        "acceptedAnswer": { "@type": "Answer", "text": "Metal roofing with a reflective coating is the most energy-efficient option for Florida homes, reflecting up to 70% of solar energy and reducing cooling costs by 10–25%. Light-colored tile and cool-rated architectural shingles like Owens Corning Duration COOL are also excellent choices." }
      },
      {
        "@type": "Question",
        "name": "Can a new roof lower my energy bills in Tampa Bay?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. A new roof with proper ventilation, radiant barrier underlayment, and energy-efficient materials can reduce cooling costs by 10–25% annually. In Tampa Bay's climate, that can translate to $300–$800+ in yearly savings depending on your home's size and insulation." }
      },
      {
        "@type": "Question",
        "name": "Are metal roofs eco-friendly?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Metal roofs are made from 25–95% recycled content, are 100% recyclable at end of life, and last 40–70 years — significantly reducing waste compared to shingles that need replacing every 15–25 years. They also reflect solar heat, reducing energy consumption." }
      },
      {
        "@type": "Question",
        "name": "What is a cool roof and does it work in Florida?",
        "acceptedAnswer": { "@type": "Answer", "text": "A cool roof uses materials with high solar reflectance to absorb less heat. In Florida's intense sun, cool roofs can reduce roof surface temperatures by up to 50°F compared to standard dark shingles, significantly lowering AC costs. Metal, light-colored tile, and ENERGY STAR-rated shingles all qualify." }
      },
      {
        "@type": "Question",
        "name": "Does Happy Roof install solar-ready roofing systems?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Happy Roof installs roofing systems compatible with future solar panel installation, including reinforced decking and proper flashing prep. We coordinate with trusted local solar partners so your new roof and solar install happen seamlessly." }
      },
      {
        "@type": "Question",
        "name": "What is the best roofing material for solar panel installation?",
        "acceptedAnswer": { "@type": "Answer", "text": "Standing seam metal is the best roofing material for solar panel installation. Solar mounts clamp directly onto the metal seams without penetrating the roof, eliminating leak risk and preserving warranty. Asphalt shingles are the second-best option and the most common — installation is straightforward, but mounts require sealed penetrations. Concrete tile and clay tile work for solar but are more expensive to install panels on, often require special tile-replacement mounting systems, and are more labor-intensive. Avoid installing solar on a roof that's near the end of its lifespan — replace the roof first so the solar panels last as long as the roof underneath them." }
      },
      {
        "@type": "Question",
        "name": "Should I replace my roof before installing solar panels?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, if your roof is more than 10 years old or shows any signs of wear. Solar panels typically last 25-30 years, and removing them mid-life to replace the roof underneath costs $3,000-$8,000 in additional labor. The smart move is to replace your roof first with a long-lasting material (metal: 40-70 years, architectural shingles: 25-30 years), then install solar. Happy Roof can coordinate the timing with your solar installer so both projects align." }
      },
      {
        "@type": "Question",
        "name": "How does solar-ready roofing impact home value?",
        "acceptedAnswer": { "@type": "Answer", "text": "Solar-ready roofing typically adds 4–6% to home value in Florida markets, with the premium reflecting three factors: future-proofing (buyers know the roof is already reinforced for solar without paying for retrofit), lower projected energy costs that translate into appraised value, and stronger appeal to ENERGY STAR–conscious buyers. In Tampa Bay, where average AC costs run $1,800–$3,200/year, homes that are solar-ready or already have solar installed tend to sell faster than comparable non-solar homes. The roof itself contributes roughly $8,000–$18,000 in resale value depending on home size, finish, and material — metal and tile carry a higher premium than asphalt because of their longer service life relative to the solar panels mounted on them." }
      },
      {
        "@type": "Question",
        "name": "What are the pros and cons of different roof ventilation systems?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ridge + soffit ventilation is the gold standard for Florida homes — it uses passive convection (hot air rises out the ridge, cool air enters through the soffits) with no moving parts, minimal maintenance, and works as long as your roof has a continuous ridge line. Power attic fans (electric or solar) can drop attic temps 20–30°F on the hottest days but short-cycle conditioned air if soffit intake is undersized, and add a small maintenance burden. Turbine (whirlybird) vents are cheap and need no power, but their effectiveness depends on wind and they generally underperform continuous ridge venting. Off-ridge box vents work where roof geometry doesn't allow a continuous ridge vent but provide less exhaust per square foot. Gable vents support cross-flow but can short-circuit ridge/soffit systems. The best Florida setup is balanced ridge + soffit, with a solar-powered attic fan only as a supplement when ridge length is limited." }
      },
      {
        "@type": "Question",
        "name": "What roofing technology innovations are changing the industry in 2026?",
        "acceptedAnswer": { "@type": "Answer", "text": "Roofing in 2026 looks materially different from five years ago. The biggest changes: (1) AI-powered drone inspections that capture every square foot in 4K and run computer-vision damage detection in seconds, flagging granule loss, lifted shingles, and hail bruising the human eye misses from the ground; (2) satellite-based measurement platforms (EagleView, Hover) that produce accurate roof reports — area, pitch, facets, material — in 30 seconds instead of 30 minutes on a ladder; (3) predictive analytics combining roof age, material, and local weather history to estimate remaining service life with real precision; (4) cool-roof shingles like Owens Corning Duration COOL that use solar-reflective granules to drop attic temps 20–40°F; (5) solar-integrated shingles (GAF Timberline Solar, Tesla Solar Roof) that combine roof and solar panel into one product, eliminating mounted-panel penetrations; and (6) smart leak sensors and moisture detectors that catch ceiling stains before drywall damage. AI doesn't replace the roofer — it produces faster, more accurate estimates, better insurance documentation, and earlier detection of issues. Happy Roof uses drone imagery and AI-flagged inspection reports on every job, reviewed by a licensed roofer before the report reaches you." }
      },
      {
        "@type": "Question",
        "name": "What sustainable roofing certifications should I look for?",
        "acceptedAnswer": { "@type": "Answer", "text": "Four certifications actually matter for residential eco-roofing in Florida: (1) ENERGY STAR — EPA program; ENERGY STAR–rated shingles can cut peak cooling demand 10–15%. (2) Cool Roof Rating Council (CRRC) — the independent body that publishes verifiable solar reflectance and thermal emittance data; look for a CRRC label when comparing 'cool roof' claims. (3) LEED v4 — residential roofs aren't LEED-certified directly, but cool-roof and high-recycled-content materials contribute to credits for Heat Island Reduction (Sustainable Sites) and recycled content (Materials & Resources); relevant for new builds and major renos. (4) Manufacturer installer certifications — Owens Corning Certified Installer (Happy Roof holds this), GAF Master Elite (top 2% of GAF contractors), CertainTeed SELECT ShingleMaster. Two questions to ask any roofer: 'Is this product CRRC-rated or ENERGY STAR-certified?' and 'What's your installer certification with this manufacturer?'" }
      },
      {
        "@type": "Question",
        "name": "What's the difference between a solar-ready roof and solar shingles?",
        "acceptedAnswer": { "@type": "Answer", "text": "Two different products that often get confused. A SOLAR-READY ROOF is a traditional shingle, metal, or tile roof installed with reinforced decking and proper flashing prep so solar panels can be MOUNTED ON TOP later. The roof and the panels are separate products with separate warranties — most Florida homeowners going solar take this path because it's the most cost-effective. SOLAR SHINGLES (also called building-integrated photovoltaics or BIPV) are roofing products that ARE the solar panel — examples include GAF Timberline Solar (looks like asphalt shingles, generates electricity) and Tesla Solar Roof (looks like premium tiles). One product replaces both the roof and mounted panels. Key tradeoffs for Florida: solar shingles typically cost 2–3× a traditional roof, but you get a single integrated warranty, no penetration points for leaks, and a cleaner look (no visible mounted panels). Tesla Solar Roof is rated for 130 MPH winds; GAF Timberline Solar is rated for 130 MPH with proper installation. Insurance carriers sometimes treat solar shingles favorably (single product = single damage assessment in a claim). Solar shingles work best on new construction or roofs already due for replacement — if you're keeping your existing roof and adding solar, a solar-ready approach is more cost-effective. Happy Roof coordinates with local solar partners certified on Tesla and GAF systems for either path." }
      }
    ]
  },{
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Eco-Friendly Roofing",
    "provider": { "@type": "RoofingContractor", "name": "Happy Roof LLC", "telephone": "+1-813-595-7663", "url": "https://happyroof.com" },
    "areaServed": { "@type": "State", "name": "Florida" },
    "description": "Energy-efficient and sustainable roofing solutions for Tampa Bay homes. Cool roofs, metal roofing, solar-ready systems, and radiant barrier underlayment."
  },{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://happyroof.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://happyroof.com/services"},{"@type":"ListItem","position":3,"name":"Eco-Friendly Roofing","item":"https://happyroof.com/eco-friendly-roofing"}]}]`;
---

<BaseLayout
  title="Eco-Friendly Roofing Tampa Bay | Happy Roof"
  description="Eco-friendly roofing solutions for Tampa Bay: cool roofs, metal roofing, solar-ready systems. Lower energy bills &amp; reduce your footprint. Licensed FL #CCC1337380."
  canonical="https://happyroof.com/eco-friendly-roofing"
  ogTitle="Eco-Friendly Roofing Tampa Bay | Happy Roof"
  ogDescription="Sustainable, energy-efficient roofing for Tampa Bay homes. Cool roofs, metal, solar-ready systems. Free estimates."
  schema={schema}
>

<style is:inline>
.eco-card{background:#FFFFFF;border:1px solid #E0E0E0;border-radius:16px;padding:2rem;transition:border-color .25s,transform .2s cubic-bezier(.34,1.56,.64,1)}
    .eco-card:hover{border-color:rgba(230,168,23,.3);transform:translateY(-3px)}
    .eco-icon{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;background:rgba(59,159,217,.08);margin-bottom:1.25rem;flex-shrink:0}
    .stat-card{background:#FFFFFF;border:1px solid #E0E0E0;border-radius:16px;padding:2rem;text-align:center}
</style>

<!-- HERO -->
<section class="pt-32 pb-20 relative overflow-hidden" style="background:#F5F5F5;border-bottom:1px solid #E5E5E5">
  <div class="hero-photo-bg" style="background-image:url('/Brand%20Assets/Photos/architectural-shingle-roof-tampa-bay.jpg')"></div>
  <div class="hero-photo-overlay"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-5 text-center">
    <p class="sl gp mb-4">Sustainable Roofing</p>
    <h1 class="font-display font-black tracking-tightest mb-5" style="font-family:'Barlow Condensed',sans-serif;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:.92;letter-spacing:-.01em;color:#1A1A1A">
      ECO-FRIENDLY ROOFING<br/><span class="gt">FOR TAMPA BAY HOMES</span>
    </h1>
    <p class="max-w-2xl mx-auto" style="color:#555555;font-size:1.05rem;line-height:1.75">
      A smarter roof does more than keep the rain out. Energy-efficient roofing materials lower your utility bills, reduce your environmental footprint, and increase your home's value — all while standing up to Florida's heat and hurricanes.
    </p>
    <div class="flex flex-wrap gap-3 justify-center mt-8">
      <a href="/contact" class="btn-t">Get a Free Estimate <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      <a href="tel:8135957663" class="btn-o call-tracking-number">Call (813) 595-7663</a>
    </div>
  </div>
</section>

<!-- INFO STRIP -->
<div style="background:#FFFFFF;border-top:2px solid #E6A817;border-bottom:1px solid #E0E0E0;padding:.85rem 0">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-display font-bold text-sm tracking-widest" style="color:#1A1A1A;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif">
      <span>Cool Roofs</span>
      <span style="color:#E6A817">&middot;</span>
      <span>Metal Roofing</span>
      <span style="color:#E6A817">&middot;</span>
      <span>Solar-Ready</span>
      <span style="color:#E6A817">&middot;</span>
      <span>Energy Savings</span>
      <span style="color:#E6A817">&middot;</span>
      <span>Sustainable Materials</span>
    </div>
  </div>
</div>

<!-- WHY ECO-FRIENDLY -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <p class="sl gt mb-3">Why Go Green</p>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1.5rem">YOUR ROOF IS YOUR BIGGEST ENERGY DECISION</h2>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          In Tampa Bay's climate, your roof takes the full force of Florida's sun — up to 300 days of intense UV exposure per year. A dark, aging roof absorbs that heat and pushes it straight into your attic, forcing your AC to work overtime.
        </p>
        <p style="color:#555555;font-size:1rem;line-height:1.75;margin-bottom:1.5rem">
          An eco-friendly roofing system flips that equation. Reflective materials, proper ventilation, and radiant barriers work together to <strong>keep heat out</strong> instead of trapping it in — cutting cooling costs by up to 25% and reducing the strain on Florida's power grid.
        </p>
        <p style="color:#555555;font-size:1rem;line-height:1.75">
          And the environmental impact goes beyond energy. Materials like metal roofing last 2–3x longer than traditional shingles, which means fewer tear-offs in landfills over the life of your home.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="stat-card">
          <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:2.5rem;color:#E6A817;line-height:1">10–25%</p>
          <p style="color:#555555;font-size:.85rem;line-height:1.5;margin-top:.5rem">Reduction in cooling costs with energy-efficient roofing</p>
        </div>
        <div class="stat-card">
          <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:2.5rem;color:#E6A817;line-height:1">50&deg;F</p>
          <p style="color:#555555;font-size:.85rem;line-height:1.5;margin-top:.5rem">Cooler roof surface with reflective materials vs. dark shingles</p>
        </div>
        <div class="stat-card">
          <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:2.5rem;color:#E6A817;line-height:1">70 yrs</p>
          <p style="color:#555555;font-size:.85rem;line-height:1.5;margin-top:.5rem">Metal roof lifespan — 3x longer than asphalt shingles</p>
        </div>
        <div class="stat-card">
          <p style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:2.5rem;color:#E6A817;line-height:1">95%</p>
          <p style="color:#555555;font-size:.85rem;line-height:1.5;margin-top:.5rem">Recycled content possible in metal roofing materials</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ECO-FRIENDLY OPTIONS -->
<section class="py-20" style="background:#F7F7F7">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">Our Solutions</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em">ECO-FRIENDLY ROOFING OPTIONS</h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Metal Roofing -->
      <div class="eco-card">
        <div class="eco-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="1.5"><path d="M12 3v18M3 12h18M5.636 5.636l12.728 12.728M18.364 5.636 5.636 18.364"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.3rem;color:#1A1A1A;margin-bottom:.75rem">STANDING SEAM METAL</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7;margin-bottom:1rem">The gold standard for sustainable roofing. Made from 25–95% recycled content, 100% recyclable at end of life, and built to last 40–70 years. Reflects solar heat to reduce cooling costs and withstands 160+ MPH winds.</p>
        <a href="/blog/metal-roof-benefits-florida" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;color:#E6A817;letter-spacing:.02em;text-decoration:none">Learn More &rarr;</a>
      </div>

      <!-- Cool-Rated Shingles -->
      <div class="eco-card">
        <div class="eco-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="1.5"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.3rem;color:#1A1A1A;margin-bottom:.75rem">COOL-RATED SHINGLES</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7;margin-bottom:1rem">ENERGY STAR-rated shingles like Owens Corning Duration COOL use solar-reflective granules to bounce heat away from your home. Same durability and 130 MPH wind rating, with lower attic temperatures and AC bills.</p>
        <a href="/residential-roofing" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;color:#E6A817;letter-spacing:.02em;text-decoration:none">View Shingle Options &rarr;</a>
      </div>

      <!-- Light-Colored Tile -->
      <div class="eco-card">
        <div class="eco-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 3v18"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.3rem;color:#1A1A1A;margin-bottom:.75rem">REFLECTIVE TILE</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7;margin-bottom:1rem">Light-colored clay and concrete tiles naturally reflect solar radiation and allow airflow underneath the tile, creating a thermal break. They last 50+ years, are made from natural materials, and add classic Florida character.</p>
        <a href="/blog/tile-vs-shingle-vs-metal" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;color:#E6A817;letter-spacing:.02em;text-decoration:none">Compare Materials &rarr;</a>
      </div>

      <!-- Radiant Barrier -->
      <div class="eco-card">
        <div class="eco-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.3rem;color:#1A1A1A;margin-bottom:.75rem">RADIANT BARRIER UNDERLAYMENT</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7;margin-bottom:1rem">Installed beneath your roofing material, radiant barrier reflects up to 97% of radiant heat away from your attic. In Tampa Bay's summer heat, this can reduce attic temperatures by 30°F and ease the load on your HVAC system.</p>
        <a href="/roof-maintenance" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;color:#E6A817;letter-spacing:.02em;text-decoration:none">Maintenance Tips &rarr;</a>
      </div>

      <!-- Proper Ventilation -->
      <div class="eco-card">
        <div class="eco-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="1.5"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.3rem;color:#1A1A1A;margin-bottom:.75rem">OPTIMIZED VENTILATION</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7;margin-bottom:1rem">Balanced intake and exhaust ventilation prevents heat buildup and moisture damage. We install ridge vents, soffit vents, and power ventilators as needed — extending roof life, preventing mold, and keeping your home cooler naturally.</p>
        <a href="/roof-inspection" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;color:#E6A817;letter-spacing:.02em;text-decoration:none">Schedule Inspection &rarr;</a>
      </div>

      <!-- Solar-Ready -->
      <div class="eco-card">
        <div class="eco-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD9" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.3rem;color:#1A1A1A;margin-bottom:.75rem">SOLAR-READY SYSTEMS</h3>
        <p style="color:#555555;font-size:.9rem;line-height:1.7;margin-bottom:1rem">Planning for solar panels? We prepare your roof with reinforced decking, proper flashing, and panel-compatible materials. When you're ready to go solar, your roof is already set — no additional tear-off or modifications needed.</p>
        <a href="/contact" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:.9rem;color:#E6A817;letter-spacing:.02em;text-decoration:none">Ask About Solar-Ready &rarr;</a>
      </div>
    </div>
  </div>
</section>

<!-- ENERGY SAVINGS BREAKDOWN -->
<section class="py-20" style="background:#FFFFFF">
  <div class="max-w-4xl mx-auto px-5">
    <div class="text-center mb-14">
      <p class="sl gt mb-3">Real Savings</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem,4vw,3rem);line-height:.95;color:#1A1A1A;letter-spacing:-.01em;margin-bottom:1rem">WHAT AN ECO-FRIENDLY ROOF SAVES YOU</h2>
      <p style="color:#555555;font-size:1rem;line-height:1.75;max-width:640px;margin:0 auto">Tampa Bay homeowners who upgrade to energy-efficient roofing see real, measurable benefits — from day one and for decades to come.</p>
    </div>

    <div class="space-y-4">
      <div style="background:#F7F7F7;border-radius:12px;padding:1.5rem 2rem;display:flex;align-items:start;gap:1.25rem">
        <div style="width:48px;height:48px;border-radius:12px;background:rgba(230,168,23,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.15rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div>
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;color:#1A1A1A;margin-bottom:.35rem">$300–$800+ IN ANNUAL ENERGY SAVINGS</h3>
          <p style="color:#555555;font-size:.9rem;line-height:1.7">Reflective roofing materials and proper ventilation dramatically reduce heat transfer into your home. With Tampa Bay's average AC running 8+ months a year, the savings add up fast.</p>
        </div>
      </div>
      <div style="background:#F7F7F7;border-radius:12px;padding:1.5rem 2rem;display:flex;align-items:start;gap:1.25rem">
        <div style="width:48px;height:48px;border-radius:12px;background:rgba(230,168,23,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.15rem">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E6A817" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
