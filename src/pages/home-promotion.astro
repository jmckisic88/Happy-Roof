---
import LandingLayout from '../layouts/LandingLayout.astro';
---
<LandingLayout
  title="Marketing Home Promotion | Happy Roof"
  description="Exclusive Marketing Home Promotion package from Happy Roof. Internal use only."
  canonical="https://www.happyroof.com/home-promotion"
  noindex={true}
>

<style is:inline>
  /* ── Reset / page setup ── */
  body { background:#F5F5F5; font-family:'Nunito',sans-serif; color:#1A1A1A; margin:0; }
  .promo-page { max-width:8.5in; margin:0 auto; background:#FFFFFF; }

  /* ── Print optimization ── */
  @media print {
    body { background:#FFFFFF; }
    .promo-page { max-width:none; box-shadow:none; }
    .no-print { display:none !important; }
    .promo-section { page-break-inside:avoid; }
    .hero-section { page-break-after:avoid; }
  }

  /* ── Hero ── */
  .hero-section {
    background:#1A1A1A;
    color:#FFFFFF;
    padding:2.5rem 2.5rem 2rem;
    position:relative;
    overflow:hidden;
    border-bottom:6px solid #E6A817;
  }
  .hero-pattern {
    position:absolute; inset:0;
    background:
      radial-gradient(circle at 20% 30%, rgba(230,168,23,.18) 0%, transparent 50%),
      radial-gradient(circle at 85% 70%, rgba(59,159,217,.12) 0%, transparent 55%);
    pointer-events:none;
  }
  .hero-label {
    display:inline-block;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.78rem;
    letter-spacing:.28em;
    text-transform:uppercase;
    color:#E6A817;
    margin-bottom:.6rem;
    border-bottom:2px solid rgba(230,168,23,.35);
    padding-bottom:.3rem;
  }
  .hero-title {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:clamp(2.4rem, 5vw, 3.8rem);
    line-height:.9;
    letter-spacing:-.01em;
    margin:0 0 .6rem;
    text-transform:uppercase;
  }
  .hero-title .accent { color:#E6A817; }
  .hero-sub {
    font-size:1rem; line-height:1.6;
    color:rgba(255,255,255,.85);
    max-width:540px;
    margin:0;
  }
  .hero-row {
    position:relative;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1.5rem;
    flex-wrap:wrap;
  }
  .hero-badge {
    background:#E6A817;
    color:#1A1A1A;
    padding:.65rem 1.1rem;
    border-radius:10px;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:.95rem;
    letter-spacing:.06em;
    text-transform:uppercase;
    white-space:nowrap;
    box-shadow:0 6px 20px -4px rgba(230,168,23,.45);
  }

  /* ── Value strip ── */
  .value-strip {
    background:#E6A817;
    color:#1A1A1A;
    padding:1.1rem 2.5rem;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    flex-wrap:wrap;
  }
  .value-strip .left {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:1.05rem;
    letter-spacing:.06em;
    text-transform:uppercase;
  }
  .value-strip .right {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:1.45rem;
    letter-spacing:.02em;
  }

  /* ── Offers grid ── */
  .offers-section { padding:2rem 2.5rem; }
  .section-label {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.78rem;
    letter-spacing:.22em;
    text-transform:uppercase;
    color:#3B9FD9;
    margin-bottom:.4rem;
  }
  .section-h2 {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:1.85rem;
    line-height:1;
    color:#1A1A1A;
    margin:0 0 1.2rem;
    text-transform:uppercase;
    letter-spacing:-.01em;
  }

  .offer-grid {
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:.85rem;
  }
  .offer-card {
    background:#F7F7F7;
    border:1.5px solid #E0E0E0;
    border-left:4px solid #E6A817;
    border-radius:10px;
    padding:1rem 1.1rem;
    display:flex;
    gap:.85rem;
    align-items:flex-start;
  }
  .offer-num {
    background:#1A1A1A;
    color:#E6A817;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:1.15rem;
    width:36px; height:36px;
    border-radius:8px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .offer-card.featured {
    background:linear-gradient(135deg, #1A1A1A 0%, #2A2A2A 100%);
    border-color:#E6A817;
    color:#FFFFFF;
  }
  .offer-card.featured .offer-num {
    background:#E6A817; color:#1A1A1A;
  }
  .offer-card.featured .offer-desc,
  .offer-card.featured .offer-title { color:#FFFFFF; }
  .offer-title {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:.95rem;
    line-height:1.15;
    margin:0 0 .25rem;
    text-transform:uppercase;
    letter-spacing:.02em;
    color:#1A1A1A;
  }
  .offer-title .free {
    color:#E6A817;
    font-weight:900;
  }
  .offer-desc {
    font-size:.78rem;
    line-height:1.45;
    color:#555555;
    margin:0;
  }

  /* ── Requirements ── */
  .reqs-section {
    background:#F7F7F7;
    padding:1.75rem 2.5rem;
    border-top:1px solid #E0E0E0;
  }
  .reqs-grid {
    display:grid;
    grid-template-columns:repeat(5, 1fr);
    gap:.6rem;
    margin-top:.75rem;
  }
  .req-card {
    background:#FFFFFF;
    border:1.5px solid #E0E0E0;
    border-radius:8px;
    padding:.85rem .7rem;
    text-align:center;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:.4rem;
  }
  .req-icon {
    width:34px; height:34px;
    border-radius:50%;
    background:rgba(59,159,217,.12);
    display:flex; align-items:center; justify-content:center;
    color:#3B9FD9;
  }
  .req-num {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:.8rem;
    color:#3B9FD9;
    letter-spacing:.1em;
  }
  .req-title {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:.78rem;
    line-height:1.2;
    color:#1A1A1A;
    margin:0;
    text-transform:uppercase;
    letter-spacing:.02em;
  }

  /* ── Signature/CTA section ── */
  .signature-section {
    background:#1A1A1A;
    color:#FFFFFF;
    padding:1.75rem 2.5rem 2rem;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:1.5rem;
    flex-wrap:wrap;
    border-top:6px solid #E6A817;
  }
  .signature-left { flex:1; min-width:240px; }
  .sig-line {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.78rem;
    letter-spacing:.22em;
    text-transform:uppercase;
    color:#E6A817;
    margin:0 0 .3rem;
  }
  .sig-call {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:1.75rem;
    line-height:1;
    margin:0;
  }
  .sig-contact {
    font-size:.85rem;
    color:rgba(255,255,255,.7);
    margin:.5rem 0 0;
    line-height:1.5;
  }
  .signature-right {
    flex:1; min-width:240px;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.12);
    border-radius:10px;
    padding:.9rem 1.1rem;
  }
  .sig-label-x {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.7rem;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:rgba(255,255,255,.55);
    margin:0 0 .35rem;
  }
  .sig-blank {
    border-bottom:1.5px solid rgba(255,255,255,.4);
    height:1.4rem;
    margin-bottom:.85rem;
  }

  /* ── Fine print ── */
  .fineprint {
    padding:.85rem 2.5rem 1.1rem;
    background:#FFFFFF;
    font-size:.65rem;
    color:#888888;
    line-height:1.45;
    border-top:1px solid #E0E0E0;
  }
  .fineprint strong { color:#555555; }

  /* ── Web-only screen container ── */
  @media screen {
    .promo-page {
      margin-top:1.5rem;
      margin-bottom:1.5rem;
      box-shadow:0 16px 50px -12px rgba(0,0,0,.18), 0 4px 14px -4px rgba(0,0,0,.08);
      border-radius:12px;
      overflow:hidden;
    }
    .print-btn {
      position:fixed;
      bottom:1.5rem; right:1.5rem;
      background:#E6A817;
      color:#1A1A1A;
      border:none;
      padding:.85rem 1.4rem;
      border-radius:100px;
      font-family:'Barlow Condensed',sans-serif;
      font-weight:800;
      font-size:.9rem;
      letter-spacing:.06em;
      text-transform:uppercase;
      cursor:pointer;
      box-shadow:0 8px 24px -6px rgba(230,168,23,.5);
      z-index:50;
      display:flex; align-items:center; gap:.5rem;
    }
    .print-btn:hover { background:#F0C040; }
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .offer-grid { grid-template-columns:1fr; }
    .reqs-grid { grid-template-columns:repeat(2, 1fr); }
    .hero-section, .offers-section, .reqs-section, .signature-section, .fineprint, .value-strip { padding-left:1.25rem; padding-right:1.25rem; }
    .hero-title { font-size:2rem; }
  }
</style>

<button onclick="window.print()" class="print-btn no-print">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
  Print This Page
</button>

<div class="promo-page">

  <!-- ══════ HERO ══════ -->
  <section class="hero-section">
    <div class="hero-pattern"></div>
    <div class="hero-row">
      <div>
        <p class="hero-label">Exclusive Offer · Marketing Home Program</p>
        <h1 class="hero-title">
          THIS COULD BE THE BEST<br/>
          ROOF DEAL ON YOUR <span class="accent">STREET.</span>
        </h1>
        <p class="hero-sub">
          We're hand-picking a limited number of homes in your neighborhood to showcase our work. If your home qualifies, you'll get our highest-tier roofing package at a price most homeowners never see.
        </p>
      </div>
      <div class="hero-badge">By Invitation Only</div>
    </div>
  </section>

  <!-- ══════ VALUE STRIP ══════ -->
  <div class="value-strip">
    <span class="left">Total Promotional Value</span>
    <span class="right">$5,000+ in upgrades &amp; bonuses</span>
  </div>

  <!-- ══════ OFFERS ══════ -->
  <section class="offers-section promo-section">
    <p class="section-label">What's Included</p>
    <h2 class="section-h2">6 Premium Upgrades, On The House.</h2>

    <div class="offer-grid">
      <div class="offer-card featured">
        <div class="offer-num">1</div>
        <div>
          <p class="offer-title">Owens Corning Duration &rarr; <span class="free">DURATION DESIGNER</span></p>
          <p class="offer-desc">Free upgrade to Owens Corning's premium-tier architectural shingle. Designer styling, deeper color palette, same trusted wind rating.</p>
        </div>
      </div>

      <div class="offer-card featured">
        <div class="offer-num">2</div>
        <div>
          <p class="offer-title"><span class="free">2 SOLAR ATTIC FANS</span> INCLUDED</p>
          <p class="offer-desc">Up to two solar-powered attic ventilation fans included at no charge. Reduces attic temps, extends roof life, lowers cooling costs.</p>
        </div>
      </div>

      <div class="offer-card">
        <div class="offer-num">3</div>
        <div>
          <p class="offer-title">Labor Warranty <span class="free">UPGRADED</span></p>
          <p class="offer-desc">5-year &rarr; 10-year. 10-year &rarr; 15-year. 50-year &rarr; lifetime. Double the labor protection at every tier.</p>
        </div>
      </div>

      <div class="offer-card">
        <div class="offer-num">4</div>
        <div>
          <p class="offer-title">Synthetic Felt &rarr; <span class="free">PREMIUM ICE &amp; WATER SHIELD</span></p>
          <p class="offer-desc">Free underlayment upgrade to full-coverage premium ice &amp; water shield — superior leak protection and storm-grade waterproofing.</p>
        </div>
      </div>

      <div class="offer-card">
        <div class="offer-num">5</div>
        <div>
          <p class="offer-title"><span class="free">$500 HERO DISCOUNT</span> APPLIED</p>
          <p class="offer-desc">A $500 instant discount applied to your contract, no matter your background. Stack with all other upgrades on this offer.</p>
        </div>
      </div>

      <div class="offer-card">
        <div class="offer-num">6</div>
        <div>
          <p class="offer-title">Referral Bonus <span class="free">+$100 BUMP</span></p>
          <p class="offer-desc">Every referral you send earns an extra $100 over our standard tier payouts. Tier 6 referrals can earn up to $1,100.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════ REQUIREMENTS ══════ -->
  <section class="reqs-section promo-section">
    <p class="section-label" style="color:#1A1A1A">What We Need From You</p>
    <h2 class="section-h2">5 Simple Conditions.</h2>

    <div class="reqs-grid">
      <div class="req-card">
        <div class="req-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <p class="req-num">01</p>
        <p class="req-title">Same-Day<br/>Signing</p>
      </div>

      <div class="req-card">
        <div class="req-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <p class="req-num">02</p>
        <p class="req-title">Flexible<br/>Scheduling</p>
      </div>

      <div class="req-card">
        <div class="req-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="12" height="10" rx="1"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="22" x2="15" y2="22"/></svg>
        </div>
        <p class="req-num">03</p>
        <p class="req-title">Yard Sign<br/>30 Days</p>
      </div>

      <div class="req-card">
        <div class="req-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </div>
        <p class="req-num">04</p>
        <p class="req-title">Social Media<br/>Post</p>
      </div>

      <div class="req-card">
        <div class="req-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <p class="req-num">05</p>
        <p class="req-title">Sign<br/>NDA</p>
      </div>
    </div>
  </section>

  <!-- ══════ SIGNATURE / CTA ══════ -->
  <section class="signature-section promo-section">
    <div class="signature-left">
      <p class="sig-line">Ready to Lock It In?</p>
      <p class="sig-call">LET'S MAKE IT OFFICIAL.</p>
      <p class="sig-contact">
        Happy Roof LLC · FL License #CCC1337380<br/>
        141 Stevens Ave #12, Oldsmar, FL 34677<br/>
        (813) 595-7663 · happyroof.com
      </p>
    </div>
    <div class="signature-right">
      <p class="sig-label-x">Homeowner Signature</p>
      <div class="sig-blank"></div>
      <p class="sig-label-x">Date</p>
      <div class="sig-blank" style="margin-bottom:0"></div>
    </div>
  </section>

  <!-- ══════ FINE PRINT ══════ -->
  <div class="fineprint">
    <strong>Disclosures.</strong> Marketing Home Program is offered at Happy Roof's sole discretion to qualifying homes selected for showcase purposes. All upgrades and bonuses are conditional on same-day contract execution, flexible scheduling for multi-home installation windows, display of a Happy Roof yard sign for a minimum of 30 consecutive days post-installation, fulfillment of the social media post requirement, and execution of a non-disclosure agreement covering pricing and program terms. Solar attic fan quantity (up to 2) is determined by attic square footage and ventilation requirements per Florida Building Code. Warranty upgrades apply only to qualifying installations and supersede standard Happy Roof warranty terms. Referral bonus bump of +$100 applies to referrals submitted within 12 months of the homeowner's installation completion. Hero Discount stacks with this offer but does not stack with other promotional credits. Offer not transferable. Happy Roof LLC reserves the right to modify or withdraw this offer at any time prior to signing.
  </div>

</div>

</LandingLayout>
