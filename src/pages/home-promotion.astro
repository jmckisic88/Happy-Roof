---
import LandingLayout from '../layouts/LandingLayout.astro';
---
<LandingLayout
  title="Marketing Home Promotion | Happy Roof"
  description="Exclusive Marketing Home Promotion package from Happy Roof. Internal use only."
  canonical="https://www.happyroof.com/home-promotion"
  noindex={true}
>

<style is:inline>
  body { background:#F5F5F5; font-family:'Nunito',sans-serif; color:#1A1A1A; margin:0; }
  .promo { max-width:8.5in; margin:0 auto; background:#FFFFFF; }

  /* Force backgrounds and colors to print (override browser default that strips them) */
  .promo, .promo *,
  .hero, .reqs, .footer, .offer {
    -webkit-print-color-adjust:exact !important;
    print-color-adjust:exact !important;
    color-adjust:exact !important;
  }

  /* Print */
  @media print {
    body { background:#FFFFFF; }
    .promo { max-width:none; box-shadow:none; }
    .no-print,
    #hr-chat-wrap, #hr-chat-fab, #hr-chat-window, #hr-chat-badge,
    [id^="hr-chat"] { display:none !important; }
    @page { size:letter; margin:.35in .4in; }
  }

  /* Hero */
  .hero {
    background:#1A1A1A;
    color:#FFFFFF;
    padding:1.4rem 1.75rem 1.2rem;
    border-bottom:4px solid #E6A817;
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:1rem;
  }
  .hero-eyebrow {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.7rem;
    letter-spacing:.22em;
    text-transform:uppercase;
    color:#E6A817;
    margin:0 0 .3rem;
  }
  .hero-title {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:2rem;
    line-height:.95;
    letter-spacing:-.01em;
    margin:0;
    text-transform:uppercase;
  }
  .hero-title .accent { color:#E6A817; }
  .hero-value {
    text-align:right;
    flex-shrink:0;
  }
  .hero-value .small {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.65rem;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:rgba(255,255,255,.55);
    margin:0;
  }
  .hero-value .big {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:1.6rem;
    line-height:1;
    color:#E6A817;
    margin:.15rem 0 0;
  }

  /* Section header */
  .sec-hdr {
    padding:1rem 1.75rem .6rem;
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    gap:1rem;
  }
  .sec-title {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:1.2rem;
    line-height:1;
    color:#1A1A1A;
    margin:0;
    text-transform:uppercase;
    letter-spacing:.02em;
  }
  .sec-sub {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.65rem;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:#888888;
    margin:0;
  }

  /* Offers */
  .offers {
    padding:0 1.75rem 1rem;
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:.55rem;
  }
  .offer {
    display:flex;
    gap:.65rem;
    align-items:flex-start;
    padding:.6rem .75rem;
    border-left:3px solid #E6A817;
    background:#F7F7F7;
    border-radius:6px;
  }
  .offer-n {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:1rem;
    color:#E6A817;
    flex-shrink:0;
    line-height:1.1;
    min-width:1.1rem;
  }
  .offer-txt {
    font-size:.78rem;
    line-height:1.35;
    color:#1A1A1A;
    margin:0;
  }
  .offer-txt strong {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.02em;
    font-size:.85rem;
    color:#1A1A1A;
    display:block;
    margin-bottom:.1rem;
  }
  .offer-txt strong .free { color:#E6A817; }

  /* Why Happy Roof trust grid */
  .why {
    background:#F7F7F7;
    border-top:1px solid #E0E0E0;
    padding:.85rem 1.75rem;
  }
  .why-row {
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    gap:1rem;
    margin-bottom:.6rem;
  }
  .why-label {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:900;
    font-size:.95rem;
    line-height:1;
    color:#1A1A1A;
    margin:0;
    text-transform:uppercase;
    letter-spacing:.02em;
  }
  .why-sub {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.62rem;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:#888888;
    margin:0;
  }
  .why-grid {
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:.45rem .85rem;
  }
  .why-item {
    display:flex;
    align-items:center;
    gap:.45rem;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:.72rem;
    color:#1A1A1A;
    text-transform:uppercase;
    letter-spacing:.04em;
    line-height:1.15;
  }
  .why-item svg {
    color:#E6A817;
    flex-shrink:0;
  }

  /* Requirements */
  .reqs {
    background:#FFFFFF;
    border-top:1px solid #E0E0E0;
    border-bottom:1px solid #E0E0E0;
    padding:.85rem 1.75rem;
    display:flex;
    align-items:center;
    gap:1rem;
    justify-content:space-between;
    flex-wrap:wrap;
  }
  .reqs-label {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:.78rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:#3B9FD9;
    margin:0;
    white-space:nowrap;
  }
  .reqs-list {
    display:flex;
    gap:1.2rem;
    flex-wrap:wrap;
    align-items:center;
  }
  .req {
    display:flex;
    align-items:center;
    gap:.4rem;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:.78rem;
    color:#1A1A1A;
    text-transform:uppercase;
    letter-spacing:.04em;
  }
  .req svg {
    color:#3B9FD9;
    flex-shrink:0;
  }

  /* Sign block + contact + fine print */
  .footer {
    background:#1A1A1A;
    color:#FFFFFF;
    padding:.95rem 1.75rem;
    border-top:4px solid #E6A817;
  }
  .footer-row {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:1.5rem;
    flex-wrap:wrap;
  }
  .footer-contact {
    font-family:'Barlow Condensed',sans-serif;
    font-size:.78rem;
    letter-spacing:.06em;
    text-transform:uppercase;
    color:rgba(255,255,255,.75);
    margin:0;
    line-height:1.5;
  }
  .footer-contact strong { color:#E6A817; font-weight:800; }
  .sig-block {
    display:flex;
    gap:1rem;
    align-items:flex-end;
  }
  .sig-field { min-width:140px; }
  .sig-label {
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:.6rem;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:rgba(255,255,255,.5);
    margin:0 0 .15rem;
  }
  .sig-line {
    border-bottom:1.5px solid rgba(255,255,255,.4);
    height:1.05rem;
  }
  .sig-date { min-width:90px; }

  .fineprint {
    padding:.65rem 1.75rem .85rem;
    background:#FFFFFF;
    font-size:.58rem;
    color:#999999;
    line-height:1.45;
    border-top:1px solid #E0E0E0;
  }

  /* Screen-only */
  @media screen {
    .promo {
      margin:1.5rem auto;
      box-shadow:0 16px 50px -12px rgba(0,0,0,.18), 0 4px 14px -4px rgba(0,0,0,.08);
      border-radius:10px;
      overflow:hidden;
    }
    .print-btn {
      position:fixed;
      bottom:1.5rem; right:1.5rem;
      background:#E6A817;
      color:#1A1A1A;
      border:none;
      padding:.75rem 1.3rem;
      border-radius:100px;
      font-family:'Barlow Condensed',sans-serif;
      font-weight:800;
      font-size:.85rem;
      letter-spacing:.06em;
      text-transform:uppercase;
      cursor:pointer;
      box-shadow:0 8px 24px -6px rgba(230,168,23,.5);
      z-index:50;
      display:flex; align-items:center; gap:.5rem;
    }
    .print-btn:hover { background:#F0C040; }
  }

  @media (max-width: 640px) {
    .offers, .why-grid { grid-template-columns:1fr 1fr; }
    .hero, .sec-hdr, .reqs, .footer, .fineprint, .offers, .why { padding-left:1rem; padding-right:1rem; }
    .hero-title { font-size:1.5rem; }
    .footer-row { flex-direction:column; align-items:flex-start; }
  }
</style>

<button onclick="window.print()" class="print-btn no-print">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
  Print
</button>

<div class="promo">

  <!-- HERO -->
  <header class="hero">
    <div>
      <p class="hero-eyebrow">By Invitation · Marketing Home Program</p>
      <h1 class="hero-title">Best Roof Deal<br/>On Your <span class="accent">Street.</span></h1>
    </div>
    <div class="hero-value">
      <p class="small">Total Value</p>
      <p class="big">$5,000+</p>
    </div>
  </header>

  <!-- WHAT'S INCLUDED -->
  <div class="sec-hdr">
    <h2 class="sec-title">What's Included</h2>
    <p class="sec-sub">6 Free Upgrades</p>
  </div>
  <div class="offers">
    <div class="offer">
      <span class="offer-n">1</span>
      <p class="offer-txt"><strong>OC Duration &rarr; <span class="free">Duration Designer</span></strong>Premium architectural shingle upgrade.</p>
    </div>
    <div class="offer">
      <span class="offer-n">2</span>
      <p class="offer-txt"><strong><span class="free">2 Solar Attic Fans</span> Included</strong>Up to 2 included at no charge.</p>
    </div>
    <div class="offer">
      <span class="offer-n">3</span>
      <p class="offer-txt"><strong>Labor Warranty <span class="free">5 &rarr; 10 Years</span></strong>Double your workmanship coverage.</p>
    </div>
    <div class="offer">
      <span class="offer-n">4</span>
      <p class="offer-txt"><strong>Felt &rarr; <span class="free">Ice &amp; Water Shield</span></strong>Premium underlayment, no upcharge.</p>
    </div>
    <div class="offer">
      <span class="offer-n">5</span>
      <p class="offer-txt"><strong><span class="free">$500 Discount</span> Applied</strong>Instant credit on your contract.</p>
    </div>
    <div class="offer">
      <span class="offer-n">6</span>
      <p class="offer-txt"><strong><span class="free">Driveway Power Wash</span> Included</strong>Complimentary post-install cleanup.</p>
    </div>
  </div>

  <!-- WHY HAPPY ROOF -->
  <div class="why">
    <div class="why-row">
      <h2 class="why-label">Why Happy Roof</h2>
      <p class="why-sub">Credentials, Community, Quality</p>
    </div>
    <div class="why-grid">
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        30+ Yrs Leadership Experience
      </span>
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Owens Corning Preferred Vendor
      </span>
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M22 11h-6"/></svg>
        FirstOnSite Trusted Partner
      </span>
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Delta Catastrophe Partner
      </span>
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        Skybrooke K-8 Sponsor
      </span>
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 2l3 3-3 3-3-3z"/><path d="M2 12l3-3 3 3-3 3z"/><path d="M22 12l-3-3-3 3 3 3z"/><path d="M12 22l-3-3 3-3 3 3z"/></svg>
        Tampa Lions FC Sponsor
      </span>
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Happy Roof Foundation
      </span>
      <span class="why-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Above &amp; Beyond Quality
      </span>
    </div>
  </div>

  <!-- REQUIREMENTS -->
  <div class="reqs">
    <p class="reqs-label">What We Need</p>
    <div class="reqs-list">
      <span class="req">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Same-Day Sign
      </span>
      <span class="req">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Flexible Scheduling
      </span>
      <span class="req">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="6" y="4" width="12" height="10" rx="1"/><line x1="12" y1="14" x2="12" y2="22"/><line x1="9" y1="22" x2="15" y2="22"/></svg>
        Yard Sign 30 Days
      </span>
      <span class="req">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/></svg>
        Social Post
      </span>
      <span class="req">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Sign NDA
      </span>
    </div>
  </div>

  <!-- FOOTER: SIGNATURE + CONTACT -->
  <div class="footer">
    <div class="footer-row">
      <p class="footer-contact">
        <strong>Happy Roof LLC</strong> &nbsp;·&nbsp; FL #CCC1337380<br/>
        (813) 595-7663 &nbsp;·&nbsp; happyroof.com
      </p>
      <div class="sig-block">
        <div class="sig-field">
          <p class="sig-label">Homeowner Signature</p>
          <div class="sig-line"></div>
        </div>
        <div class="sig-field sig-date">
          <p class="sig-label">Date</p>
          <div class="sig-line"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- FINE PRINT -->
  <div class="fineprint">
    Offer at Happy Roof's discretion for qualifying showcase homes. All bonuses conditional on same-day contract, flexible install scheduling, 30-day yard sign display, social post, and NDA. Solar fan quantity per Florida Building Code ventilation requirements. Warranty upgrades apply only to qualifying installs. Referral bump valid 12 months from install. Hero Discount stacks here but not with other credits. Not transferable. Subject to withdrawal prior to signing.
  </div>

</div>

</LandingLayout>
