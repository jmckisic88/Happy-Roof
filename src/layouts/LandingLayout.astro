---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = '',
  canonical = '',
  ogImage = 'https://www.happyroof.com/Brand%20Assets/og-share-image.png',
  noindex = true,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-MQ9BXG94');</script>
  <!-- End Google Tag Manager -->

  <!-- Google Tag Manager (Marketing Team) -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-W9L6VHPB');</script>
  <!-- End Google Tag Manager (Marketing Team) -->

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Favicon — Happy Roof wordmark from og-share-image (cache-busted v3) -->
  <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1A1A1A" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet" />

  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}

  <meta property="og:image" content={ogImage} />

  <!-- Turnstile onload bootstrap — MUST be defined BEFORE the api.js
       script tag below. Cloudflare's api.js is async, so it can execute
       and fire the onload callback BEFORE the body's TurnstileWidget
       inline script runs to define window.HR_Turnstile. Without this
       bootstrap the callback is undefined at api.js load time, the
       widget silently never renders, and the customer sees the amber
       fallback banner. Bug reproduced 2026-07-24 after a second GTM
       container in the head shifted network timing enough to lose
       the race. If HR_Turnstile is already defined when we fire, call
       it; otherwise set a flag and let HR_Turnstile flush itself on
       init. -->
  <script is:inline>window.hrTurnstileReady=function(){if(window.HR_Turnstile&&typeof window.HR_Turnstile.ready==='function'){window.HR_Turnstile.ready();}else{window.__hrTurnstileCFReady=true;}};</script>
  <!-- Cloudflare Turnstile (bot protection on forms) — explicit render
       so HR_Turnstile can control lifecycle + regenerate stale tokens
       before submit (see src/components/TurnstileWidget.astro). -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=hrTurnstileReady" async defer></script>
  <!-- Happy Roof form helpers (draft persistence, Turnstile-aware submit) -->
  <script is:inline src="/hr-forms.js"></script>

  <slot name="head" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MQ9BXG94" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <!-- Google Tag Manager (noscript) (Marketing Team) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9L6VHPB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) (Marketing Team) -->

  <slot />

  <script is:inline src="/chat.js"></script>
</body>
</html>
